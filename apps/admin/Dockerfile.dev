# =============================================================
# Admin Dockerfile - Development (Vite hot reload)
# Build context: repo root (docker build -f apps/admin/Dockerfile.dev .)
# =============================================================

FROM node:22-bookworm-slim

RUN corepack enable && corepack prepare pnpm@9.0.0 --activate

WORKDIR /app

# Copy workspace root files first (pnpm resolution)
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./

# Copy all package.json files for dependency resolution
COPY packages/shared-core/package.json ./packages/shared-core/
COPY packages/shared-ui/package.json ./packages/shared-ui/
COPY packages/api-client/package.json ./packages/api-client/
COPY packages/auth/package.json ./packages/auth/
COPY packages/permissions/package.json ./packages/permissions/
COPY packages/vite-config/package.json ./packages/vite-config/
COPY apps/admin/package.json ./apps/admin/

# Install all dependencies (pnpm workspace)
RUN pnpm install

# Copy source code
COPY packages/shared-core/ ./packages/shared-core/
COPY packages/shared-ui/ ./packages/shared-ui/
COPY packages/api-client/ ./packages/api-client/
COPY packages/auth/ ./packages/auth/
COPY packages/permissions/ ./packages/permissions/
COPY packages/vite-config/ ./packages/vite-config/
COPY apps/admin/ ./apps/admin/

WORKDIR /app

EXPOSE 3003

ENV CHOKIDAR_USEPOLLING=true

CMD ["pnpm", "--filter", "@telecom/admin", "dev", "--host", "0.0.0.0", "--port", "3003"]
