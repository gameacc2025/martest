+          color: '#0a6a78',
+          focusColor: '#004d6f'
+        },
+        // Cool, blue-tinted neutral ramp. 200 = hairline border, 600 = secondary text.
+        surface: {
+          0: '#ffffff',
+          50: '#f9fcfd',
+          100: '#f4f9fb',
+          200: '#d5e6ed',
+          300: '#b9d3de',
