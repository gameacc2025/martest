# ─── Database (docker-compose.yml) ──────────────────────────
POSTGRES_USER=telecom
POSTGRES_PASSWORD=change_me_to_a_strong_unique_password
POSTGRES_DB=telecom_marketplace

# Frontend API path is configured as relative /api/v1 by packages/vite-config.
# These URLs are embedded into frontend builds for cross-panel PKCE handoff.
# Override them with the real public origins in production.
VITE_WEBSITE_APP_URL=http://localhost:3001
VITE_COMPANY_APP_URL=http://localhost:3002
VITE_ADMIN_APP_URL=http://localhost:3003
# In Compose, nginx proxies /api/ and /uploads/ to the backend service.
