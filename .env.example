# ─── Database (consumed by docker-compose.yml) ─────────────
POSTGRES_USER=telecom
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=telecom_marketplace

# ─── Browser-facing frontend origins (embedded at Vite build time) ─
# Local defaults match the published Compose ports. Replace with public
# HTTPS origins when deploying to a real domain, then rebuild the images.
VITE_COMPANY_APP_URL=http://localhost:3002
VITE_ADMIN_APP_URL=http://localhost:3003

# Backend runtime secrets/configuration belong in backend/.env.
