# =============================================================
# Backend Dockerfile - Development (hot reload با --watch)
# =============================================================
FROM node:22-bookworm-slim
WORKDIR /app

# openssl را قبل از نصب پکیج‌ها نصب می‌کنیم چون Prisma هنگام
# postinstall (prisma generate) به آن نیاز دارد.
RUN apt-get update -y && apt-get install -y --no-install-recommends openssl \
    && rm -rf /var/lib/apt/lists/*

COPY package*.json ./

# npm ci سریع‌تر و قابل‌اعتمادتر از npm install است (از package-lock استفاده می‌کند).
# اگر lock موجود نبود به npm install برمی‌گردیم.
RUN npm ci || npm install

COPY . .
RUN npx prisma generate

EXPOSE 3000

# ترتیب اجرا هنگام start کانتینر:
#   1. prisma db push  → اعمال schema روی دیتابیس (غیرتعاملی، مناسب dev)
#   2. node seed.js    → ایجاد نقش‌ها/دسترسی‌ها + کاربر ادمین (idempotent)
#   3. node --watch    → راه‌اندازی سرور با hot reload
# نکته: seed با upsert کار می‌کند پس اجرای چندباره بی‌خطر است.
CMD ["sh", "-c", "npx prisma db push --accept-data-loss && node prisma/seed.js && node --watch src/server.js"]
