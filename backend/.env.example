# ─── Database ───────────────────────────────────────────────
# در حالت Docker این مقدار توسط docker-compose override می‌شود
DATABASE_URL="postgresql://telecom:telecom_pass@postgres:5432/telecom_marketplace?schema=public"

# ─── Auth: Access Token (کوتاه‌مدت، ۱۵ دقیقه، در هدر Authorization) ──
JWT_ACCESS_SECRET="change_me_to_strong_random_secret_min_32_chars"
JWT_ACCESS_EXPIRES_IN="15m"

# ─── Auth: Refresh Token (بلندمدت، ۷ روز، در httpOnly cookie + DB) ──
JWT_REFRESH_SECRET="change_me_to_another_strong_random_secret_min_32_chars"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Security ───────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=10

# ─── Server ─────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
API_BASE_URL="http://localhost:3000/api/v1"

# ─── CORS (آدرس فرانت‌اند) ─────────────────────────────────
FRONTEND_URL="http://localhost:3001"

# ─── Origins مورد اعتماد (CORS + محافظ Origin روی /refresh و /logout) ──
# در production هر سه دامنه پنل‌ها را وارد کنید:
# ALLOWED_ORIGINS="https://site.example.com,https://company.example.com,https://admin.example.com"
ALLOWED_ORIGINS="http://localhost:3001,http://localhost:3002,http://localhost:3003"

# ─── Initial Super Admin (فقط هنگام seed اولیه استفاده می‌شود) ──
# بعد از seed، حتماً رمز را از پنل ادمین تغییر دهید
# تلفن تنها شناسه ورود است (اجباری)
SUPER_ADMIN_PHONE="09120000000"
SUPER_ADMIN_PASSWORD="Admin@123456"
SUPER_ADMIN_EMAIL="admin@telecommarketplace.local"

# ─── Notifications ────────────────────────────────────────────
# SMTP configuration for email delivery (optional - console fallback when not set)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@telecommarketplace.local"

# SMS provider configuration (Twilio, optional)
# Inquiry conversation SMS requires these three values and consumes the sender's paid SMS quota.
# SMS is queued in NotificationDelivery and sent by the background delivery worker.
# Recipients must opt in to SMS for INQUIRY_MESSAGE_RECEIVED in notification preferences.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# ── Delivery worker configuration ────────────────────────────
# Max delivery attempts (mirrored in dispatch service)
NOTIFICATION_MAX_ATTEMPTS=3
# How often the delivery worker polls for PENDING rows (ms)
NOTIFICATION_POLL_INTERVAL_MS=5000


# Optional online subscription checkout (Zarinpal v4). If merchant ID is absent,
# the subscription page uses the pending/manual-payment-review flow instead.
# Callback URL must be publicly reachable and point to /api/v1/inquiries/subscription/payment/callback.
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
ZARINPAL_CALLBACK_URL=http://localhost:3000/api/v1/inquiries/subscription/payment/callback
# Full company-app route URL, e.g. https://company.example.com/inquiry-subscription
INQUIRY_SUBSCRIPTION_RESULT_URL=http://localhost:3001/inquiry-subscription

