  articles  ArticleTagAssignment[]

}

/// رابط مقاله و دسته‌بندی به همراه ترتیب نمایش مقاله در دسته.
model ArticleCategoryAssignment {
  /// شناسه مقاله مرتبط با این ArticleCategoryAssignment؛ کلید خارجی به جدول Article است.
  articleId  Int
  /// شناسه ArticleCategory مرتبط با این ArticleCategoryAssignment؛ کلید خارجی به جدول ArticleCategory است.
  categoryId Int
  /// ترتیب نمایش رکورد.
  sortOrder  Int      @default(0)
  /// ارتباط Prisma با جدول Article (مقاله): رکورد مرتبط مرتبط با ArticleCategoryAssignment؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  article    Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  /// ارتباط Prisma با جدول ArticleCategory (ArticleCategory): رکورد مرتبط مرتبط با ArticleCategoryAssignment؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  category   ArticleCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([articleId, categoryId])
  @@index([categoryId, sortOrder])

