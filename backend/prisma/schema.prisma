  /// شناسه رکورد مرتبط برای اتصال این RetailRefund به موجودیت مرجع.
  providerRefundId      String?       @unique @db.VarChar(200)
  /// زمان پایان پردازش رویداد/عملیات.
  processedAt           DateTime?
  /// زمان ایجاد رکورد.
  createdAt             DateTime      @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt             DateTime      @updatedAt
  /// ارتباط Prisma با جدول RetailOrder (سفارش): رکورد مرتبط مرتبط با RetailRefund؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  order                 RetailOrder   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// ارتباط Prisma با جدول SellerOrder (سفارش فروشنده): رکورد مرتبط مرتبط با RetailRefund؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  sellerOrder           SellerOrder?  @relation(fields: [sellerOrderId], references: [id], onDelete: SetNull)
  /// ارتباط Prisma با جدول PaymentTransaction (PaymentTransaction): رکورد مرتبط مرتبط با RetailRefund؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  paymentTransaction    PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id], onDelete: Restrict)
  /// ارتباط Prisma با جدول User (کاربر): رکورد مرتبط مرتبط با RetailRefund؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  requestedBy           User          @relation(fields: [requestedByUserId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([sellerOrderId, status])
  @@index([status, createdAt])

}

/// اطلاعات ارسال سفارش فروشنده شامل شرکت حمل، کد رهگیری و وضعیت.
model Shipment {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id                Int            @id @default(autoincrement())
