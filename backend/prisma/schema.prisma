/// نشانی‌های تماس یا تحویل ثبت‌شده توسط کاربر.
model Address {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id             Int      @id @default(autoincrement())
  /// شناسه کاربر مرتبط با این نشانی؛ کلید خارجی به جدول User است.
  userId         Int
  /// برچسب یا عنوان کوتاه قابل نمایش.
  label          String   @default("خانه")
  /// نام شخص دریافت‌کننده.
  recipientName  String
  /// شماره تماس شخص دریافت‌کننده.
  recipientPhone String
  /// استان نشانی.
  province       String
  /// شهر نشانی.
  city           String
  /// جزئیات نشانی پستی.
  addressLine    String
  /// کد پستی.
  postalCode     String?
  /// پیش‌فرض بودن این گزینه یا رکورد.
  isDefault      Boolean  @default(false)
  /// زمان ایجاد رکورد.
  createdAt      DateTime @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt      DateTime @updatedAt
  /// ارتباط Prisma با جدول User (کاربر): رکورد مرتبط مرتبط با نشانی؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// ارتباط Prisma با جدول RetailOrder (سفارش): مجموعه رکوردهای وابسته مرتبط با نشانی؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  retailOrders   RetailOrder[]

  @@index([userId, isDefault])
  @@index([userId, createdAt])
}

/// توکن‌های نوسازی نشست کاربر برای کنترل انقضا و ابطال نشست.
model RefreshToken {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id        Int      @id @default(autoincrement())
  /// توکن نشست/نوسازی؛ دسترسی به آن باید محدود و امن باشد.
  token     String   @unique
  /// شناسه کاربر مرتبط با این RefreshToken؛ کلید خارجی به جدول User است.
  userId    Int
  /// زمان انقضای اعتبار رکورد یا توکن.
  expiresAt DateTime
  /// زمان ایجاد رکورد.
  createdAt DateTime @default(now())
  /// ارتباط Prisma با جدول User (کاربر): رکورد مرتبط مرتبط با RefreshToken؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// One-time, PKCE-bound code used to hand a live session from the website
// to the admin/company panel (see handoff.service.js). Stored hashed;
// single-use (deleted atomically on redeem); 60-second TTL.
/// کد موقت انتقال امن نشست میان وب‌سایت و پنل‌ها؛ کد خام ذخیره نمی‌شود.
model HandoffCode {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id        Int      @id @default(autoincrement())
  /// هش کد انتقال؛ کد خام ذخیره نمی‌شود.
  codeHash  String   @unique
  /// شناسه کاربر مرتبط با این HandoffCode؛ کلید خارجی به جدول User است.
  userId    Int
  /// مقدار متنی app برای توصیف یا شناسایی HandoffCode.
  app       String   // 'admin' | 'company'
  /// مقدار challenge رمزنگاری‌شده مرتبط با جریان PKCE.
  challenge String   // base64url(SHA-256(verifier)) supplied by the panel
  /// زمان انقضای اعتبار رکورد یا توکن.
  expiresAt DateTime
  /// زمان ایجاد رکورد.
  createdAt DateTime @default(now())
  /// ارتباط Prisma با جدول User (کاربر): رکورد مرتبط مرتبط با HandoffCode؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// دسته‌بندی‌های اصلی کاتالوگ محصولات و تنظیمات نمایش آن‌ها.
model Category {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id            Int            @id @default(autoincrement())
  /// شناسه متنی خوانا و یکتای مناسب URL.
  slug          String         @unique
  /// نام فارسی موجودیت.
  nameFa        String
  /// نام انگلیسی موجودیت.
  nameEn        String
  /// نشانی یا کلید تصویر مرتبط.
  image         String?
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status        CategoryStatus @default(ACTIVE)
  /// پرچم منطقی showInMenu برای کنترل رفتار Category.
  showInMenu    Boolean        @default(true)
  /// ترتیب نمایش رکورد.
  sortOrder     Int            @default(0)
  /// زمان ایجاد رکورد.
  createdAt     DateTime       @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt     DateTime       @updatedAt
  /// ارتباط Prisma با جدول Subcategory (Subcategory): مجموعه رکوردهای وابسته مرتبط با Category؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  subcategories Subcategory[]
  /// ارتباط Prisma با جدول Product (محصول): مجموعه رکوردهای وابسته مرتبط با Category؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  products      Product[]
  /// ارتباط Prisma با جدول CommissionRule (CommissionRule): مجموعه رکوردهای وابسته مرتبط با Category؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  commissionRules CommissionRule[]

  @@index([status])
  @@index([showInMenu])
  @@index([sortOrder])
}

/// زیر‌دسته هر دسته اصلی و ارتباط آن با قالب مشخصات و محصولات.
model Subcategory {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id                    Int                               @id @default(autoincrement())
  /// شناسه Category مرتبط با این Subcategory؛ کلید خارجی به جدول Category است.
  categoryId            Int
  /// شناسه متنی خوانا و یکتای مناسب URL.
  slug                  String                            @unique
  /// نام فارسی موجودیت.
  nameFa                String
  /// نام انگلیسی موجودیت.
  nameEn                String
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status                CategoryStatus                    @default(ACTIVE)
  /// ترتیب نمایش رکورد.
  sortOrder             Int                               @default(0)
  /// زمان ایجاد رکورد.
  createdAt             DateTime                          @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt             DateTime                          @updatedAt
  /// ارتباط Prisma با جدول Category (Category): رکورد مرتبط مرتبط با Subcategory؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  category              Category                          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  /// ارتباط Prisma با جدول SpecificationTemplate (SpecificationTemplate): رکورد مرتبط مرتبط با Subcategory؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  specificationTemplate SpecificationTemplate?
  /// ارتباط Prisma با جدول Product (محصول): مجموعه رکوردهای وابسته مرتبط با Subcategory؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  products              Product[]

  @@index([categoryId])
  @@index([status])
  @@index([sortOrder])
}

/// قالب مشخصات فنی قابل استفاده برای محصولات یک زیر‌دسته.
model SpecificationTemplate {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id            Int                  @id @default(autoincrement())
  /// شناسه Subcategory مرتبط با این SpecificationTemplate؛ کلید خارجی به جدول Subcategory است.
  subcategoryId Int                  @unique
  /// نام قابل نمایش موجودیت.
  name          String
  /// شرح تکمیلی موجودیت.
  description   String?
  /// فعال یا غیرفعال بودن رکورد.
  isActive      Boolean              @default(true)
  /// زمان ایجاد رکورد.
  createdAt     DateTime             @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt     DateTime             @updatedAt
  /// ارتباط Prisma با جدول Subcategory (Subcategory): رکورد مرتبط مرتبط با SpecificationTemplate؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  subcategory   Subcategory          @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  /// ارتباط Prisma با جدول SpecificationField (SpecificationField): مجموعه رکوردهای وابسته مرتبط با SpecificationTemplate؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  fields        SpecificationField[]

  @@index([isActive])
}

/// تعریف هر فیلد مشخصات فنی شامل نوع، واحد، اجباری بودن و گزینه‌ها.
model SpecificationField {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id         Int                    @id @default(autoincrement())
  /// شناسه SpecificationTemplate مرتبط با این SpecificationField؛ کلید خارجی به جدول SpecificationTemplate است.
  templateId Int
  /// نام قابل نمایش موجودیت.
  name       String
  /// کلید ماشینی تنظیم یا گزینه.
  key        String
  /// مقدار type برای نگهداری اطلاعات مرتبط با SpecificationField.
  type       SpecificationFieldType
  /// اجباری بودن تکمیل این فیلد.
  isRequired Boolean                @default(false)
  /// واحد اندازه‌گیری یا فروش.
  unit       String?
  /// داده ساختاریافته تکمیلی options برای SpecificationField؛ ساختار آن باید در لایه سرویس اعتبارسنجی شود.
  options    Json?
  /// ترتیب نمایش رکورد.
  sortOrder  Int                    @default(0)
  /// زمان ایجاد رکورد.
  createdAt  DateTime               @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt  DateTime               @updatedAt
  /// ارتباط Prisma با جدول SpecificationTemplate (SpecificationTemplate): رکورد مرتبط مرتبط با SpecificationField؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  template   SpecificationTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, key])
  @@index([templateId])
  @@index([sortOrder])
}

// Global, reusable specification field library.
// These are NOT attached to any template — they are a shared catalogue
// of predefined fields (توان, ولتاژ, نوع کانکتور, ...) that can be
// referenced when building product `attributes` (via fieldId) or when
// composing subcategory templates.
/// کتابخانه فیلدهای مشخصات فنی قابل استفاده مجدد در قالب‌های مختلف.
model SpecificationLibraryField {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id          Int                    @id @default(autoincrement())
  /// عنوان اصلی قابل نمایش.
  title       String
  /// شناسه متنی خوانا و یکتای مناسب URL.
  slug        String                 @unique
  /// مقدار type برای نگهداری اطلاعات مرتبط با SpecificationLibraryField.
  type        SpecificationFieldType
  /// مقدار متنی defaultUnit برای توصیف یا شناسایی SpecificationLibraryField.
  defaultUnit String?
  /// شرح تکمیلی موجودیت.
  description String?
  /// فعال یا غیرفعال بودن رکورد.
  isActive    Boolean                @default(true)
  /// زمان ایجاد رکورد.
  createdAt   DateTime               @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt   DateTime               @updatedAt

  @@index([isActive])
  @@index([slug])
}


/// اطلاعات اصلی محصول فروشنده شامل مشخصات، دسته‌بندی، مالکیت و وضعیت انتشار.
model Product {

  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id               Int                @id @default(autoincrement())
  /// عنوان اصلی قابل نمایش.
  title            String
  /// شناسه متنی خوانا و یکتای مناسب URL.
  slug             String             @unique
  /// خلاصه کوتاه برای نمایش در فهرست‌ها و کارت‌ها.
  shortDescription String?
  /// شرح تکمیلی موجودیت.
  description      String?
  /// کد داخلی محصول نزد فروشنده.
  sku              String?
  // Shared manufacturer/model identity across supplier listings; not a seller SKU.
  /// شناسه مشترک سازنده/مدل برای تطبیق فهرست‌های هم‌مدل.
  catalogCode      String?
  /// نام برند سازنده یا عرضه‌کننده.
  brand            String?
  /// نام یا شماره مدل محصول.
  model            String?
  /// مقادیر ساختاریافته مشخصات فنی محصول در قالب JSON.
  specifications   Json?
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status           ProductStatus      @default(DRAFT)
  /// سطح مشاهده و دسترسی به محتوا.
  visibility       ProductVisibility  @default(PUBLIC)
  // Retail sales are explicitly opt-in. Existing products stay non-retail.
  /// پرچم منطقی retailEnabled برای کنترل رفتار محصول.
  retailEnabled    Boolean            @default(false)
  /// ویژه بودن محصول برای جایگاه‌های تبلیغاتی/برجسته.
  isFeatured       Boolean            @default(false)
  // Number of post-approval edits made by a company user. Reset to 0 on every
  // approve; once it reaches the system-configured review threshold the product
  // is automatically sent back to PENDING_REVIEW (see product.service.js).
  /// مقدار عددی editsSinceApproval برای محصول.
  editsSinceApproval Int             @default(0)
  /// شناسه شرکت مرتبط با این محصول؛ کلید خارجی به جدول Company است.
  companyId        Int
  /// شناسه Category مرتبط با این محصول؛ کلید خارجی به جدول Category است.
  categoryId       Int
  /// شناسه Subcategory مرتبط با این محصول؛ کلید خارجی به جدول Subcategory است.
  subcategoryId    Int
  /// شناسه کاربر مرتبط با این محصول؛ کلید خارجی به جدول User است.
  createdByUserId  Int
  /// زمان ایجاد رکورد.
  createdAt        DateTime           @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt        DateTime           @updatedAt
  /// زمان حذف نرم؛ مقدار NULL یعنی رکورد حذف نرم نشده است.
  deletedAt        DateTime?
  /// ارتباط Prisma با جدول Company (شرکت): رکورد مرتبط مرتبط با محصول؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  company          Company            @relation(fields: [companyId], references: [id])
  /// ارتباط Prisma با جدول Category (Category): رکورد مرتبط مرتبط با محصول؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  category         Category           @relation(fields: [categoryId], references: [id])
  /// ارتباط Prisma با جدول Subcategory (Subcategory): رکورد مرتبط مرتبط با محصول؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  subcategory      Subcategory        @relation(fields: [subcategoryId], references: [id])
  /// ارتباط Prisma با جدول User (کاربر): رکورد مرتبط مرتبط با محصول؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  createdBy        User               @relation("ProductCreatedBy", fields: [createdByUserId], references: [id])

  /// ارتباط Prisma با جدول ProductImage (ProductImage): مجموعه رکوردهای وابسته مرتبط با محصول؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  images           ProductImage[]
  /// ارتباط Prisma با جدول ProductDocument (ProductDocument): مجموعه رکوردهای وابسته مرتبط با محصول؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  documents        ProductDocument[]
  /// ارتباط Prisma با جدول ProductPriceTier (ProductPriceTier): مجموعه رکوردهای وابسته مرتبط با محصول؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  prices           ProductPriceTier[]
  /// ارتباط Prisma با جدول ProductPriceSnapshot (ProductPriceSnapshot): مجموعه رکوردهای وابسته مرتبط با محصول؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  priceSnapshots   ProductPriceSnapshot[]
  /// ارتباط Prisma با جدول ProductStatusHistory (ProductStatusHistory): مجموعه رکوردهای وابسته مرتبط با محصول؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  statusHistory    ProductStatusHistory[]
  /// ارتباط Prisma با جدول ProductActivityLog (ProductActivityLog): مجموعه رکوردهای وابسته مرتبط با محصول؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  activityLog      ProductActivityLog[]
  /// ارتباط Prisma با جدول InquiryItem (InquiryItem): مجموعه رکوردهای وابسته مرتبط با محصول؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  inquiryItems     InquiryItem[]
  /// ارتباط Prisma با جدول InventoryBalance (InventoryBalance): رکورد مرتبط مرتبط با محصول؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  inventoryBalance InventoryBalance?
  /// ارتباط Prisma با جدول InventoryMovement (InventoryMovement): مجموعه رکوردهای وابسته مرتبط با محصول؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  inventoryMovements InventoryMovement[]
  /// ارتباط Prisma با جدول InventoryReservation (InventoryReservation): مجموعه رکوردهای وابسته مرتبط با محصول؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  inventoryReservations InventoryReservation[]
  /// ارتباط Prisma با جدول RetailOrderItem (RetailOrderItem): مجموعه رکوردهای وابسته مرتبط با محصول؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  retailOrderItems RetailOrderItem[]

  @@index([companyId])
  @@index([categoryId])
  @@index([createdByUserId])
  @@index([status])
  @@index([visibility])
  @@index([isFeatured])
  @@index([deletedAt])
  @@index([sku])
  @@index([catalogCode])
}

/// تاریخچه تغییر وضعیت محصول، عامل تغییر و توضیح آن.
model ProductStatusHistory {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id             Int           @id @default(autoincrement())
  /// شناسه محصول مرتبط با این ProductStatusHistory؛ کلید خارجی به جدول Product است.
  productId      Int
  /// مقدار previousStatus برای نگهداری اطلاعات مرتبط با ProductStatusHistory.
  previousStatus ProductStatus
  /// مقدار newStatus برای نگهداری اطلاعات مرتبط با ProductStatusHistory.
  newStatus      ProductStatus
  /// شناسه کاربر مرتبط با این ProductStatusHistory؛ کلید خارجی به جدول User است.
  changedByUserId Int
  /// توضیح ثبت‌شده درباره عملیات یا تغییر.
  comment        String?
  /// زمان ایجاد رکورد.
  createdAt      DateTime      @default(now())
  /// ارتباط Prisma با جدول Product (محصول): رکورد مرتبط مرتبط با ProductStatusHistory؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  product        Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// ارتباط Prisma با جدول User (کاربر): رکورد مرتبط مرتبط با ProductStatusHistory؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  changedBy      User          @relation(fields: [changedByUserId], references: [id])

  @@index([productId])
  @@index([changedByUserId])
  @@index([newStatus])
  @@index([createdAt])
}

// Immutable audit trail of every product change: field edits, price-tier
// changes, media changes, and status workflow transitions. Unlike
// ProductStatusHistory (which only records status transitions), this captures
// every content mutation so staff can see exactly what a company changed.
/// رویدادها و فعالیت‌های انجام‌شده روی محصول برای پیگیری و ممیزی.
model ProductActivityLog {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id           Int                  @id @default(autoincrement())
  /// شناسه محصول مرتبط با این ProductActivityLog؛ کلید خارجی به جدول Product است.
  productId    Int
  /// شناسه کاربر مرتبط با این ProductActivityLog؛ کلید خارجی به جدول User است.
  actorUserId  Int
  /// نوع اقدام انجام‌شده.
  action       ProductActivityAction
  /// مقدار متنی detail برای توصیف یا شناسایی ProductActivityLog.
  detail       String?
  /// توضیح ثبت‌شده درباره عملیات یا تغییر.
  comment      String?
  /// زمان ایجاد رکورد.
  createdAt    DateTime             @default(now())
  /// ارتباط Prisma با جدول Product (محصول): رکورد مرتبط مرتبط با ProductActivityLog؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  product      Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// ارتباط Prisma با جدول User (کاربر): رکورد مرتبط مرتبط با ProductActivityLog؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  actor        User                 @relation(fields: [actorUserId], references: [id])

  @@index([productId])
  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
}

/// تصاویر محصول و فراداده لازم برای نمایش و دسترس‌پذیری.
model ProductImage {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id           Int      @id @default(autoincrement())
  /// شناسه محصول مرتبط با این ProductImage؛ کلید خارجی به جدول Product است.
  productId    Int
  /// نشانی فایل یا منبع مرتبط.
  url          String
  /// نشانی تصویر بندانگشتی.
  thumbnailUrl String?
  /// متن جایگزین تصویر برای دسترس‌پذیری و سئو.
  altText      String?
  /// اصلی بودن این مورد در میان موارد مرتبط.
  isPrimary    Boolean  @default(false)
  /// ترتیب نمایش رکورد.
  sortOrder    Int      @default(0)
  /// زمان ایجاد رکورد.
  createdAt    DateTime @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt    DateTime @updatedAt
  /// ارتباط Prisma با جدول Product (محصول): رکورد مرتبط مرتبط با ProductImage؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([isPrimary])
  @@index([sortOrder])
}

/// اسناد و فایل‌های پیوست محصول مانند دیتاشیت و کاتالوگ.
model ProductDocument {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id        Int                 @id @default(autoincrement())
  /// شناسه محصول مرتبط با این ProductDocument؛ کلید خارجی به جدول Product است.
  productId Int
  /// مقدار type برای نگهداری اطلاعات مرتبط با ProductDocument.
  type      ProductDocumentType
  /// عنوان اصلی قابل نمایش.
  title     String?
  /// نشانی فایل یا منبع مرتبط.
  url       String
  /// ترتیب نمایش رکورد.
  sortOrder Int                 @default(0)
  /// زمان ایجاد رکورد.
  createdAt DateTime            @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt DateTime            @updatedAt
  /// ارتباط Prisma با جدول Product (محصول): رکورد مرتبط مرتبط با ProductDocument؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  product   Product             @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([type])
  @@index([sortOrder])
}

/// قیمت جاری محصول بر اساس بازه حداقل و حداکثر تعداد سفارش.
model ProductPriceTier {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id          Int       @id @default(autoincrement())
  /// شناسه محصول مرتبط با این ProductPriceTier؛ کلید خارجی به جدول Product است.
  productId   Int
  /// حداقل تعداد مشمول این سطح یا بازه.
  minQuantity Int
  /// حداکثر تعداد مشمول این سطح؛ NULL یعنی سقف مشخص نشده است.
  maxQuantity Int?
  /// مبلغ قیمت واحد یا پیشنهادی.
  price       Decimal   @db.Decimal(18, 2)
  /// واحد اندازه‌گیری یا فروش.
  unit        String?
  /// شروع اعتبار قیمت یا قاعده.
  validFrom   DateTime  @default(now())
  /// پایان اعتبار؛ NULL یعنی تاریخ پایان تعیین نشده است.
  validTo     DateTime?
  /// زمان ایجاد رکورد.
  createdAt   DateTime  @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt   DateTime  @updatedAt
  /// ارتباط Prisma با جدول Product (محصول): رکورد مرتبط مرتبط با ProductPriceTier؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([minQuantity])
  @@index([validFrom])
  @@index([validTo])
}

/// تصویر تاریخی قیمت هر سطح در زمان ثبت برای گزارش و نمودار تغییرات.
model ProductPriceSnapshot {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id          Int      @id @default(autoincrement())
  /// شناسه محصول مرتبط با این ProductPriceSnapshot؛ کلید خارجی به جدول Product است.
  productId   Int
  /// شناسه رکورد مرتبط برای اتصال این ProductPriceSnapshot به موجودیت مرجع.
  priceTierId Int?
  /// حداقل تعداد مشمول این سطح یا بازه.
  minQuantity Int
  /// حداکثر تعداد مشمول این سطح؛ NULL یعنی سقف مشخص نشده است.
  maxQuantity Int?
  /// مبلغ قیمت واحد یا پیشنهادی.
  price       Decimal  @db.Decimal(18, 2)
  /// واحد اندازه‌گیری یا فروش.
  unit        String?
  /// نوع اقدام انجام‌شده.
  action      String
  /// زمان ثبت snapshot یا داده تاریخی.
  recordedAt  DateTime @default(now())
  /// ارتباط Prisma با جدول Product (محصول): رکورد مرتبط مرتبط با ProductPriceSnapshot؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, recordedAt])
  @@index([priceTierId])
}

/// درخواست خرید یا استعلام (RFQ) همراه با خریدار، وضعیت، محرمانگی و مهلت پاسخ.
model Inquiry {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id               Int               @id @default(autoincrement())
  /// عنوان اصلی قابل نمایش.
  title            String
  /// شرح تکمیلی موجودیت.
  description      String?
  // Exactly one buyer identity is set: companyId for B2B company buyers,
  // buyerUserId for CUSTOMER buyers. Enforced by a PostgreSQL CHECK constraint.
  /// شناسه شرکت مرتبط با این استعلام؛ کلید خارجی به جدول Company است.
  companyId        Int?
  /// شناسه کاربر مرتبط با این استعلام؛ کلید خارجی به جدول User است.
  buyerUserId      Int?
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status           InquiryStatus     @default(DRAFT)

  // ── Phase 2: professional inquiry model ────────────────────
  /// اولویت رسیدگی یا پردازش.
  priority         InquiryPriority       @default(NORMAL)
  /// مقدار visibilityMode برای نگهداری اطلاعات مرتبط با استعلام.
  visibilityMode   InquiryVisibilityMode @default(NORMAL)
  /// پرچم منطقی confidential برای کنترل رفتار استعلام.
  confidential     Boolean               @default(false)

  // Scheduling
  /// زمان مرتبط با publishDate در چرخه عمر استعلام.
  publishDate      DateTime?
  /// زمان مرتبط با responseDeadline در چرخه عمر استعلام.
  responseDeadline DateTime?
  /// پرچم منطقی autoClose برای کنترل رفتار استعلام.
  autoClose        Boolean               @default(true)

  // Sealed-bid reveal settings
  /// مشخص می‌کند آیا allowEarlyReveal برای این استعلام فعال یا مجاز است.
  allowEarlyReveal Boolean               @default(false)
  /// زمان revealed این استعلام را ثبت می‌کند.
  revealedAt       DateTime?

  // Response controls
  /// مشخص می‌کند آیا allowEditResponse برای این استعلام فعال یا مجاز است.
  allowEditResponse     Boolean          @default(true)
  /// مشخص می‌کند آیا allowWithdrawResponse برای این استعلام فعال یا مجاز است.
  allowWithdrawResponse Boolean          @default(false)

  /// زمان بسته‌شدن پرونده یا فرآیند.
  closedAt         DateTime?
  /// زمان ایجاد رکورد.
  createdAt        DateTime          @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt        DateTime          @updatedAt
  /// ارتباط Prisma با جدول Company (شرکت): رکورد مرتبط مرتبط با استعلام؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  company          Company?          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  /// ارتباط Prisma با جدول User (کاربر): رکورد مرتبط مرتبط با استعلام؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  buyerUser        User?              @relation("InquiryBuyer", fields: [buyerUserId], references: [id], onDelete: Cascade)
  /// ارتباط Prisma با جدول InquiryItem (InquiryItem): مجموعه رکوردهای وابسته مرتبط با استعلام؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  items            InquiryItem[]
  /// ارتباط Prisma با جدول InquiryResponse (InquiryResponse): مجموعه رکوردهای وابسته مرتبط با استعلام؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  responses        InquiryResponse[]
  /// ارتباط Prisma با جدول InquiryMessage (InquiryMessage): مجموعه رکوردهای وابسته مرتبط با استعلام؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  messages         InquiryMessage[]
  /// ارتباط Prisma با جدول InquiryStatusHistory (InquiryStatusHistory): مجموعه رکوردهای وابسته مرتبط با استعلام؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  statusHistory    InquiryStatusHistory[]

  @@index([companyId])
  @@index([buyerUserId])
  @@index([status])
  @@index([priority])
  @@index([visibilityMode])
  @@index([confidential])
  @@index([publishDate])
  @@index([responseDeadline])
  @@index([revealedAt])
  @@index([closedAt])
}



/// پیام‌های میان خریدار و شرکت‌های پاسخ‌دهنده درباره یک استعلام.
model InquiryMessage {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id                Int       @id @default(autoincrement())
  /// شناسه استعلام مرتبط با این InquiryMessage؛ کلید خارجی به جدول Inquiry است.
  inquiryId         Int
  /// شناسه کاربر مرتبط با این InquiryMessage؛ کلید خارجی به جدول User است.
  senderUserId      Int?
  /// شناسه شرکت مرتبط با این InquiryMessage؛ کلید خارجی به جدول Company است.
  senderCompanyId   Int?
  /// شناسه کاربر مرتبط با این InquiryMessage؛ کلید خارجی به جدول User است.
  recipientUserId   Int?
  /// شناسه شرکت مرتبط با این InquiryMessage؛ کلید خارجی به جدول Company است.
  recipientCompanyId Int?
  /// متن کامل پیام، یادداشت یا محتوای رکورد.
  body              String    @db.VarChar(5000)
  /// زمان ایجاد رکورد.
  createdAt         DateTime  @default(now())
  /// زمان خوانده‌شدن پیام/اعلان.
  readAt            DateTime?
  /// ارتباط Prisma با جدول Inquiry (استعلام): رکورد مرتبط مرتبط با InquiryMessage؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  inquiry           Inquiry   @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  /// ارتباط Prisma با جدول User (کاربر): رکورد مرتبط مرتبط با InquiryMessage؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  senderUser        User?     @relation("InquiryMessageSenderUser", fields: [senderUserId], references: [id], onDelete: Cascade)
  /// ارتباط Prisma با جدول Company (شرکت): رکورد مرتبط مرتبط با InquiryMessage؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  senderCompany     Company?  @relation("InquiryMessageSenderCompany", fields: [senderCompanyId], references: [id], onDelete: Cascade)
  /// ارتباط Prisma با جدول User (کاربر): رکورد مرتبط مرتبط با InquiryMessage؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  recipientUser     User?     @relation("InquiryMessageRecipientUser", fields: [recipientUserId], references: [id], onDelete: Cascade)
  /// ارتباط Prisma با جدول Company (شرکت): رکورد مرتبط مرتبط با InquiryMessage؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  recipientCompany  Company?  @relation("InquiryMessageRecipientCompany", fields: [recipientCompanyId], references: [id], onDelete: Cascade)

  @@index([inquiryId, createdAt])
  @@index([senderUserId])
  @@index([senderCompanyId])
  @@index([recipientUserId])
  @@index([recipientCompanyId])
}

/// تاریخچه تغییر وضعیت استعلام همراه با عامل و دلیل تغییر.
model InquiryStatusHistory {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id             Int           @id @default(autoincrement())
  /// شناسه استعلام مرتبط با این InquiryStatusHistory؛ کلید خارجی به جدول Inquiry است.
  inquiryId      Int
  /// مقدار previousStatus برای نگهداری اطلاعات مرتبط با InquiryStatusHistory.
  previousStatus InquiryStatus
  /// مقدار newStatus برای نگهداری اطلاعات مرتبط با InquiryStatusHistory.
  newStatus      InquiryStatus
  /// شناسه کاربر مرتبط با این InquiryStatusHistory؛ کلید خارجی به جدول User است.
  changedByUserId Int?
  /// منبع ایجاد یا ثبت رکورد.
  source         String        @default("USER")
  /// توضیح ثبت‌شده درباره عملیات یا تغییر.
  comment        String?
  /// زمان ایجاد رکورد.
  createdAt      DateTime      @default(now())
  /// ارتباط Prisma با جدول Inquiry (استعلام): رکورد مرتبط مرتبط با InquiryStatusHistory؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  inquiry        Inquiry       @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  /// ارتباط Prisma با جدول User (کاربر): رکورد مرتبط مرتبط با InquiryStatusHistory؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  changedBy      User?         @relation(fields: [changedByUserId], references: [id])

  @@index([inquiryId])
  @@index([changedByUserId])
  @@index([newStatus])
  @@index([createdAt])
}

/// اقلام و محصولات درخواست‌شده در یک استعلام به همراه تعداد و توضیح.
model InquiryItem {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id            Int                   @id @default(autoincrement())
  /// شناسه استعلام مرتبط با این InquiryItem؛ کلید خارجی به جدول Inquiry است.
  inquiryId     Int
  /// شناسه محصول مرتبط با این InquiryItem؛ کلید خارجی به جدول Product است.
  productId     Int
  /// شرح تکمیلی موجودیت.
  description   String?
  /// تعداد واحدهای کالا یا مقدار موردنظر.
  quantity      Int
  /// مقدار متنی attachment برای توصیف یا شناسایی InquiryItem.
  attachment    String?
  /// زمان ایجاد رکورد.
  createdAt     DateTime              @default(now())
  /// ارتباط Prisma با جدول Inquiry (استعلام): رکورد مرتبط مرتبط با InquiryItem؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  inquiry       Inquiry               @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  /// ارتباط Prisma با جدول Product (محصول): رکورد مرتبط مرتبط با InquiryItem؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  product       Product               @relation(fields: [productId], references: [id])
  /// ارتباط Prisma با جدول InquiryResponseItem (InquiryResponseItem): مجموعه رکوردهای وابسته مرتبط با InquiryItem؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  responseItems InquiryResponseItem[]

  @@index([inquiryId])
  @@index([productId])
}

/// پاسخ یا پیشنهاد یک شرکت تأمین‌کننده به یک استعلام.
model InquiryResponse {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id          Int                   @id @default(autoincrement())
  /// شناسه استعلام مرتبط با این InquiryResponse؛ کلید خارجی به جدول Inquiry است.
  inquiryId   Int
  /// شناسه شرکت مرتبط با این InquiryResponse؛ کلید خارجی به جدول Company است.
  companyId   Int
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status      InquiryResponseStatus @default(PENDING)
  /// زمان withdrawn این InquiryResponse را ثبت می‌کند.
  withdrawnAt DateTime?
  /// زمان ایجاد رکورد.
  createdAt   DateTime              @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt   DateTime              @updatedAt
  /// ارتباط Prisma با جدول Inquiry (استعلام): رکورد مرتبط مرتبط با InquiryResponse؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  inquiry     Inquiry               @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  /// ارتباط Prisma با جدول Company (شرکت): رکورد مرتبط مرتبط با InquiryResponse؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  company     Company               @relation(fields: [companyId], references: [id])
  /// ارتباط Prisma با جدول InquiryResponseItem (InquiryResponseItem): مجموعه رکوردهای وابسته مرتبط با InquiryResponse؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  items       InquiryResponseItem[]
  /// ارتباط Prisma با جدول InquiryResponseAttachment (InquiryResponseAttachment): مجموعه رکوردهای وابسته مرتبط با InquiryResponse؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  attachments InquiryResponseAttachment[]

  @@unique([inquiryId, companyId])
  @@index([inquiryId])
  @@index([companyId])
  @@index([status])
}

/// فایل‌های پیوست یک پاسخ استعلام به همراه مشخصات فایل.
model InquiryResponseAttachment {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id         Int             @id @default(autoincrement())
  /// شناسه InquiryResponse مرتبط با این InquiryResponseAttachment؛ کلید خارجی به جدول InquiryResponse است.
  responseId Int
  /// نشانی فایل یا منبع مرتبط.
  url        String
  /// نام فایل.
  filename   String
  /// مقدار متنی mimetype برای توصیف یا شناسایی InquiryResponseAttachment.
  mimetype   String?
  /// اندازه فایل بر حسب بایت.
  size       Int?
  /// زمان ایجاد رکورد.
  createdAt  DateTime        @default(now())
  /// ارتباط Prisma با جدول InquiryResponse (InquiryResponse): رکورد مرتبط مرتبط با InquiryResponseAttachment؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  response   InquiryResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@index([responseId])
}


/// قیمت و شرایط تأمین پیشنهادی شرکت برای یک قلم استعلام.
model InquiryResponseItem {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id                Int             @id @default(autoincrement())
  /// شناسه InquiryResponse مرتبط با این InquiryResponseItem؛ کلید خارجی به جدول InquiryResponse است.
  responseId        Int
  /// شناسه InquiryItem مرتبط با این InquiryResponseItem؛ کلید خارجی به جدول InquiryItem است.
  inquiryItemId     Int
  /// مبلغ قیمت واحد یا پیشنهادی.
  price             Decimal         @db.Decimal(18, 2)
  /// کد سه‌حرفی ارز (ISO 4217) مبالغ این رکورد.
  currency          String          @default("IRR")
  /// تعداد قابل تأمین در این پیشنهاد.
  availableQuantity Int
  /// مقدار متنی deliveryTime برای توصیف یا شناسایی InquiryResponseItem.
  deliveryTime      String?
  /// شرح تکمیلی موجودیت.
  description       String?
  /// ارتباط Prisma با جدول InquiryResponse (InquiryResponse): رکورد مرتبط مرتبط با InquiryResponseItem؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  response          InquiryResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  /// ارتباط Prisma با جدول InquiryItem (InquiryItem): رکورد مرتبط مرتبط با InquiryResponseItem؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  inquiryItem       InquiryItem     @relation(fields: [inquiryItemId], references: [id])

  @@unique([responseId, inquiryItemId])
  @@index([responseId])
  @@index([inquiryItemId])
  @@index([currency])
}

/// محدودیت‌های کلی تعداد استعلام باز و پاسخ فعال هر شرکت در ساختار قدیمی.
model CompanyInquiryLimit {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id                 Int      @id @default(autoincrement())
  /// شناسه شرکت مرتبط با این CompanyInquiryLimit؛ کلید خارجی به جدول Company است.
  companyId          Int      @unique
  /// حد یا تعداد مجاز/ثبت‌شده برای CompanyInquiryLimit.
  maxOpenInquiries   Int      @default(5)
  /// حد یا تعداد مجاز/ثبت‌شده برای CompanyInquiryLimit.
  maxActiveResponses Int      @default(20)
  /// زمان ایجاد رکورد.
  createdAt          DateTime @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt          DateTime @updatedAt
  /// ارتباط Prisma با جدول Company (شرکت): رکورد مرتبط مرتبط با CompanyInquiryLimit؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

/// سقف‌ها و محدودیت‌های قابل پیکربندی هر شرکت به شکل کلید و مقدار.
model CompanyLimit {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id        Int      @id @default(autoincrement())
  /// شناسه شرکت مرتبط با این CompanyLimit؛ کلید خارجی به جدول Company است.
  companyId Int
  /// کلید ماشینی تنظیم یا گزینه.
  key       String
  /// مقدار تنظیم یا محدودیت؛ مفهوم آن با key مشخص می‌شود.
  value     Int
  /// زمان ایجاد رکورد.
  createdAt DateTime @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt DateTime @updatedAt
  /// ارتباط Prisma با جدول Company (شرکت): رکورد مرتبط مرتبط با CompanyLimit؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key])
  @@index([companyId])
  @@index([key])
}

// Commercial plans and auditable usage for the RFQ/inquiry revenue model.
// Enforcement is rollout-gated by SystemSetting key "inquiry.subscription_enforcement"
// so deployment can be migrated before existing users are required to subscribe.
/// تعریف بسته اشتراک استعلام و سهمیه‌های قابل مصرف در هر دوره.
model InquiryPlan {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id                         Int      @id @default(autoincrement())
  /// کد ماشینی یا تجاری این موجودیت.
  code                       String   @unique
  /// نام قابل نمایش موجودیت.
  name                       String
  /// شرح تکمیلی موجودیت.
  description                String?
  /// مدت دوره بر حسب روز.
  durationDays               Int
  /// مبلغ قیمت واحد یا پیشنهادی.
  price                      Decimal  @db.Decimal(18, 2)
  /// کد سه‌حرفی ارز (ISO 4217) مبالغ این رکورد.
  currency                   String   @default("IRR")
  /// مقدار عددی inquiriesPerPeriod برای InquiryPlan.
  inquiriesPerPeriod         Int      @default(0)
  /// مقدار عددی responsesPerPeriod برای InquiryPlan.
  responsesPerPeriod         Int      @default(0)
  /// مقدار عددی internalMessagesPerPeriod برای InquiryPlan.
  internalMessagesPerPeriod  Int      @default(0)
  /// مقدار عددی smsPerPeriod برای InquiryPlan.
  smsPerPeriod               Int      @default(0)
  /// فعال یا غیرفعال بودن رکورد.
  isActive                   Boolean  @default(true)
  /// زمان ایجاد رکورد.
  createdAt                  DateTime @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt                  DateTime @updatedAt
  /// ارتباط Prisma با جدول InquirySubscription (InquirySubscription): مجموعه رکوردهای وابسته مرتبط با InquiryPlan؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  subscriptions              InquirySubscription[]

  @@index([isActive])
}

/// اشتراک تخصیص‌یافته یا خریداری‌شده توسط شرکت/کاربر و بازه اعتبار آن.
model InquirySubscription {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id          Int      @id @default(autoincrement())
  /// شناسه InquiryPlan مرتبط با این InquirySubscription؛ کلید خارجی به جدول InquiryPlan است.
  planId      Int
  /// شناسه شرکت مرتبط با این InquirySubscription؛ کلید خارجی به جدول Company است.
  companyId   Int?
  /// شناسه کاربر مرتبط با این InquirySubscription؛ کلید خارجی به جدول User است.
  userId      Int?
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status      InquirySubscriptionStatus @default(PENDING_PAYMENT)
  /// زمان شروع اعتبار یا فعال‌بودن.
  startsAt    DateTime?
  /// زمان پایان اعتبار یا فعال‌بودن.
  endsAt      DateTime?
  /// مقدار عددی activatedBy برای InquirySubscription.
  activatedBy Int?
  /// مقدار متنی paymentReference برای توصیف یا شناسایی InquirySubscription.
  paymentReference String? @unique
  /// مقدار متنی paymentProvider برای توصیف یا شناسایی InquirySubscription.
  paymentProvider String?
  /// مقدار متنی paymentAuthority برای توصیف یا شناسایی InquirySubscription.
  paymentAuthority String? @unique
  /// شناسه رکورد مرتبط برای اتصال این InquirySubscription به موجودیت مرجع.
  paymentRefId String?
  /// مبلغ paymentAmount برای این InquirySubscription؛ واحد پول در فیلد currency مشخص می‌شود.
  paymentAmount Int?
  /// زمان paymentVerified این InquirySubscription را ثبت می‌کند.
  paymentVerifiedAt DateTime?
  /// یادداشت‌های تکمیلی درباره رکورد.
  notes       String?
  /// زمان ایجاد رکورد.
  createdAt   DateTime @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt   DateTime @updatedAt
  /// ارتباط Prisma با جدول InquiryPlan (InquiryPlan): رکورد مرتبط مرتبط با InquirySubscription؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  plan        InquiryPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  /// ارتباط Prisma با جدول Company (شرکت): رکورد مرتبط مرتبط با InquirySubscription؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  company     Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// ارتباط Prisma با جدول User (کاربر): رکورد مرتبط مرتبط با InquirySubscription؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  user        User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// ارتباط Prisma با جدول InquiryUsageEvent (InquiryUsageEvent): مجموعه رکوردهای وابسته مرتبط با InquirySubscription؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  usage       InquiryUsageEvent[]

  @@index([companyId, status, endsAt])
  @@index([userId, status, endsAt])
  @@index([planId])
}

/// رویداد مصرف سهمیه اشتراک و مرجع عملیاتی آن برای محاسبه مصرف.
model InquiryUsageEvent {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id             BigInt   @id @default(autoincrement())
  /// شناسه InquirySubscription مرتبط با این InquiryUsageEvent؛ کلید خارجی به جدول InquirySubscription است.
  subscriptionId Int
  /// مقدار usageType برای نگهداری اطلاعات مرتبط با InquiryUsageEvent.
  usageType      InquiryUsageType
  /// تعداد واحدهای کالا یا مقدار موردنظر.
  quantity       Int      @default(1)
  /// مقدار متنی referenceType برای توصیف یا شناسایی InquiryUsageEvent.
  referenceType  String?
  /// شناسه رکورد مرتبط برای اتصال این InquiryUsageEvent به موجودیت مرجع.
  referenceId    String?
  /// کلید یکتای جلوگیری از اجرای تکراری درخواست/عملیات.
  idempotencyKey String?  @unique
  /// داده‌های تکمیلی ساختاریافته و وابسته به دامنه در قالب JSON.
  metadata       Json?
  /// زمان ایجاد رکورد.
  createdAt      DateTime @default(now())
  /// ارتباط Prisma با جدول InquirySubscription (InquirySubscription): رکورد مرتبط مرتبط با InquiryUsageEvent؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  subscription   InquirySubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, usageType, createdAt])
  @@index([referenceType, referenceId])
}

