enum ArticleStatus {
  DRAFT
  IN_REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum ArticleType {
  NEWS
  ARTICLE
  GUIDE
}

/// محتوای مقاله/مجله شامل متن، وضعیت انتشار، نویسنده، زمان‌بندی و فراداده SEO.
model Article {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id               Int          @id @default(autoincrement())
  /// شناسه متنی خوانا و یکتای مناسب URL.
  slug             String       @unique @db.VarChar(220)
  /// عنوان اصلی قابل نمایش.
  title            String       @db.VarChar(240)
  /// چکیده کوتاه محتوا برای پیش‌نمایش.
  excerpt          String?      @db.VarChar(600)
  /// محتوای اصلی متن یا مقاله.
  content          String
  /// قالب یا نحوه تفسیر محتوای مقاله.
  contentFormat    String       @default("HTML") @db.VarChar(20)
  /// مقدار type برای نگهداری اطلاعات مرتبط با مقاله.
  type             ArticleType  @default(ARTICLE)
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status           ArticleStatus @default(DRAFT)
  /// مقدار متنی coverImageKey برای توصیف یا شناسایی مقاله.
  coverImageKey    String?      @db.VarChar(500)
  /// شناسه کاربر مرتبط با این مقاله؛ کلید خارجی به جدول User است.
  authorUserId     Int
  /// شناسه کاربر مرتبط با این مقاله؛ کلید خارجی به جدول User است.
  publishedByUserId Int?
  /// زمان انتشار عمومی محتوا.
  publishedAt      DateTime?
  /// زمان برنامه‌ریزی‌شده انتشار.
  scheduledAt      DateTime?
  /// عنوان SEO صفحه.
  metaTitle        String?      @db.VarChar(240)
  /// توضیح SEO صفحه.
  metaDescription  String?      @db.VarChar(500)
  /// نشانی canonical صفحه برای موتورهای جست‌وجو.
  canonicalUrl     String?      @db.VarChar(500)
  /// اجازه ایندکس‌شدن صفحه توسط موتورهای جست‌وجو.
  isIndexable      Boolean      @default(true)
  /// زمان ایجاد رکورد.
  createdAt        DateTime     @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt        DateTime     @updatedAt
  /// ارتباط Prisma با جدول User (کاربر): رکورد مرتبط مرتبط با مقاله؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  author           User         @relation("ArticleAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  /// ارتباط Prisma با جدول User (کاربر): رکورد مرتبط مرتبط با مقاله؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  publishedBy      User?        @relation("ArticlePublisher", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  /// ارتباط Prisma با جدول ArticleCategoryAssignment (ArticleCategoryAssignment): مجموعه رکوردهای وابسته مرتبط با مقاله؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  categories       ArticleCategoryAssignment[]
  /// ارتباط Prisma با جدول ArticleTagAssignment (ArticleTagAssignment): مجموعه رکوردهای وابسته مرتبط با مقاله؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  tags             ArticleTagAssignment[]
  /// ارتباط Prisma با جدول ArticleRevision (ArticleRevision): مجموعه رکوردهای وابسته مرتبط با مقاله؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  revisions        ArticleRevision[]
  /// ارتباط Prisma با جدول ArticleMedia (ArticleMedia): مجموعه رکوردهای وابسته مرتبط با مقاله؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  media            ArticleMedia[]

  @@index([status, publishedAt])
  @@index([type, status, publishedAt])
  @@index([authorUserId, updatedAt])
  @@index([scheduledAt])

}

/// دسته‌بندی مطالب مجله برای گروه‌بندی و فیلتر محتوا.
model ArticleCategory {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
