  id            Int      @id @default(autoincrement())
  /// کلید ماشینی تنظیم یا گزینه.
  key           String   @unique
  /// مقدار تنظیم یا محدودیت؛ مفهوم آن با key مشخص می‌شود.
  value         String
  /// شناسه رکورد مرتبط برای اتصال این SystemSetting به موجودیت مرجع.
  updatedByUserId Int?
  /// زمان ایجاد رکورد.
  createdAt     DateTime @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt     DateTime @updatedAt

  @@index([key])
}

/// اعلان اصلی متعلق به کاربر، شامل عنوان، متن، نوع و وضعیت خوانده‌شدن.
model Notification {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id        Int      @id @default(autoincrement())
  /// شناسه کاربر مرتبط با این اعلان؛ کلید خارجی به جدول User است.
  userId    Int
  // Event key from src/modules/notifications/notification.events.js
  // (e.g. 'PRODUCT_STATUS_CHANGED'). Null = legacy/untyped row created
  // before the central dispatch service existed.
  /// مقدار متنی type برای توصیف یا شناسایی اعلان.
  type      String?
  // Structured event payload (e.g. { productId, status }) for deep-linking.
  /// داده تکمیلی اعلان/رویداد در قالب JSON.
  data      Json?
  /// عنوان اصلی قابل نمایش.
  title     String
  /// مقدار متنی message برای توصیف یا شناسایی اعلان.
  message   String
  /// خوانده‌شدن اعلان توسط کاربر.
  isRead    Boolean  @default(false)
  /// زمان ایجاد رکورد.
  createdAt DateTime @default(now())
  /// ارتباط Prisma با جدول User (کاربر): رکورد مرتبط مرتبط با اعلان؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// ارتباط Prisma با جدول NotificationFolderMembership (NotificationFolderMembership): مجموعه رکوردهای وابسته مرتبط با اعلان؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  folderMemberships NotificationFolderMembership[]

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([type])
}

// Per-user, per-event, per-channel opt-in/out matrix (flow/06 §3: NO channel
// is mandatory — every (user, event, channel) can be switched off, only the
// defaults are sensible: IN_APP + EMAIL on, SMS off).
// A missing row means "use the event's channel defaults".
//
// VERIFIED against the live database (2026-10-24, `prisma db pull`): column
// types, nullability, the (userId, eventType, channel) unique index and the
// CASCADE FK to User all match this definition 1:1. `updatedAt` is NOT NULL
// with NO database default — `@updatedAt` is populated by the Prisma Client on
// write, so raw-SQL inserts must supply it explicitly.
 
// Admin-managed folders. INBOX and SAVED are immutable system folders.
// Scope controls which app inboxes can display a folder; memberships are
// associations, so copy adds a second association and move swaps one.
/// تعریف پوشه‌های سیستمی یا مدیریتی اعلان و محدوده نمایش آن‌ها.
model NotificationFolder {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id        Int      @id @default(autoincrement())
  /// کلید ماشینی تنظیم یا گزینه.
  key       String   @unique
  /// نام قابل نمایش موجودیت.
  name      String
  /// محدوده اعتبار یا نمایش رکورد.
  scope     NotificationFolderScope @default(ALL)
  /// سیستمی بودن رکورد و محدودیت مدیریت عادی آن.
  isSystem  Boolean  @default(false)
  /// فعال یا غیرفعال بودن رکورد.
  isActive  Boolean  @default(true)
  /// ترتیب نمایش رکورد.
  sortOrder Int      @default(0)
  /// زمان ایجاد رکورد.
  createdAt DateTime @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt DateTime @updatedAt
  /// ارتباط Prisma با جدول NotificationFolderMembership (NotificationFolderMembership): مجموعه رکوردهای وابسته مرتبط با NotificationFolder؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  memberships NotificationFolderMembership[]

  @@index([scope, isActive, sortOrder])
}

/// ارتباط اعلان با پوشه؛ امکان عضویت یک اعلان در پوشه‌ها را ثبت می‌کند.
model NotificationFolderMembership {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id             Int @id @default(autoincrement())
  /// شناسه اعلان مرتبط با این NotificationFolderMembership؛ کلید خارجی به جدول Notification است.
  notificationId Int
  /// شناسه NotificationFolder مرتبط با این NotificationFolderMembership؛ کلید خارجی به جدول NotificationFolder است.
  folderId       Int
  /// زمان ایجاد رکورد.
  createdAt      DateTime @default(now())
  /// ارتباط Prisma با جدول Notification (اعلان): رکورد مرتبط مرتبط با NotificationFolderMembership؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  /// ارتباط Prisma با جدول NotificationFolder (NotificationFolder): رکورد مرتبط مرتبط با NotificationFolderMembership؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  folder         NotificationFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@unique([notificationId, folderId])
  @@index([folderId])
}

enum NotificationFolderScope {
  ALL
  WEBSITE
  COMPANY
  ADMIN
}

/// ترجیحات هر کاربر برای دریافت نوع مشخصی از اعلان از طریق یک کانال.
model NotificationPreference {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id        Int                 @id @default(autoincrement())
  /// شناسه کاربر مرتبط با این NotificationPreference؛ کلید خارجی به جدول User است.
  userId    Int
  /// نوع رویداد ثبت‌شده.
  eventType String
  /// کانال ارسال یا دریافت.
