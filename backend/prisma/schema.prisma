  /// مقدار متنی carrier برای توصیف یا شناسایی Shipment.
  carrier           String?        @db.VarChar(120)
  /// مقدار متنی trackingNumber برای توصیف یا شناسایی Shipment.
  trackingNumber    String?        @db.VarChar(160)
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status            ShipmentStatus @default(LABEL_CREATED)
  /// زمان shipped این Shipment را ثبت می‌کند.
  shippedAt         DateTime?
  /// زمان delivered این Shipment را ثبت می‌کند.
