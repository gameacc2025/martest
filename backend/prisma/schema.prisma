  closedAt        DateTime?
  /// زمان ایجاد رکورد.
  createdAt       DateTime     @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt       DateTime     @updatedAt
  /// ارتباط Prisma با جدول RetailOrder (سفارش): رکورد مرتبط مرتبط با ReturnRequest؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  order           RetailOrder  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// ارتباط Prisma با جدول SellerOrder (سفارش فروشنده): رکورد مرتبط مرتبط با ReturnRequest؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  sellerOrder     SellerOrder  @relation(fields: [sellerOrderId, orderId], references: [id, orderId], onDelete: Restrict)
  /// ارتباط Prisma با جدول User (کاربر): رکورد مرتبط مرتبط با ReturnRequest؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  buyer           User         @relation(fields: [buyerUserId], references: [id], onDelete: Restrict)
  /// ارتباط Prisma با جدول ReturnItem (ReturnItem): مجموعه رکوردهای وابسته مرتبط با ReturnRequest؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  items           ReturnItem[]

  @@index([orderId, status])
  @@index([sellerOrderId, status])
  @@index([buyerUserId, createdAt])

}

/// اقلام و تعدادهای مشمول درخواست مرجوعی و نتیجه بازرسی آن‌ها.
model ReturnItem {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id              Int                   @id @default(autoincrement())
  /// شناسه ReturnRequest مرتبط با این ReturnItem؛ کلید خارجی به جدول ReturnRequest است.
  returnRequestId Int
  /// شناسه RetailOrderItem مرتبط با این ReturnItem؛ کلید خارجی به جدول RetailOrderItem است.
  orderItemId     Int
  /// تعداد واحدهای کالا یا مقدار موردنظر.
  quantity        Int
  /// نحوه تعیین تکلیف کالای برگشتی.
  disposition     ReturnItemDisposition?
  /// مقدار متنی inspectionNote برای توصیف یا شناسایی ReturnItem.
  inspectionNote  String?
  /// زمان ایجاد رکورد.
  createdAt       DateTime              @default(now())
  /// ارتباط Prisma با جدول ReturnRequest (ReturnRequest): رکورد مرتبط مرتبط با ReturnItem؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  returnRequest   ReturnRequest         @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  /// ارتباط Prisma با جدول RetailOrderItem (RetailOrderItem): رکورد مرتبط مرتبط با ReturnItem؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  orderItem       RetailOrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([returnRequestId, orderItemId])
  @@index([orderItemId])

}

// ============================================================================
// DB-6 — Marketplace finance, immutable ledger and settlements
// ============================================================================
enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  REVERSED
}

enum CommissionCalculationType {
  PERCENTAGE
  FIXED_PER_ORDER
}

enum SellerPayableStatus {
  PENDING
  ON_HOLD
  ELIGIBLE
  INCLUDED_IN_SETTLEMENT
  PAID
  REVERSED
}

enum SettlementApprovalDecision {
  APPROVE
  REJECT
  RETURN_FOR_REVISION
}

enum SettlementStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  PAYOUT_PENDING
  PAID
  RECONCILED
  ON_HOLD
  REJECTED
  PAYOUT_FAILED
  ADJUSTED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  VOID
}

/// حساب دفتر کل با کد، نام، ماهیت حساب و ارز.
model LedgerAccount {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id          Int               @id @default(autoincrement())
  /// کد ماشینی یا تجاری این موجودیت.
  code        String            @unique @db.VarChar(80)
  /// نام قابل نمایش موجودیت.
  name        String            @db.VarChar(200)
  /// ماهیت یا نوع حساب.
  accountType LedgerAccountType
  /// کد سه‌حرفی ارز (ISO 4217) مبالغ این رکورد.
  currency    String            @db.VarChar(3)
  /// سیستمی بودن رکورد و محدودیت مدیریت عادی آن.
  isSystem    Boolean           @default(false)
  /// فعال یا غیرفعال بودن رکورد.
  isActive    Boolean           @default(true)
  /// زمان ایجاد رکورد.
  createdAt   DateTime          @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt   DateTime          @updatedAt
  /// ارتباط Prisma با جدول JournalLine (JournalLine): مجموعه رکوردهای وابسته مرتبط با LedgerAccount؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  lines       JournalLine[]

  @@index([accountType, currency, isActive])

}

/// سند حسابداری دفتر کل با منبع، وضعیت ثبت و ارتباط با سند معکوس.
model JournalEntry {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id              BigInt            @id @default(autoincrement())
  /// مقدار متنی entryNumber برای توصیف یا شناسایی JournalEntry.
  entryNumber     String            @unique @db.VarChar(48)
  /// مقدار متنی sourceType برای توصیف یا شناسایی JournalEntry.
  sourceType      String?           @db.VarChar(80)
  /// شناسه رکورد مرتبط برای اتصال این JournalEntry به موجودیت مرجع.
  sourceId        String?           @db.VarChar(120)
  /// کد سه‌حرفی ارز (ISO 4217) مبالغ این رکورد.
  currency        String            @db.VarChar(3)
  /// شرح تکمیلی موجودیت.
  description     String?           @db.VarChar(1000)
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status          JournalEntryStatus @default(DRAFT)
  /// زمان وقوع رویداد در منبع.
  occurredAt      DateTime          @default(now())
  /// زمان posted این JournalEntry را ثبت می‌کند.
  postedAt        DateTime?
  /// شناسه کاربر مرتبط با این JournalEntry؛ کلید خارجی به جدول User است.
  createdByUserId Int?
  /// شناسه JournalEntry مرتبط با این JournalEntry؛ کلید خارجی به جدول JournalEntry است.
  reversalOfId    BigInt?           @unique
  /// زمان ایجاد رکورد.
  createdAt       DateTime          @default(now())
  /// ارتباط Prisma با جدول JournalLine (JournalLine): مجموعه رکوردهای وابسته مرتبط با JournalEntry؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  lines           JournalLine[]
  /// ارتباط Prisma با جدول User (کاربر): رکورد مرتبط مرتبط با JournalEntry؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  createdBy       User?             @relation("JournalEntryCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  /// ارتباط Prisma با جدول JournalEntry (JournalEntry): رکورد مرتبط مرتبط با JournalEntry؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  reversalOf      JournalEntry?     @relation("JournalReversals", fields: [reversalOfId], references: [id], onDelete: Restrict)
  /// ارتباط Prisma با جدول JournalEntry (JournalEntry): مجموعه رکوردهای وابسته مرتبط با JournalEntry؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  reversals       JournalEntry[]    @relation("JournalReversals")

  @@index([sourceType, sourceId])
  @@index([status, occurredAt])
  @@index([currency, postedAt])

}

/// سطر بدهکار/بستانکار سند حسابداری و حساب دفتر کل مربوط.
model JournalLine {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id             BigInt       @id @default(autoincrement())
  /// شناسه JournalEntry مرتبط با این JournalLine؛ کلید خارجی به جدول JournalEntry است.
  journalEntryId BigInt
  /// شناسه LedgerAccount مرتبط با این JournalLine؛ کلید خارجی به جدول LedgerAccount است.
  accountId      Int
  /// مبلغ debit برای این JournalLine؛ واحد پول در فیلد currency مشخص می‌شود.
  debit          Decimal      @default(0) @db.Decimal(20, 2)
  /// مبلغ credit برای این JournalLine؛ واحد پول در فیلد currency مشخص می‌شود.
  credit         Decimal      @default(0) @db.Decimal(20, 2)
  /// شرح کوتاه سطر یا عملیات.
  memo           String?      @db.VarChar(500)
  /// زمان ایجاد رکورد.
  createdAt      DateTime     @default(now())
  /// ارتباط Prisma با جدول JournalEntry (JournalEntry): رکورد مرتبط مرتبط با JournalLine؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  /// ارتباط Prisma با جدول LedgerAccount (LedgerAccount): رکورد مرتبط مرتبط با JournalLine؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  account        LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([journalEntryId])
  @@index([accountId, createdAt])

}

/// قاعده محاسبه کمیسیون بر اساس درصد/مبلغ ثابت، شرکت/دسته و بازه اعتبار.
model CommissionRule {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id            Int                       @id @default(autoincrement())
  /// کد ماشینی یا تجاری این موجودیت.
  code          String                    @unique @db.VarChar(80)
  /// نام قابل نمایش موجودیت.
  name          String                    @db.VarChar(200)
  /// روش محاسبه مقدار یا کمیسیون.
  calculation   CommissionCalculationType
  /// نرخ یا درصد مورد استفاده در محاسبه.
  rate          Decimal                   @db.Decimal(12, 6)
  /// کد سه‌حرفی ارز (ISO 4217) مبالغ این رکورد.
  currency      String?                   @db.VarChar(3)
  /// شناسه شرکت مرتبط با این CommissionRule؛ کلید خارجی به جدول Company است.
  companyId     Int?
  /// شناسه Category مرتبط با این CommissionRule؛ کلید خارجی به جدول Category است.
  categoryId    Int?
  /// اولویت رسیدگی یا پردازش.
  priority      Int                       @default(0)
  /// شروع اعتبار قیمت یا قاعده.
  validFrom     DateTime
  /// پایان اعتبار؛ NULL یعنی تاریخ پایان تعیین نشده است.
  validTo       DateTime?
  /// فعال یا غیرفعال بودن رکورد.
  isActive      Boolean                   @default(true)
  /// زمان ایجاد رکورد.
  createdAt     DateTime                  @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt     DateTime                  @updatedAt
  /// ارتباط Prisma با جدول Company (شرکت): رکورد مرتبط مرتبط با CommissionRule؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  company       Company?                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  /// ارتباط Prisma با جدول Category (Category): رکورد مرتبط مرتبط با CommissionRule؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  category      Category?                 @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// ارتباط Prisma با جدول CommissionSnapshot (CommissionSnapshot): مجموعه رکوردهای وابسته مرتبط با CommissionRule؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  snapshots     CommissionSnapshot[]

  @@index([isActive, validFrom, validTo, priority])
  @@index([companyId, categoryId])

}

/// snapshot کمیسیون محاسبه‌شده برای سفارش فروشنده تا تغییر بعدی قانون، مبلغ تاریخی را عوض نکند.
model CommissionSnapshot {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id             Int            @id @default(autoincrement())
  /// شناسه سفارش فروشنده مرتبط با این CommissionSnapshot؛ کلید خارجی به جدول SellerOrder است.
  sellerOrderId  Int            @unique
  /// شناسه CommissionRule مرتبط با این CommissionSnapshot؛ کلید خارجی به جدول CommissionRule است.
  ruleId         Int?
  /// روش محاسبه مقدار یا کمیسیون.
  calculation    CommissionCalculationType
  /// نرخ یا درصد مورد استفاده در محاسبه.
  rate           Decimal        @db.Decimal(12, 6)
  /// مبلغ baseAmount برای این CommissionSnapshot؛ واحد پول در فیلد currency مشخص می‌شود.
  baseAmount     Decimal        @db.Decimal(20, 2)
  /// مبلغ commissionAmount برای این CommissionSnapshot؛ واحد پول در فیلد currency مشخص می‌شود.
  commissionAmount Decimal      @db.Decimal(20, 2)
  /// کد سه‌حرفی ارز (ISO 4217) مبالغ این رکورد.
  currency       String         @db.VarChar(3)
  /// زمان ایجاد رکورد.
  createdAt      DateTime       @default(now())
  /// ارتباط Prisma با جدول SellerOrder (سفارش فروشنده): رکورد مرتبط مرتبط با CommissionSnapshot؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  sellerOrder    SellerOrder    @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  /// ارتباط Prisma با جدول CommissionRule (CommissionRule): رکورد مرتبط مرتبط با CommissionSnapshot؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  rule           CommissionRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

}

/// بدهی خالص بازارگاه به فروشنده برای سفارش، پس از کمیسیون و کسورات.
model SellerPayable {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id             BigInt             @id @default(autoincrement())
  /// شناسه سفارش فروشنده مرتبط با این SellerPayable؛ کلید خارجی به جدول SellerOrder است.
  sellerOrderId  Int                @unique
  /// شناسه شرکت مرتبط با این SellerPayable؛ کلید خارجی به جدول Company است.
  companyId      Int
  /// شناسه تسویه مرتبط با این SellerPayable؛ کلید خارجی به جدول Settlement است.
  settlementId   Int?
  /// کد سه‌حرفی ارز (ISO 4217) مبالغ این رکورد.
  currency       String             @db.VarChar(3)
  /// مبلغ grossAmount برای این SellerPayable؛ واحد پول در فیلد currency مشخص می‌شود.
  grossAmount    Decimal            @db.Decimal(20, 2)
  /// مبلغ commissionAmount برای این SellerPayable؛ واحد پول در فیلد currency مشخص می‌شود.
  commissionAmount Decimal          @default(0) @db.Decimal(20, 2)
  /// مبلغ deductionAmount برای این SellerPayable؛ واحد پول در فیلد currency مشخص می‌شود.
  deductionAmount Decimal           @default(0) @db.Decimal(20, 2)
  /// مبلغ netAmount برای این SellerPayable؛ واحد پول در فیلد currency مشخص می‌شود.
  netAmount      Decimal            @db.Decimal(20, 2)
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status         SellerPayableStatus @default(PENDING)
  /// زمان eligible این SellerPayable را ثبت می‌کند.
  eligibleAt     DateTime?
  /// زمان پرداخت موفق.
  paidAt         DateTime?
  /// زمان ایجاد رکورد.
  createdAt      DateTime           @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt      DateTime           @updatedAt
  /// ارتباط Prisma با جدول SellerOrder (سفارش فروشنده): رکورد مرتبط مرتبط با SellerPayable؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  sellerOrder    SellerOrder        @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  /// ارتباط Prisma با جدول Company (شرکت): رکورد مرتبط مرتبط با SellerPayable؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  company        Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  /// ارتباط Prisma با جدول Settlement (تسویه): رکورد مرتبط مرتبط با SellerPayable؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  settlement     Settlement?        @relation(fields: [settlementId], references: [id], onDelete: SetNull)

  @@index([companyId, status, eligibleAt])
  @@index([settlementId])

}

/// پرونده تسویه مالی شرکت در یک دوره همراه با مبالغ و وضعیت تأیید/پرداخت.
model Settlement {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id               Int             @id @default(autoincrement())
  /// مقدار متنی settlementNumber برای توصیف یا شناسایی تسویه.
  settlementNumber String          @unique @db.VarChar(48)
  /// شناسه شرکت مرتبط با این تسویه؛ کلید خارجی به جدول Company است.
  companyId        Int
  /// کد سه‌حرفی ارز (ISO 4217) مبالغ این رکورد.
  currency         String          @db.VarChar(3)
  /// زمان مرتبط با periodStart در چرخه عمر تسویه.
  periodStart      DateTime
  /// زمان مرتبط با periodEnd در چرخه عمر تسویه.
  periodEnd        DateTime
  /// مبلغ grossAmount برای این تسویه؛ واحد پول در فیلد currency مشخص می‌شود.
  grossAmount      Decimal         @default(0) @db.Decimal(20, 2)
  /// مبلغ deductionAmount برای این تسویه؛ واحد پول در فیلد currency مشخص می‌شود.
  deductionAmount  Decimal         @default(0) @db.Decimal(20, 2)
  /// مبلغ netAmount برای این تسویه؛ واحد پول در فیلد currency مشخص می‌شود.
  netAmount        Decimal         @default(0) @db.Decimal(20, 2)
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status           SettlementStatus @default(REQUESTED)
  /// شناسه کاربر مرتبط با این تسویه؛ کلید خارجی به جدول User است.
  requestedByUserId Int
  /// زمان ثبت درخواست.
  requestedAt      DateTime        @default(now())
  /// زمان تأیید.
  approvedAt       DateTime?
  /// زمان پرداخت موفق.
  paidAt           DateTime?
  /// زمان ایجاد رکورد.
  createdAt        DateTime        @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt        DateTime        @updatedAt
  /// ارتباط Prisma با جدول Company (شرکت): رکورد مرتبط مرتبط با تسویه؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  company          Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  /// ارتباط Prisma با جدول User (کاربر): رکورد مرتبط مرتبط با تسویه؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  requestedBy      User            @relation("SettlementRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  /// ارتباط Prisma با جدول SellerPayable (SellerPayable): مجموعه رکوردهای وابسته مرتبط با تسویه؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  payables         SellerPayable[]
  /// ارتباط Prisma با جدول SettlementApproval (SettlementApproval): مجموعه رکوردهای وابسته مرتبط با تسویه؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  approvals        SettlementApproval[]
  /// ارتباط Prisma با جدول SettlementPayout (SettlementPayout): مجموعه رکوردهای وابسته مرتبط با تسویه؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  payouts          SettlementPayout[]

  @@index([companyId, status, createdAt])
  @@index([status, requestedAt])
  @@index([periodStart, periodEnd])

}

/// تصمیم تأیید/رد پرونده تسویه، تأییدکننده و زمان تصمیم.
model SettlementApproval {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id             Int        @id @default(autoincrement())
  /// شناسه تسویه مرتبط با این SettlementApproval؛ کلید خارجی به جدول Settlement است.
  settlementId   Int
  /// شناسه کاربر مرتبط با این SettlementApproval؛ کلید خارجی به جدول User است.
  approverUserId Int
  /// نتیجه تصمیم ثبت‌شده.
  decision       SettlementApprovalDecision
  /// علت درخواست، تغییر وضعیت یا تصمیم.
  reason         String?    @db.VarChar(1000)
  /// زمان decided این SettlementApproval را ثبت می‌کند.
  decidedAt      DateTime   @default(now())
  /// ارتباط Prisma با جدول Settlement (تسویه): رکورد مرتبط مرتبط با SettlementApproval؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  settlement     Settlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  /// ارتباط Prisma با جدول User (کاربر): رکورد مرتبط مرتبط با SettlementApproval؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  approver       User       @relation(fields: [approverUserId], references: [id], onDelete: Restrict)

  @@unique([settlementId, approverUserId])
  @@index([settlementId, decidedAt])
  @@index([approverUserId, decidedAt])

}

/// اجرای پرداخت یک تسویه به فروشنده و نتیجه آن.
model SettlementPayout {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id                Int         @id @default(autoincrement())
  /// شناسه تسویه مرتبط با این SettlementPayout؛ کلید خارجی به جدول Settlement است.
  settlementId      Int
  /// نام درگاه یا سرویس بیرونی انجام‌دهنده عملیات.
  provider           String?    @db.VarChar(80)
  /// شناسه مرجع عملیات نزد ارائه‌دهنده بیرونی.
  providerReference  String?    @unique @db.VarChar(200)
  /// مبلغ مالی این رکورد.
  amount             Decimal    @db.Decimal(20, 2)
  /// کد سه‌حرفی ارز (ISO 4217) مبالغ این رکورد.
  currency           String     @db.VarChar(3)
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status             PayoutStatus @default(PENDING)
  /// کلید یکتای جلوگیری از اجرای تکراری درخواست/عملیات.
  idempotencyKey     String     @unique @db.VarChar(160)
  /// شناسه کاربر مرتبط با این SettlementPayout؛ کلید خارجی به جدول User است.
  executedByUserId   Int?
  /// زمان executed این SettlementPayout را ثبت می‌کند.
  executedAt         DateTime?
  /// علت شکست عملیات.
  failureReason      String?
  /// زمان ایجاد رکورد.
  createdAt          DateTime   @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt          DateTime   @updatedAt
  /// ارتباط Prisma با جدول Settlement (تسویه): رکورد مرتبط مرتبط با SettlementPayout؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  settlement         Settlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  /// ارتباط Prisma با جدول User (کاربر): رکورد مرتبط مرتبط با SettlementPayout؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  executedBy         User?      @relation("PayoutExecutor", fields: [executedByUserId], references: [id], onDelete: SetNull)
  /// ارتباط Prisma با جدول ReconciliationRecord (ReconciliationRecord): مجموعه رکوردهای وابسته مرتبط با SettlementPayout؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  reconciliations    ReconciliationRecord[]

  @@index([settlementId, createdAt])
  @@index([status, createdAt])

}

/// تطبیق تراکنش یا پرداخت خروجی با گزارش ارائه‌دهنده مالی.
model ReconciliationRecord {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id                    BigInt             @id @default(autoincrement())
  /// نام درگاه یا سرویس بیرونی انجام‌دهنده عملیات.
  provider              String             @db.VarChar(80)
  /// شناسه مرجع رکورد در سامانه بیرونی.
  externalReference     String             @db.VarChar(240)
  /// مبلغ مالی این رکورد.
  amount                Decimal            @db.Decimal(20, 2)
  /// کد سه‌حرفی ارز (ISO 4217) مبالغ این رکورد.
  currency              String             @db.VarChar(3)
  /// پرچم منطقی matched برای کنترل رفتار ReconciliationRecord.
  matched                Boolean            @default(false)
  /// شناسه PaymentTransaction مرتبط با این ReconciliationRecord؛ کلید خارجی به جدول PaymentTransaction است.
  paymentTransactionId  Int?
  /// شناسه SettlementPayout مرتبط با این ReconciliationRecord؛ کلید خارجی به جدول SettlementPayout است.
  payoutId              Int?
  /// یادداشت‌های تکمیلی درباره رکورد.
  notes                 String?
  /// زمان reconciled این ReconciliationRecord را ثبت می‌کند.
  reconciledAt          DateTime            @default(now())
  /// ارتباط Prisma با جدول PaymentTransaction (PaymentTransaction): رکورد مرتبط مرتبط با ReconciliationRecord؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  paymentTransaction    PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id], onDelete: SetNull)
  /// ارتباط Prisma با جدول SettlementPayout (SettlementPayout): رکورد مرتبط مرتبط با ReconciliationRecord؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  payout                SettlementPayout?  @relation(fields: [payoutId], references: [id], onDelete: Restrict)

  @@unique([provider, externalReference])
  @@index([matched, reconciledAt])
  @@index([paymentTransactionId])
  @@index([payoutId])

}

/// سربرگ فاکتور مالی مرتبط با خریدار، شرکت یا سفارش.
model FinanceInvoice {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id                Int           @id @default(autoincrement())
  /// مقدار متنی invoiceNumber برای توصیف یا شناسایی FinanceInvoice.
  invoiceNumber     String        @unique @db.VarChar(48)
  /// شناسه شرکت مرتبط با این FinanceInvoice؛ کلید خارجی به جدول Company است.
  companyId         Int?
  /// شناسه کاربر مرتبط با این FinanceInvoice؛ کلید خارجی به جدول User است.
  buyerUserId       Int?
  /// شناسه سفارش مرتبط با این FinanceInvoice؛ کلید خارجی به جدول RetailOrder است.
  orderId           Int?
  /// شناسه سفارش فروشنده مرتبط با این FinanceInvoice؛ کلید خارجی به جدول SellerOrder است.
  sellerOrderId     Int?
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status            InvoiceStatus @default(DRAFT)
  /// کد سه‌حرفی ارز (ISO 4217) مبالغ این رکورد.
  currency          String        @db.VarChar(3)
  /// مبلغ subtotal برای این FinanceInvoice؛ واحد پول در فیلد currency مشخص می‌شود.
  subtotal          Decimal       @db.Decimal(20, 2)
  /// مبلغ taxTotal برای این FinanceInvoice؛ واحد پول در فیلد currency مشخص می‌شود.
  taxTotal          Decimal       @default(0) @db.Decimal(20, 2)
  /// مبلغ grandTotal برای این FinanceInvoice؛ واحد پول در فیلد currency مشخص می‌شود.
  grandTotal        Decimal       @db.Decimal(20, 2)
  /// زمان issued این FinanceInvoice را ثبت می‌کند.
  issuedAt          DateTime?
  /// زمان ایجاد رکورد.
  createdAt         DateTime      @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt         DateTime      @updatedAt
  /// ارتباط Prisma با جدول Company (شرکت): رکورد مرتبط مرتبط با FinanceInvoice؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  company           Company?      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  /// ارتباط Prisma با جدول User (کاربر): رکورد مرتبط مرتبط با FinanceInvoice؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  buyer             User?         @relation(fields: [buyerUserId], references: [id], onDelete: Restrict)
  /// ارتباط Prisma با جدول RetailOrder (سفارش): رکورد مرتبط مرتبط با FinanceInvoice؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  order             RetailOrder?  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// ارتباط Prisma با جدول SellerOrder (سفارش فروشنده): رکورد مرتبط مرتبط با FinanceInvoice؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  sellerOrder       SellerOrder?  @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  /// ارتباط Prisma با جدول FinanceInvoiceLine (FinanceInvoiceLine): مجموعه رکوردهای وابسته مرتبط با FinanceInvoice؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  lines             FinanceInvoiceLine[]

  @@index([companyId, createdAt])
  @@index([buyerUserId, createdAt])
  @@index([orderId])
  @@index([sellerOrderId])

}

/// ردیف جزئیات فاکتور شامل شرح، تعداد، قیمت، مالیات و جمع ردیف.
model FinanceInvoiceLine {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id          Int           @id @default(autoincrement())
  /// شناسه FinanceInvoice مرتبط با این FinanceInvoiceLine؛ کلید خارجی به جدول FinanceInvoice است.
  invoiceId   Int
  /// شرح تکمیلی موجودیت.
  description String        @db.VarChar(500)
  /// تعداد واحدهای کالا یا مقدار موردنظر.
  quantity    Decimal       @default(1) @db.Decimal(18, 4)
  /// مبلغ unitPrice برای این FinanceInvoiceLine؛ واحد پول در فیلد currency مشخص می‌شود.
  unitPrice   Decimal       @db.Decimal(20, 2)
  /// مبلغ taxAmount برای این FinanceInvoiceLine؛ واحد پول در فیلد currency مشخص می‌شود.
  taxAmount   Decimal       @default(0) @db.Decimal(20, 2)
  /// مبلغ lineTotal برای این FinanceInvoiceLine؛ واحد پول در فیلد currency مشخص می‌شود.
  lineTotal   Decimal       @db.Decimal(20, 2)
  /// ارتباط Prisma با جدول FinanceInvoice (FinanceInvoice): رکورد مرتبط مرتبط با FinanceInvoiceLine؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  invoice     FinanceInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])

}
