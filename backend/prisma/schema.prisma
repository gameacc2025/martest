  /// زمان ایجاد رکورد.
  createdAt         DateTime       @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt         DateTime       @updatedAt
  /// ارتباط Prisma با جدول SellerOrder (سفارش فروشنده): رکورد مرتبط مرتبط با Shipment؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  sellerOrder       SellerOrder    @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  /// ارتباط Prisma با جدول TrackingEvent (TrackingEvent): مجموعه رکوردهای وابسته مرتبط با Shipment؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  trackingEvents    TrackingEvent[]

  @@index([sellerOrderId, createdAt])
  @@index([trackingNumber])
  @@index([status, updatedAt])

}

/// رویدادهای رهگیری مرسوله شامل شرح، موقعیت و زمان وقوع.
model TrackingEvent {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id          BigInt        @id @default(autoincrement())
  /// شناسه Shipment مرتبط با این TrackingEvent؛ کلید خارجی به جدول Shipment است.
