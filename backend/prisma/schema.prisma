  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id                    Int                 @id @default(autoincrement())
  /// شماره یکتای قابل نمایش تیکت برای جست‌وجو، مکاتبه و ارجاع به پشتیبانی.
  ticketNumber          String              @unique @db.VarChar(32)
  /// شناسه کاربر مرتبط با این تیکت پشتیبانی؛ کلید خارجی به جدول User است.
  requesterUserId       Int
  /// شناسه شرکت مرتبط با این تیکت پشتیبانی؛ کلید خارجی به جدول Company است.
  requesterCompanyId    Int?
  /// شناسه SupportCategory مرتبط با این تیکت پشتیبانی؛ کلید خارجی به جدول SupportCategory است.
  categoryId            Int?
  /// شناسه SupportQueue مرتبط با این تیکت پشتیبانی؛ کلید خارجی به جدول SupportQueue است.
  assignedQueueId       Int?
  /// شناسه کاربر مرتبط با این تیکت پشتیبانی؛ کلید خارجی به جدول User است.
  assignedUserId        Int?
  /// کانال ایجاد تیکت.
  createdFrom           SupportCreatedFrom
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status                SupportTicketStatus @default(OPEN)
  /// اولویت رسیدگی یا پردازش.
  priority              SupportPriority     @default(NORMAL)
  /// موضوع پیام، تیکت یا فعالیت برای نمایش و جست‌وجو.
  subject               String              @db.VarChar(200)
  /// مهلت هدف اولین پاسخ طبق SLA.
  firstResponseDueAt    DateTime?
  /// مهلت هدف حل تیکت طبق SLA.
  resolveDueAt          DateTime?
  /// زمان اولین پاسخ کارشناسی به تیکت.
  firstRespondedAt      DateTime?
  /// زمان حل‌شدن تیکت.
  resolvedAt            DateTime?
  /// زمان بسته‌شدن پرونده یا فرآیند.
  closedAt              DateTime?
  /// زمان آخرین فعالیت ثبت‌شده روی تیکت.
  lastActivityAt        DateTime            @default(now())
  /// زمان ایجاد رکورد.
  createdAt             DateTime            @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt             DateTime            @updatedAt
  /// رابطه Prisma با جدول User (کاربر)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  requester             User                @relation("SupportRequester", fields: [requesterUserId], references: [id], onDelete: Restrict)
  /// رابطه Prisma با جدول Company (شرکت)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  requesterCompany      Company?            @relation(fields: [requesterCompanyId], references: [id], onDelete: Restrict)
  /// رابطه Prisma با جدول SupportCategory (SupportCategory)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  category              SupportCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// رابطه Prisma با جدول SupportQueue (SupportQueue)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  assignedQueue         SupportQueue?        @relation(fields: [assignedQueueId], references: [id], onDelete: SetNull)
  /// رابطه Prisma با جدول User (کاربر)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  assignedUser          User?               @relation("SupportCurrentAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  /// رابطه Prisma با جدول SupportMessage (SupportMessage)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  messages              SupportMessage[]
  /// رابطه Prisma با جدول SupportAssignment (SupportAssignment)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  assignments           SupportAssignment[]
  /// رابطه Prisma با جدول SupportStatusHistory (SupportStatusHistory)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  statusHistory         SupportStatusHistory[]
  /// رابطه Prisma با جدول SupportEvent (SupportEvent)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  events                SupportEvent[]

  @@index([requesterUserId, status, updatedAt])
  @@index([requesterCompanyId, status, updatedAt])
  @@index([assignedQueueId, status, priority, lastActivityAt])
  @@index([assignedUserId, status, priority])
  @@index([status, priority, firstResponseDueAt])
  @@index([status, resolveDueAt])
  @@index([categoryId])

}

/// پیام‌های تیکت پشتیبانی با مشخص بودن نویسنده و سطح مشاهده عمومی/داخلی.
model SupportMessage {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id          Int                       @id @default(autoincrement())
  /// شناسه تیکت پشتیبانی مرتبط با این SupportMessage؛ کلید خارجی به جدول SupportTicket است.
  ticketId    Int
  /// شناسه کاربر مرتبط با این SupportMessage؛ کلید خارجی به جدول User است.
  senderUserId Int
  /// سطح مشاهده و دسترسی به محتوا.
  visibility  SupportMessageVisibility  @default(PUBLIC)
  /// متن کامل پیام، یادداشت یا محتوای رکورد.
  body        String                    @db.VarChar(10000)
  /// زمان ایجاد رکورد.
  createdAt   DateTime                  @default(now())
  /// رابطه Prisma با جدول SupportTicket (تیکت پشتیبانی)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  ticket      SupportTicket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  /// رابطه Prisma با جدول User (کاربر)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  sender      User                      @relation(fields: [senderUserId], references: [id], onDelete: Restrict)
  /// رابطه Prisma با جدول SupportAttachment (SupportAttachment)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  attachments SupportAttachment[]

  @@index([ticketId, createdAt])
  @@index([senderUserId, createdAt])
  @@index([ticketId, visibility, createdAt])

}

/// فراداده فایل پیوست پیام پشتیبانی شامل مسیر ذخیره، نوع، اندازه و وضعیت بررسی.
model SupportAttachment {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id             Int                     @id @default(autoincrement())
  /// شناسه SupportMessage مرتبط با این SupportAttachment؛ کلید خارجی به جدول SupportMessage است.
  messageId      Int
  /// شناسه کاربر مرتبط با این SupportAttachment؛ کلید خارجی به جدول User است.
  uploadedByUserId Int
  /// کلید فایل در فضای ذخیره‌سازی؛ خود فایل در دیتابیس ذخیره نمی‌شود.
  storageKey     String                  @unique @db.VarChar(500)
  /// نام اصلی فایل پیش از ذخیره‌سازی.
  originalName   String                  @db.VarChar(255)
  /// نوع رسانه‌ای فایل (MIME type).
  mimeType       String                  @db.VarChar(150)
  /// اندازه فایل بر حسب بایت.
  sizeBytes      BigInt
  /// چکیده محتوای فایل برای بررسی یکپارچگی.
  checksum       String?                 @db.VarChar(128)
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status         SupportAttachmentStatus @default(PENDING_SCAN)
  /// زمان ایجاد رکورد.
  createdAt      DateTime                @default(now())
  /// رابطه Prisma با جدول SupportMessage (SupportMessage)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  message        SupportMessage          @relation(fields: [messageId], references: [id], onDelete: Cascade)
  /// رابطه Prisma با جدول User (کاربر)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  uploadedBy     User                    @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  @@index([messageId])
  @@index([uploadedByUserId, createdAt])
  @@index([status, createdAt])

}

/// تاریخچه ارجاع تیکت به صف یا کارشناس با زمان شروع و پایان تخصیص.
model SupportAssignment {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id                 Int          @id @default(autoincrement())
  /// شناسه تیکت پشتیبانی مرتبط با این SupportAssignment؛ کلید خارجی به جدول SupportTicket است.
  ticketId           Int
  /// شناسه SupportQueue مرتبط با این SupportAssignment؛ کلید خارجی به جدول SupportQueue است.
  queueId            Int?
  /// شناسه کاربر مرتبط با این SupportAssignment؛ کلید خارجی به جدول User است.
  assignedUserId     Int?
  /// شناسه کاربر مرتبط با این SupportAssignment؛ کلید خارجی به جدول User است.
  assignedByUserId   Int
  /// علت درخواست، تغییر وضعیت یا تصمیم.
  reason             String?      @db.VarChar(500)
  /// زمان شروع تخصیص این نقش یا مسئولیت.
  assignedAt         DateTime     @default(now())
  /// زمان ended این SupportAssignment را ثبت می‌کند.
  endedAt            DateTime?
  /// رابطه Prisma با جدول SupportTicket (تیکت پشتیبانی)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  ticket             SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  /// رابطه Prisma با جدول SupportQueue (SupportQueue)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  queue              SupportQueue? @relation(fields: [queueId], references: [id], onDelete: SetNull)
  /// رابطه Prisma با جدول User (کاربر)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  assignee           User?        @relation("SupportAssignmentAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  /// رابطه Prisma با جدول User (کاربر)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  assignedBy         User         @relation("SupportAssignmentActor", fields: [assignedByUserId], references: [id], onDelete: Restrict)

  @@index([ticketId, assignedAt])
  @@index([assignedUserId, endedAt])
  @@index([queueId, endedAt])

}

/// تاریخچه تغییر وضعیت تیکت همراه با عامل و دلیل تغییر.
model SupportStatusHistory {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id          Int                 @id @default(autoincrement())
  /// شناسه تیکت پشتیبانی مرتبط با این SupportStatusHistory؛ کلید خارجی به جدول SupportTicket است.
  ticketId    Int
  /// مقدار/وضعیت قبلی پیش از تغییر.
  previous    SupportTicketStatus?
  /// مقدار/وضعیت جدید پس از تغییر.
  next        SupportTicketStatus
  /// شناسه کاربر مرتبط با این SupportStatusHistory؛ کلید خارجی به جدول User است.
  actorUserId Int?
  /// علت درخواست، تغییر وضعیت یا تصمیم.
  reason      String?             @db.VarChar(1000)
  /// زمان ایجاد رکورد.
  createdAt   DateTime            @default(now())
  /// رابطه Prisma با جدول SupportTicket (تیکت پشتیبانی)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  ticket      SupportTicket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  /// رابطه Prisma با جدول User (کاربر)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  actor       User?               @relation("SupportStatusActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@index([actorUserId, createdAt])

}

/// رویدادهای دامنه پشتیبانی برای پردازش و جلوگیری از اجرای تکراری.
model SupportEvent {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id             BigInt    @id @default(autoincrement())
  /// شناسه تیکت پشتیبانی مرتبط با این SupportEvent؛ کلید خارجی به جدول SupportTicket است.
  ticketId       Int?
  /// شناسه کاربر مرتبط با این SupportEvent؛ کلید خارجی به جدول User است.
  actorUserId    Int?
  /// نوع رویداد ثبت‌شده.
  eventType      String    @db.VarChar(100)
  /// کلید تشخیص و جلوگیری از ثبت/پردازش تکراری رویداد.
  dedupeKey      String?   @unique @db.VarChar(160)
  /// بدنه ساختاریافته یا خام رویداد دریافتی/داخلی.
  payload        Json?
  /// زمان وقوع رویداد در منبع.
  occurredAt     DateTime  @default(now())
  /// زمان پایان پردازش رویداد/عملیات.
  processedAt    DateTime?
  /// رابطه Prisma با جدول SupportTicket (تیکت پشتیبانی)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  ticket         SupportTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  /// رابطه Prisma با جدول User (کاربر)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  actor          User?     @relation("SupportEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([ticketId, occurredAt])
  @@index([eventType, processedAt])

}

// ============================================================================
// DB-3 — Editorial CMS
// ============================================================================
enum ArticleStatus {
  DRAFT
  IN_REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum ArticleType {
  NEWS
  ARTICLE
  GUIDE
}

/// محتوای مقاله/مجله شامل متن، وضعیت انتشار، نویسنده، زمان‌بندی و فراداده SEO.
/// پرسش‌های متداول قابل انتشار در وب‌سایت و قابل مدیریت در پنل STAFF.
model Faq {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id        Int      @id @default(autoincrement())
  /// متن پرسش؛ برای جلوگیری از رکورد تکراری یکتا است.
  question  String   @unique @db.VarChar(500)
  /// پاسخ کامل پرسش متداول.
  answer    String   @db.Text
  /// دسته‌بندی نمایشی پرسش.
  category  String   @default("عمومی") @db.VarChar(100)
  /// ترتیب نمایش در دسته‌بندی.
  sortOrder Int      @default(0)
  /// فعال یا غیرفعال بودن برای نمایش عمومی.
  isActive  Boolean  @default(true)
  /// زمان ایجاد رکورد.
  createdAt DateTime @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt DateTime @updatedAt

  @@index([category, sortOrder])
  @@index([isActive])
}

/// صفحات ثابت و محتوای حقوقی/معرفی قابل مدیریت در CMS.
model Page {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id              Int      @id @default(autoincrement())
  /// شناسه متنی یکتا برای URL صفحه.
  slug            String   @unique @db.VarChar(100)
  /// عنوان قابل نمایش صفحه.
  title           String   @db.VarChar(240)
  /// محتوای صفحه.
  content         String   @db.Text
  /// قالب تفسیر محتوا.
  contentFormat   String   @default("HTML") @db.VarChar(20)
  /// عنوان SEO صفحه.
  metaTitle       String?  @db.VarChar(240)
  /// توضیح SEO صفحه.
  metaDescription String?  @db.VarChar(500)
  /// نشانی canonical صفحه.
  canonicalUrl    String?  @db.VarChar(500)
  /// اجازه ایندکس‌شدن صفحه توسط موتورهای جست‌وجو.
  isIndexable     Boolean  @default(true)
  /// فعال یا غیرفعال بودن صفحه.
  isActive        Boolean  @default(true)
  /// زمان ایجاد رکورد.
  createdAt       DateTime @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt       DateTime @updatedAt

  @@index([isActive])
}

model Article {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id               Int          @id @default(autoincrement())
  /// شناسه متنی خوانا و یکتای مناسب URL.
  slug             String       @unique @db.VarChar(220)
  /// عنوان اصلی قابل نمایش.
  title            String       @db.VarChar(240)
  /// چکیده کوتاه محتوا برای پیش‌نمایش.
  excerpt          String?      @db.VarChar(600)
  /// محتوای اصلی متن یا مقاله.
  content          String
  /// قالب یا نحوه تفسیر محتوای مقاله.
  contentFormat    String       @default("HTML") @db.VarChar(20)
  /// نوع یا طبقه‌بندی رکورد؛ مقادیر مجاز در Enum یا قرارداد دامنه تعریف شده‌اند.
  type             ArticleType  @default(ARTICLE)
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status           ArticleStatus @default(DRAFT)
  /// کلید فایل تصویر جلد مقاله در فضای ذخیره‌سازی.
  coverImageKey    String?      @db.VarChar(500)
  /// شناسه کاربر مرتبط با این مقاله؛ کلید خارجی به جدول User است.
  authorUserId     Int
  /// شناسه کاربر مرتبط با این مقاله؛ کلید خارجی به جدول User است.
  publishedByUserId Int?
  /// زمان انتشار عمومی محتوا.
  publishedAt      DateTime?
  /// زمان برنامه‌ریزی‌شده انتشار.
  scheduledAt      DateTime?
  /// عنوان SEO صفحه.
  metaTitle        String?      @db.VarChar(240)
  /// توضیح SEO صفحه.
  metaDescription  String?      @db.VarChar(500)
  /// نشانی canonical صفحه برای موتورهای جست‌وجو.
  canonicalUrl     String?      @db.VarChar(500)
  /// اجازه ایندکس‌شدن صفحه توسط موتورهای جست‌وجو.
  isIndexable      Boolean      @default(true)
  /// زمان ایجاد رکورد.
  createdAt        DateTime     @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt        DateTime     @updatedAt
  /// رابطه Prisma با جدول User (کاربر)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  author           User         @relation("ArticleAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  /// رابطه Prisma با جدول User (کاربر)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  publishedBy      User?        @relation("ArticlePublisher", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  /// رابطه Prisma با جدول ArticleCategoryAssignment (ArticleCategoryAssignment)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  categories       ArticleCategoryAssignment[]
  /// رابطه Prisma با جدول ArticleTagAssignment (ArticleTagAssignment)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  tags             ArticleTagAssignment[]
  /// رابطه Prisma با جدول ArticleRevision (ArticleRevision)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  revisions        ArticleRevision[]
  /// رابطه Prisma با جدول ArticleMedia (ArticleMedia)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  media            ArticleMedia[]

  @@index([status, publishedAt])
  @@index([type, status, publishedAt])
  @@index([authorUserId, updatedAt])
  @@index([scheduledAt])

}

/// دسته‌بندی مطالب مجله برای گروه‌بندی و فیلتر محتوا.
model ArticleCategory {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id        Int      @id @default(autoincrement())
  /// شناسه متنی خوانا و یکتای مناسب URL.
  slug      String   @unique @db.VarChar(120)
  /// نام قابل نمایش موجودیت.
  name      String   @db.VarChar(120)
  /// ترتیب نمایش رکورد در میان موارد هم‌گروه.
  sortOrder Int      @default(0)
  /// فعال یا غیرفعال بودن رکورد.
  isActive  Boolean  @default(true)
  /// زمان ایجاد رکورد.
  createdAt DateTime @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt DateTime @updatedAt
  /// رابطه Prisma با جدول ArticleCategoryAssignment (ArticleCategoryAssignment)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  articles  ArticleCategoryAssignment[]

  @@index([isActive, sortOrder])

}

/// برچسب‌های موضوعی مطالب برای جست‌وجو و ارتباط محتوایی.
model ArticleTag {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id        Int      @id @default(autoincrement())
  /// شناسه متنی خوانا و یکتای مناسب URL.
  slug      String   @unique @db.VarChar(120)
  /// نام قابل نمایش موجودیت.
  name      String   @db.VarChar(120)
  /// زمان ایجاد رکورد.
  createdAt DateTime @default(now())
  /// رابطه Prisma با جدول ArticleTagAssignment (ArticleTagAssignment)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  articles  ArticleTagAssignment[]

}

/// رابط مقاله و دسته‌بندی به همراه ترتیب نمایش مقاله در دسته.
model ArticleCategoryAssignment {
  /// شناسه مقاله مرتبط با این ArticleCategoryAssignment؛ کلید خارجی به جدول Article است.
  articleId  Int
  /// شناسه ArticleCategory مرتبط با این ArticleCategoryAssignment؛ کلید خارجی به جدول ArticleCategory است.
  categoryId Int
  /// ترتیب نمایش رکورد در میان موارد هم‌گروه.
  sortOrder  Int      @default(0)
  /// رابطه Prisma با جدول Article (مقاله)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  article    Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  /// رابطه Prisma با جدول ArticleCategory (ArticleCategory)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  category   ArticleCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([articleId, categoryId])
  @@index([categoryId, sortOrder])

}

/// رابط چندبه‌چند مقاله و برچسب.
model ArticleTagAssignment {
  /// شناسه مقاله مرتبط با این ArticleTagAssignment؛ کلید خارجی به جدول Article است.
  articleId Int
  /// شناسه ArticleTag مرتبط با این ArticleTagAssignment؛ کلید خارجی به جدول ArticleTag است.
  tagId     Int
  /// رابطه Prisma با جدول Article (مقاله)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  /// رابطه Prisma با جدول ArticleTag (ArticleTag)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  tag       ArticleTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])

}

/// نسخه‌های محتوای مقاله به‌صورت snapshot برای نگهداری سابقه ویرایش.
model ArticleRevision {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id           BigInt   @id @default(autoincrement())
  /// شناسه مقاله مرتبط با این ArticleRevision؛ کلید خارجی به جدول Article است.
  articleId    Int
  /// شناسه کاربر مرتبط با این ArticleRevision؛ کلید خارجی به جدول User است.
  editorUserId Int
  /// شماره ترتیبی نسخه مقاله.
  revisionNo   Int
  /// تصویر ثابت داده در زمان ثبت برای حفظ سابقه.
  snapshot     Json
  /// توضیحی که ویرایشگر برای تغییرات این نسخه مقاله ثبت کرده است.
  changeNote   String?  @db.VarChar(500)
  /// زمان ایجاد رکورد.
  createdAt    DateTime @default(now())
  /// رابطه Prisma با جدول Article (مقاله)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  article      Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  /// رابطه Prisma با جدول User (کاربر)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  editor       User     @relation(fields: [editorUserId], references: [id], onDelete: Restrict)

  @@unique([articleId, revisionNo])
  @@index([articleId, createdAt])
  @@index([editorUserId, createdAt])

}

/// فراداده رسانه‌های مقاله شامل کلید ذخیره‌سازی و مشخصات فایل.
model ArticleMedia {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id               Int      @id @default(autoincrement())
  /// شناسه مقاله مرتبط با این ArticleMedia؛ کلید خارجی به جدول Article است.
  articleId        Int
  /// شناسه کاربر مرتبط با این ArticleMedia؛ کلید خارجی به جدول User است.
  uploadedByUserId Int
  /// کلید فایل در فضای ذخیره‌سازی؛ خود فایل در دیتابیس ذخیره نمی‌شود.
  storageKey       String   @unique @db.VarChar(500)
  /// نام اصلی فایل پیش از ذخیره‌سازی.
  originalName     String   @db.VarChar(255)
  /// نوع رسانه‌ای فایل (MIME type).
  mimeType         String   @db.VarChar(150)
  /// اندازه فایل بر حسب بایت.
  sizeBytes        BigInt
  /// متن جایگزین تصویر برای دسترس‌پذیری و سئو.
  altText          String?  @db.VarChar(300)
  /// زمان ایجاد رکورد.
  createdAt        DateTime @default(now())
  /// رابطه Prisma با جدول Article (مقاله)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  article          Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  /// رابطه Prisma با جدول User (کاربر)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  uploadedBy       User     @relation("ArticleMediaUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  @@index([articleId, createdAt])
  @@index([uploadedByUserId])

}

// ============================================================================
// DB-4 — STAFF-only CRM
// ============================================================================
enum CRMAccountType {
  PROSPECT
  CUSTOMER
  PARTNER
}

enum CRMLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  DISQUALIFIED
  DUPLICATE
  LOST
}

enum CRMOpportunityStatus {
  OPEN
  WON
  LOST
  ON_HOLD
}

enum CRMActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
  OTHER
}

enum CRMTaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CRMTaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum CRMNoteVisibility {
  TEAM
  PRIVATE
}

/// پرونده حساب مشتری/سازمان در CRM و پیوند آن به شرکت یا کاربر موجود.
model CRMAccount {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id          Int            @id @default(autoincrement())
  /// نوع حساب CRM (شرکت یا شخص) را مشخص می‌کند.
  accountType CRMAccountType @default(PROSPECT)
  /// نام کامل/نمایشی این حساب یا سرنخ برای نمایش در CRM.
  displayName String         @db.VarChar(240)
  /// شناسه شرکت مرتبط با این CRMAccount؛ کلید خارجی به جدول Company است.
  companyId   Int?           @unique
  /// شناسه کاربر مرتبط با این CRMAccount؛ کلید خارجی به جدول User است.
  userId      Int?           @unique
  /// شناسه کاربر مرتبط با این CRMAccount؛ کلید خارجی به جدول User است.
  ownerUserId Int
  /// وضعیت چرخه عمر حساب در فرایند CRM.
  lifecycle   String         @default("ACTIVE") @db.VarChar(40)
  /// منبع ایجاد یا ثبت رکورد.
  source      String?        @db.VarChar(100)
  /// یادداشت‌های تکمیلی درباره رکورد.
  notes       String?
  /// زمان ایجاد رکورد.
  createdAt   DateTime       @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt   DateTime       @updatedAt
  /// رابطه Prisma با جدول Company (شرکت)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  company     Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  /// رابطه Prisma با جدول User (کاربر)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  user        User?          @relation("CRMAccountUser", fields: [userId], references: [id], onDelete: SetNull)
  /// رابطه Prisma با جدول User (کاربر)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  owner       User           @relation("CRMAccountOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  /// رابطه Prisma با جدول CRMContact (CRMContact)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  contacts    CRMContact[]
  /// رابطه Prisma با جدول Lead (سرنخ فروش)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  leads       Lead[]
  /// رابطه Prisma با جدول Opportunity (فرصت فروش)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  opportunities Opportunity[]
  /// رابطه Prisma با جدول CRMActivity (CRMActivity)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  activities  CRMActivity[]
  /// رابطه Prisma با جدول CRMTask (CRMTask)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  tasks       CRMTask[]
  /// رابطه Prisma با جدول CRMNote (CRMNote)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  notesLog    CRMNote[]

  @@index([ownerUserId, updatedAt])
  @@index([accountType, lifecycle])
  @@index([displayName])

}

/// اشخاص رابط یک حساب CRM و اطلاعات تماس آن‌ها.
model CRMContact {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id          Int       @id @default(autoincrement())
  /// شناسه CRMAccount مرتبط با این CRMContact؛ کلید خارجی به جدول CRMAccount است.
  accountId   Int
  /// شناسه کاربر مرتبط با این CRMContact؛ کلید خارجی به جدول User است.
  userId      Int?
  /// نام قابل نمایش موجودیت.
  name        String    @db.VarChar(200)
  /// عنوان اصلی قابل نمایش.
  title       String?   @db.VarChar(120)
  /// نشانی ایمیل مرتبط.
  email       String?   @db.VarChar(320)
  /// شماره تماس مرتبط.
  phone       String?   @db.VarChar(40)
  /// اصلی بودن این مورد در میان موارد مرتبط.
  isPrimary   Boolean   @default(false)
  /// یادداشت‌های تکمیلی درباره رکورد.
  notes       String?
  /// زمان ایجاد رکورد.
  createdAt   DateTime  @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt   DateTime  @updatedAt
  /// رابطه Prisma با جدول CRMAccount (CRMAccount)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  account     CRMAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// رابطه Prisma با جدول User (کاربر)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([accountId, isPrimary])
  @@index([email])
  @@index([phone])

}

/// منابع ورود سرنخ‌های فروش به شکل کد و عنوان قابل مدیریت.
model LeadSource {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id        Int      @id @default(autoincrement())
  /// کد ماشینی یا تجاری این موجودیت.
  code      String   @unique @db.VarChar(60)
  /// برچسب یا عنوان کوتاه قابل نمایش.
  label     String   @db.VarChar(120)
  /// فعال یا غیرفعال بودن رکورد.
  isActive  Boolean  @default(true)
  /// ترتیب نمایش رکورد در میان موارد هم‌گروه.
  sortOrder Int      @default(0)
  /// زمان ایجاد رکورد.
  createdAt DateTime @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt DateTime @updatedAt
  /// رابطه Prisma با جدول Lead (سرنخ فروش)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  leads     Lead[]

  @@index([isActive, sortOrder])

}

/// سرنخ بالقوه فروش تا زمان تبدیل یا رد، شامل منبع، امتیاز و مسئول پیگیری.
model Lead {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id                 Int           @id @default(autoincrement())
  /// شماره یکتای قابل نمایش سرنخ فروش برای پیگیری در CRM.
  leadNumber         String        @unique @db.VarChar(32)
  /// نام کامل/نمایشی این حساب یا سرنخ برای نمایش در CRM.
  displayName        String        @db.VarChar(240)
  /// نام شرکت مرتبط با سرنخ.
  companyName        String?       @db.VarChar(240)
  /// نشانی ایمیل مرتبط.
  email              String?       @db.VarChar(320)
  /// شماره تماس مرتبط.
  phone              String?       @db.VarChar(40)
  /// شناسه LeadSource مرتبط با این سرنخ فروش؛ کلید خارجی به جدول LeadSource است.
  sourceId           Int?
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status             CRMLeadStatus @default(NEW)
  /// امتیاز عددی سرنخ برای اولویت‌بندی و ارزیابی احتمال تبدیل آن به مشتری.
  score              Int           @default(0)
  /// شناسه کاربر مرتبط با این سرنخ فروش؛ کلید خارجی به جدول User است.
  ownerUserId        Int
  /// شناسه CRMAccount مرتبط با این سرنخ فروش؛ کلید خارجی به جدول CRMAccount است.
  convertedAccountId Int?
  /// شناسه کاربر مرتبط با این سرنخ فروش؛ کلید خارجی به جدول User است.
  convertedByUserId  Int?
  /// زمان converted این سرنخ فروش را ثبت می‌کند.
  convertedAt        DateTime?
  /// دلیل رد صلاحیت یا خارج‌کردن سرنخ از چرخه پیگیری فروش.
  disqualifiedReason String?       @db.VarChar(500)
  /// زمان ایجاد رکورد.
  createdAt          DateTime      @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt          DateTime      @updatedAt
  /// رابطه Prisma با جدول LeadSource (LeadSource)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  source             LeadSource?   @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  /// رابطه Prisma با جدول User (کاربر)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  owner              User          @relation("CRMLeadOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  /// رابطه Prisma با جدول CRMAccount (CRMAccount)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  convertedAccount   CRMAccount?   @relation(fields: [convertedAccountId], references: [id], onDelete: SetNull)
  /// رابطه Prisma با جدول User (کاربر)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  convertedBy        User?         @relation("CRMLeadConverter", fields: [convertedByUserId], references: [id], onDelete: SetNull)
  /// رابطه Prisma با جدول CRMActivity (CRMActivity)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  activities         CRMActivity[]
  /// رابطه Prisma با جدول CRMTask (CRMTask)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  tasks              CRMTask[]
  /// رابطه Prisma با جدول CRMNote (CRMNote)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  notesLog           CRMNote[]

  @@index([ownerUserId, status, updatedAt])
  @@index([sourceId, createdAt])
  @@index([status, score])
  @@index([phone])
  @@index([email])

}

/// تعریف قیف فروش CRM و تعیین قیف فعال یا پیش‌فرض.
model Pipeline {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id        Int             @id @default(autoincrement())
  /// نام قابل نمایش موجودیت.
  name      String          @db.VarChar(120)
  /// پیش‌فرض بودن این گزینه یا رکورد.
  isDefault Boolean         @default(false)
  /// فعال یا غیرفعال بودن رکورد.
  isActive  Boolean         @default(true)
  /// زمان ایجاد رکورد.
  createdAt DateTime        @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt DateTime        @updatedAt
  /// رابطه Prisma با جدول PipelineStage (PipelineStage)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  stages    PipelineStage[]
  /// رابطه Prisma با جدول Opportunity (فرصت فروش)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  opportunities Opportunity[]

  @@index([isActive, isDefault])

}

/// مراحل هر قیف فروش با ترتیب و احتمال موفقیت و نشانگر برد/باخت.
model PipelineStage {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id             Int          @id @default(autoincrement())
  /// شناسه Pipeline مرتبط با این PipelineStage؛ کلید خارجی به جدول Pipeline است.
  pipelineId     Int
  /// کد ماشینی یا تجاری این موجودیت.
  code           String       @db.VarChar(60)
  /// برچسب یا عنوان کوتاه قابل نمایش.
  label          String       @db.VarChar(120)
  /// ترتیب نمایش رکورد در میان موارد هم‌گروه.
  sortOrder      Int          @default(0)
  /// احتمال موفقیت فرصت در این مرحله به‌صورت درصد.
  probability    Int          @default(0)
  /// نشانگر مرحله موفق/برد قیف فروش.
  isWon          Boolean      @default(false)
  /// نشانگر مرحله از دست‌رفته قیف فروش.
  isLost         Boolean      @default(false)
  /// رابطه Prisma با جدول Pipeline (Pipeline)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  pipeline       Pipeline     @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  /// رابطه Prisma با جدول Opportunity (فرصت فروش)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  opportunities  Opportunity[]
  /// رابطه Prisma با جدول OpportunityStageHistory (OpportunityStageHistory)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  fromHistories  OpportunityStageHistory[] @relation("OpportunityFromStage")
  /// رابطه Prisma با جدول OpportunityStageHistory (OpportunityStageHistory)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  toHistories    OpportunityStageHistory[] @relation("OpportunityToStage")

  @@unique([pipelineId, code])
  @@unique([pipelineId, sortOrder])
  @@unique([id, pipelineId])
  @@index([pipelineId, isWon, isLost])

}

/// فرصت فروش مرتبط با حساب CRM، مبلغ، ارز، مرحله و مسئول آن.
model Opportunity {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id                Int                  @id @default(autoincrement())
  /// شماره یکتای قابل نمایش فرصت فروش.
  opportunityNumber String               @unique @db.VarChar(32)
  /// شناسه CRMAccount مرتبط با این فرصت فروش؛ کلید خارجی به جدول CRMAccount است.
  accountId         Int
  /// شناسه PipelineStage مرتبط با این فرصت فروش؛ کلید خارجی به جدول PipelineStage است.
  pipelineId        Int
  /// شناسه PipelineStage مرتبط با این فرصت فروش؛ کلید خارجی به جدول PipelineStage است.
  stageId           Int
  /// شناسه کاربر مرتبط با این فرصت فروش؛ کلید خارجی به جدول User است.
  ownerUserId       Int
  /// عنوان اصلی قابل نمایش.
  title             String               @db.VarChar(240)
  /// مبلغ مالی این رکورد.
  amount            Decimal              @default(0) @db.Decimal(20, 2)
  /// کد سه‌حرفی ارز (ISO 4217) مبالغ این رکورد.
  currency          String               @default("IRR") @db.VarChar(3)
  /// تاریخ پیش‌بینی‌شده نهایی‌شدن فرصت فروش.
  expectedCloseAt   DateTime?
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status            CRMOpportunityStatus @default(OPEN)
  /// زمان بسته‌شدن پرونده یا فرآیند.
  closedAt          DateTime?
  /// زمان ایجاد رکورد.
  createdAt         DateTime             @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt         DateTime             @updatedAt
  /// رابطه Prisma با جدول CRMAccount (CRMAccount)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  account           CRMAccount           @relation(fields: [accountId], references: [id], onDelete: Restrict)
  /// رابطه Prisma با جدول Pipeline (Pipeline)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  pipeline          Pipeline             @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  /// رابطه Prisma با جدول PipelineStage (PipelineStage)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  stage             PipelineStage        @relation(fields: [stageId, pipelineId], references: [id, pipelineId], onDelete: Restrict)
  /// رابطه Prisma با جدول User (کاربر)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  owner             User                 @relation("OpportunityOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  /// رابطه Prisma با جدول OpportunityStageHistory (OpportunityStageHistory)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  stageHistory      OpportunityStageHistory[]
  /// رابطه Prisma با جدول CRMActivity (CRMActivity)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  activities        CRMActivity[]
  /// رابطه Prisma با جدول CRMTask (CRMTask)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  tasks             CRMTask[]
  /// رابطه Prisma با جدول CRMNote (CRMNote)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  notesLog          CRMNote[]

  @@index([accountId, status])
  @@index([ownerUserId, status, expectedCloseAt])
  @@index([pipelineId, stageId])
  @@index([status, expectedCloseAt])

}

/// تاریخچه جابه‌جایی فرصت فروش میان مراحل قیف.
model OpportunityStageHistory {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id            Int          @id @default(autoincrement())
  /// شناسه فرصت فروش مرتبط با این OpportunityStageHistory؛ کلید خارجی به جدول Opportunity است.
  opportunityId Int
  /// شناسه PipelineStage مرتبط با این OpportunityStageHistory؛ کلید خارجی به جدول PipelineStage است.
  fromStageId   Int?
  /// شناسه PipelineStage مرتبط با این OpportunityStageHistory؛ کلید خارجی به جدول PipelineStage است.
  toStageId     Int
  /// شناسه کاربر مرتبط با این OpportunityStageHistory؛ کلید خارجی به جدول User است.
  actorUserId   Int
  /// علت درخواست، تغییر وضعیت یا تصمیم.
  reason        String?      @db.VarChar(500)
  /// زمان ایجاد رکورد.
  createdAt     DateTime     @default(now())
  /// رابطه Prisma با جدول Opportunity (فرصت فروش)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  opportunity   Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  /// رابطه Prisma با جدول PipelineStage (PipelineStage)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  fromStage     PipelineStage? @relation("OpportunityFromStage", fields: [fromStageId], references: [id], onDelete: SetNull)
  /// رابطه Prisma با جدول PipelineStage (PipelineStage)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  toStage       PipelineStage @relation("OpportunityToStage", fields: [toStageId], references: [id], onDelete: Restrict)
  /// رابطه Prisma با جدول User (کاربر)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  actor         User         @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([opportunityId, createdAt])
  @@index([actorUserId, createdAt])

}

/// فعالیت‌های ارتباطی و فروش مانند تماس، جلسه یا پیگیری و نتیجه آن.
model CRMActivity {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id             BigInt          @id @default(autoincrement())
  /// نوع یا طبقه‌بندی رکورد؛ مقادیر مجاز در Enum یا قرارداد دامنه تعریف شده‌اند.
  type           CRMActivityType
  /// موضوع پیام، تیکت یا فعالیت برای نمایش و جست‌وجو.
  subject        String          @db.VarChar(240)
  /// متن کامل پیام، یادداشت یا محتوای رکورد.
  body           String?
  /// زمان وقوع رویداد در منبع.
  occurredAt     DateTime        @default(now())
  /// مدت فعالیت بر حسب دقیقه.
  durationMinutes Int?
  /// نتیجه فعالیت یا عملیات.
  outcome        String?         @db.VarChar(500)
  /// شناسه کاربر مرتبط با این CRMActivity؛ کلید خارجی به جدول User است.
  actorUserId    Int
  /// شناسه CRMAccount مرتبط با این CRMActivity؛ کلید خارجی به جدول CRMAccount است.
  accountId      Int?
  /// شناسه سرنخ فروش مرتبط با این CRMActivity؛ کلید خارجی به جدول Lead است.
  leadId         Int?
  /// شناسه فرصت فروش مرتبط با این CRMActivity؛ کلید خارجی به جدول Opportunity است.
  opportunityId  Int?
  /// زمان ایجاد رکورد.
  createdAt      DateTime        @default(now())
  /// رابطه Prisma با جدول User (کاربر)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  actor          User            @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  /// رابطه Prisma با جدول CRMAccount (CRMAccount)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  account        CRMAccount?     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// رابطه Prisma با جدول Lead (سرنخ فروش)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  lead           Lead?           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  /// رابطه Prisma با جدول Opportunity (فرصت فروش)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  opportunity    Opportunity?    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([accountId, occurredAt])
  @@index([leadId, occurredAt])
  @@index([opportunityId, occurredAt])
  @@index([actorUserId, occurredAt])

}

/// وظایف پیگیری CRM با مسئول، اولویت، وضعیت و مهلت انجام.
model CRMTask {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id             Int            @id @default(autoincrement())
  /// عنوان اصلی قابل نمایش.
  title          String         @db.VarChar(240)
  /// شرح تکمیلی موجودیت.
  description    String?
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status         CRMTaskStatus  @default(OPEN)
  /// اولویت رسیدگی یا پردازش.
  priority       CRMTaskPriority @default(NORMAL)
  /// شناسه کاربر مرتبط با این CRMTask؛ کلید خارجی به جدول User است.
  assigneeUserId Int
  /// شناسه کاربر مرتبط با این CRMTask؛ کلید خارجی به جدول User است.
  createdByUserId Int
  /// مهلت انجام یا سررسید عملیات.
  dueAt          DateTime?
  /// زمان تکمیل عملیات.
  completedAt    DateTime?
  /// شناسه CRMAccount مرتبط با این CRMTask؛ کلید خارجی به جدول CRMAccount است.
  accountId      Int?
  /// شناسه سرنخ فروش مرتبط با این CRMTask؛ کلید خارجی به جدول Lead است.
  leadId         Int?
  /// شناسه فرصت فروش مرتبط با این CRMTask؛ کلید خارجی به جدول Opportunity است.
  opportunityId  Int?
  /// زمان ایجاد رکورد.
  createdAt      DateTime       @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt      DateTime       @updatedAt
  /// رابطه Prisma با جدول User (کاربر)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  assignee       User           @relation("CRMTaskAssignee", fields: [assigneeUserId], references: [id], onDelete: Restrict)
  /// رابطه Prisma با جدول User (کاربر)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  createdBy      User           @relation("CRMTaskCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  /// رابطه Prisma با جدول CRMAccount (CRMAccount)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  account        CRMAccount?    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// رابطه Prisma با جدول Lead (سرنخ فروش)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  lead           Lead?          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  /// رابطه Prisma با جدول Opportunity (فرصت فروش)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  opportunity    Opportunity?   @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([assigneeUserId, status, dueAt])
  @@index([createdByUserId, createdAt])
  @@index([accountId, status])
  @@index([leadId, status])
  @@index([opportunityId, status])

}

/// یادداشت‌های مرتبط با حساب، سرنخ یا فرصت همراه با سطح مشاهده.
model CRMNote {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id             BigInt            @id @default(autoincrement())
  /// متن کامل پیام، یادداشت یا محتوای رکورد.
  body           String
  /// سطح مشاهده و دسترسی به محتوا.
  visibility     CRMNoteVisibility @default(TEAM)
  /// شناسه کاربر مرتبط با این CRMNote؛ کلید خارجی به جدول User است.
  authorUserId   Int
  /// شناسه CRMAccount مرتبط با این CRMNote؛ کلید خارجی به جدول CRMAccount است.
  accountId      Int?
  /// شناسه سرنخ فروش مرتبط با این CRMNote؛ کلید خارجی به جدول Lead است.
  leadId         Int?
  /// شناسه فرصت فروش مرتبط با این CRMNote؛ کلید خارجی به جدول Opportunity است.
  opportunityId  Int?
  /// زمان ایجاد رکورد.
  createdAt      DateTime          @default(now())
  /// رابطه Prisma با جدول User (کاربر)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  author         User              @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  /// رابطه Prisma با جدول CRMAccount (CRMAccount)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  account        CRMAccount?       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// رابطه Prisma با جدول Lead (سرنخ فروش)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  lead           Lead?             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  /// رابطه Prisma با جدول Opportunity (فرصت فروش)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  opportunity    Opportunity?      @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@index([leadId, createdAt])
  @@index([opportunityId, createdAt])
  @@index([authorUserId, createdAt])

}

