/// مانده فعلی موجودی هر محصول شامل تعداد موجود و تعداد رزروشده.
model InventoryBalance {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id        Int      @id @default(autoincrement())
  /// شناسه محصول مرتبط با این InventoryBalance؛ کلید خارجی به جدول Product است.
  productId Int      @unique
  /// تعداد فیزیکی موجود محصول در انبار.
  onHand    Int      @default(0)
  /// تعداد موجودی که برای سفارش‌ها رزرو شده و فعلاً قابل فروش مجدد نیست.
  reserved  Int      @default(0)
  /// زمان ایجاد رکورد.
  createdAt DateTime @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt DateTime @updatedAt
  /// رابطه Prisma با جدول Product (محصول)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

}

/// دفتر تغییرات موجودی شامل نوع حرکت، تعداد، مرجع و عامل عملیات.
model InventoryMovement {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id             BigInt                @id @default(autoincrement())
  /// شناسه محصول مرتبط با این InventoryMovement؛ کلید خارجی به جدول Product است.
  productId      Int
  /// شناسه کاربر مرتبط با این InventoryMovement؛ کلید خارجی به جدول User است.
  actorUserId    Int?
  /// نوع حرکت یا رویداد تغییر موجودی.
  movementType   InventoryMovementType
  /// میزان تغییر موجودی؛ علامت مثبت افزایش و علامت منفی کاهش موجودی را نشان می‌دهد.
  quantityDelta  Int
  /// نوع موجودیت مرجع عملیات.
  referenceType  String?               @db.VarChar(60)
  /// شناسه موجودیت مرجع عملیات.
  referenceId    String?               @db.VarChar(100)
  /// کلید یکتای جلوگیری از اجرای تکراری درخواست/عملیات.
  idempotencyKey String?               @unique @db.VarChar(160)
  /// علت درخواست، تغییر وضعیت یا تصمیم.
  reason         String?               @db.VarChar(500)
  /// داده‌های تکمیلی ساختاریافته و وابسته به دامنه در قالب JSON.
  metadata       Json?
  /// زمان ایجاد رکورد.
  createdAt      DateTime              @default(now())
  /// رابطه Prisma با جدول Product (محصول)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  product        Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// رابطه Prisma با جدول User (کاربر)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  actor          User?                 @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
  @@index([movementType, createdAt])
  @@index([referenceType, referenceId])
  @@index([actorUserId, createdAt])

}

/// سفارش اصلی خریدار، وضعیت سفارش و پرداخت، مبالغ، ارز و snapshot نشانی گیرنده.
model RetailOrder {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id                    Int                @id @default(autoincrement())
  /// شماره یکتای قابل نمایش سفارش اصلی خریدار.
  orderNumber           String             @unique @db.VarChar(40)
  /// شناسه کاربر مرتبط با این سفارش؛ کلید خارجی به جدول User است.
  buyerUserId           Int
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status                RetailOrderStatus  @default(PENDING_PAYMENT)
  /// وضعیت پرداخت سفارش، مستقل از وضعیت پردازش/ارسال سفارش.
  paymentStatus         RetailPaymentStatus @default(UNPAID)
  /// کد سه‌حرفی ارز (ISO 4217) مبالغ این رکورد.
  currency              String             @db.VarChar(3)
  /// جمع مبالغ پیش از تخفیف/مالیات/هزینه‌های افزوده.
  subtotal              Decimal            @default(0) @db.Decimal(20, 2)
  /// جمع تخفیف‌های سفارش.
  discountTotal         Decimal            @default(0) @db.Decimal(20, 2)
  /// جمع هزینه ارسال سفارش.
  shippingTotal         Decimal            @default(0) @db.Decimal(20, 2)
  /// جمع مالیات سفارش یا فاکتور.
  taxTotal              Decimal            @default(0) @db.Decimal(20, 2)
  /// مبلغ نهایی قابل پرداخت پس از اعمال اجزا و تعدیلات.
  grandTotal            Decimal            @default(0) @db.Decimal(20, 2)
  /// شناسه نشانی مرتبط با این سفارش؛ کلید خارجی به جدول Address است.
  addressId             Int?
  /// رابطه Prisma با جدول Address (نشانی)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  address               Address?           @relation(fields: [addressId], references: [id], onDelete: SetNull)
  /// نام شخص دریافت‌کننده.
  recipientName         String             @db.VarChar(200)
  /// شماره تماس شخص دریافت‌کننده.
  recipientPhone        String             @db.VarChar(40)
  /// استان نشانی.
  province              String             @db.VarChar(120)
  /// شهر نشانی.
  city                  String             @db.VarChar(120)
  /// جزئیات نشانی پستی.
  addressLine           String             @db.VarChar(1000)
  /// کد پستی.
  postalCode            String?            @db.VarChar(30)
  /// کلید یکتای جلوگیری از اجرای تکراری درخواست/عملیات.
  idempotencyKey        String             @unique @db.VarChar(160)
  /// زمان placed این سفارش را ثبت می‌کند.
  placedAt              DateTime           @default(now())
  /// زمان پرداخت موفق.
  paidAt                DateTime?
  /// زمان تکمیل عملیات.
  completedAt            DateTime?
  /// زمان cancelled این سفارش را ثبت می‌کند.
  cancelledAt            DateTime?
  /// زمان ایجاد رکورد.
  createdAt             DateTime           @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt             DateTime           @updatedAt
  /// رابطه Prisma با جدول User (کاربر)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  buyer                 User               @relation(fields: [buyerUserId], references: [id], onDelete: Restrict)
  /// رابطه Prisma با جدول RetailOrderItem (RetailOrderItem)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  items                 RetailOrderItem[]
  /// رابطه Prisma با جدول SellerOrder (سفارش فروشنده)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  sellerOrders          SellerOrder[]
  /// رابطه Prisma با جدول PaymentAttempt (PaymentAttempt)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  paymentAttempts       PaymentAttempt[]
  /// رابطه Prisma با جدول PaymentTransaction (PaymentTransaction)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  paymentTransactions   PaymentTransaction[]
  /// رابطه Prisma با جدول RetailRefund (RetailRefund)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  refunds               RetailRefund[]
  /// رابطه Prisma با جدول InventoryReservation (InventoryReservation)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  reservations          InventoryReservation[]
  /// رابطه Prisma با جدول ReturnRequest (ReturnRequest)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  returns               ReturnRequest[]
  /// رابطه Prisma با جدول FinanceInvoice (FinanceInvoice)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  invoices              FinanceInvoice[]

  @@index([buyerUserId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])

}

/// بخش سفارش متعلق به یک فروشنده از سفارش اصلی، همراه با وضعیت و مبالغ فروشنده.
model SellerOrder {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id                 Int              @id @default(autoincrement())
  /// شناسه سفارش مرتبط با این سفارش فروشنده؛ کلید خارجی به جدول RetailOrder است.
  orderId            Int
  /// شناسه شرکت مرتبط با این سفارش فروشنده؛ کلید خارجی به جدول Company است.
  companyId           Int
  /// شماره یکتای قابل نمایش بخش سفارش متعلق به یک فروشنده.
  sellerOrderNumber   String           @unique @db.VarChar(48)
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status              SellerOrderStatus @default(PENDING_ACCEPTANCE)
  /// کد سه‌حرفی ارز (ISO 4217) مبالغ این رکورد.
  currency            String           @db.VarChar(3)
  /// جمع مبالغ پیش از تخفیف/مالیات/هزینه‌های افزوده.
  subtotal            Decimal          @default(0) @db.Decimal(20, 2)
  /// جمع تخفیف‌های سفارش.
  discountTotal       Decimal          @default(0) @db.Decimal(20, 2)
  /// جمع هزینه ارسال سفارش.
  shippingTotal       Decimal          @default(0) @db.Decimal(20, 2)
  /// جمع مالیات سفارش یا فاکتور.
  taxTotal            Decimal          @default(0) @db.Decimal(20, 2)
  /// مبلغ خالص قابل پرداخت به فروشنده برای این سفارش.
  sellerNetTotal      Decimal          @default(0) @db.Decimal(20, 2)
  /// نام شرکت در زمان ثبت سفارش؛ snapshot تاریخی و مستقل از تغییر نام بعدی شرکت.
  companyNameSnapshot String           @db.VarChar(240)
  /// شناسه ثبتی/نمایشی شرکت در زمان ثبت سفارش؛ snapshot تاریخی فروشنده.
  companyIdSnapshot   String?          @db.VarChar(80)
  /// زمان accepted این سفارش فروشنده را ثبت می‌کند.
  acceptedAt          DateTime?
  /// زمان shipped این سفارش فروشنده را ثبت می‌کند.
  shippedAt           DateTime?
  /// زمان delivered این سفارش فروشنده را ثبت می‌کند.
  deliveredAt         DateTime?
  /// زمان ایجاد رکورد.
  createdAt           DateTime         @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt           DateTime         @updatedAt
  /// رابطه Prisma با جدول RetailOrder (سفارش)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  order               RetailOrder      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// رابطه Prisma با جدول Company (شرکت)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  company             Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  /// رابطه Prisma با جدول RetailOrderItem (RetailOrderItem)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  items               RetailOrderItem[]
  /// رابطه Prisma با جدول Shipment (Shipment)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  shipments           Shipment[]
  /// رابطه Prisma با جدول ReturnRequest (ReturnRequest)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  returns             ReturnRequest[]
  /// رابطه Prisma با جدول RetailRefund (RetailRefund)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  refunds             RetailRefund[]
  /// رابطه Prisma با جدول CommissionSnapshot (CommissionSnapshot)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  commissionSnapshot  CommissionSnapshot?
  /// رابطه Prisma با جدول SellerPayable (SellerPayable)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  sellerPayable       SellerPayable?
  /// رابطه Prisma با جدول FinanceInvoice (FinanceInvoice)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  invoices            FinanceInvoice[]

  @@unique([orderId, companyId])
  @@unique([id, orderId])
  @@index([companyId, status, createdAt])
  @@index([orderId, status])

}

/// اقلام سفارش با snapshot محصول/فروشنده، تعداد، قیمت، تخفیف و مالیات.
model RetailOrderItem {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id                    Int         @id @default(autoincrement())
  /// شناسه سفارش فروشنده مرتبط با این RetailOrderItem؛ کلید خارجی به جدول SellerOrder است.
  orderId               Int
  /// شناسه سفارش فروشنده مرتبط با این RetailOrderItem؛ کلید خارجی به جدول SellerOrder است.
  sellerOrderId         Int
  /// شناسه محصول مرتبط با این RetailOrderItem؛ کلید خارجی به جدول Product است.
  productId             Int?
  /// عنوان محصول در زمان ثبت سفارش.
  productTitleSnapshot  String      @db.VarChar(240)
  /// کد SKU محصول در زمان ثبت سفارش.
  skuSnapshot           String?     @db.VarChar(120)
  /// نام برند محصول در زمان ثبت سفارش.
  brandSnapshot         String?     @db.VarChar(160)
  /// مدل محصول در زمان ثبت سفارش.
  modelSnapshot         String?     @db.VarChar(160)
  /// نشانی تصویر محصول در زمان ثبت سفارش.
  imageUrlSnapshot      String?     @db.VarChar(1000)
  /// نام شرکت در زمان ثبت سفارش؛ snapshot تاریخی و مستقل از تغییر نام بعدی شرکت.
  companyNameSnapshot   String      @db.VarChar(240)
  /// تعداد واحدهای کالا یا مقدار موردنظر.
  quantity              Int
  /// قیمت هر واحد کالا یا خدمت در این ردیف.
  unitPrice             Decimal     @db.Decimal(20, 2)
  /// مبلغ تخفیف اعمال‌شده روی این ردیف.
  discountAmount        Decimal     @default(0) @db.Decimal(20, 2)
  /// مبلغ مالیات محاسبه‌شده برای این ردیف.
  taxAmount             Decimal     @default(0) @db.Decimal(20, 2)
  /// مبلغ نهایی این ردیف پس از تخفیف و مالیات.
  lineTotal             Decimal     @db.Decimal(20, 2)
  /// کد سه‌حرفی ارز (ISO 4217) مبالغ این رکورد.
  currency              String      @db.VarChar(3)
  /// زمان ایجاد رکورد.
  createdAt             DateTime    @default(now())
  /// رابطه Prisma با جدول RetailOrder (سفارش)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  order                 RetailOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// رابطه Prisma با جدول SellerOrder (سفارش فروشنده)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  sellerOrder           SellerOrder @relation(fields: [sellerOrderId, orderId], references: [id, orderId], onDelete: Restrict)
  /// رابطه Prisma با جدول Product (محصول)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  product               Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// رابطه Prisma با جدول ReturnItem (ReturnItem)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  returnItems           ReturnItem[]

  @@index([orderId])
  @@index([sellerOrderId])
  @@index([productId])

}

/// رزرو موقت موجودی برای خریدار/فرآیند سفارش همراه با انقضا و وضعیت.
model InventoryReservation {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id             BigInt                     @id @default(autoincrement())
  /// شناسه محصول مرتبط با این InventoryReservation؛ کلید خارجی به جدول Product است.
  productId      Int
  /// شناسه کاربر مرتبط با این InventoryReservation؛ کلید خارجی به جدول User است.
  buyerUserId    Int
  /// شناسه سفارش مرتبط با این InventoryReservation؛ کلید خارجی به جدول RetailOrder است.
  orderId        Int?
  /// تعداد واحدهای کالا یا مقدار موردنظر.
  quantity       Int
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status         InventoryReservationStatus @default(ACTIVE)
  /// کلید یکتای فرآیند checkout برای جلوگیری از رزرو تکراری.
  checkoutKey    String                     @unique @db.VarChar(160)
  /// زمان انقضای اعتبار رکورد یا توکن.
  expiresAt      DateTime
  /// زمان مصرف‌شدن چالش یک‌بارمصرف یا رزرو موجودی.
  consumedAt     DateTime?
  /// زمان آزادسازی رزرو موجودی یا تخصیص.
  releasedAt     DateTime?
  /// زمان ایجاد رکورد.
  createdAt      DateTime                   @default(now())
  /// رابطه Prisma با جدول Product (محصول)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  product        Product                    @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// رابطه Prisma با جدول User (کاربر)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  buyer          User                       @relation(fields: [buyerUserId], references: [id], onDelete: Restrict)
  /// رابطه Prisma با جدول RetailOrder (سفارش)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  order          RetailOrder?               @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([productId, status, expiresAt])
  @@index([buyerUserId, createdAt])
  @@index([orderId])

}

/// تلاش آغاز یا تکمیل پرداخت سفارش، درگاه، وضعیت و شناسه‌های پیگیری.
model PaymentAttempt {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id             Int                 @id @default(autoincrement())
  /// شناسه سفارش مرتبط با این PaymentAttempt؛ کلید خارجی به جدول RetailOrder است.
  orderId        Int
  /// نام درگاه یا سرویس بیرونی انجام‌دهنده عملیات.
  provider       String              @db.VarChar(80)
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status         PaymentAttemptStatus @default(CREATED)
  /// مبلغ مالی این رکورد.
  amount         Decimal             @db.Decimal(20, 2)
  /// کد سه‌حرفی ارز (ISO 4217) مبالغ این رکورد.
  currency       String              @db.VarChar(3)
  /// کلید یکتای جلوگیری از اجرای تکراری درخواست/عملیات.
  idempotencyKey String              @unique @db.VarChar(160)
  /// شناسه مجوز/authority پرداخت صادرشده توسط درگاه.
  authority      String?             @unique @db.VarChar(200)
  /// نشانی هدایت کاربر به صفحه پرداخت درگاه.
  redirectUrl    String?             @db.VarChar(1000)
  /// زمان انقضای اعتبار رکورد یا توکن.
  expiresAt      DateTime?
  /// زمان تکمیل عملیات.
  completedAt    DateTime?
  /// زمان ایجاد رکورد.
  createdAt      DateTime            @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt      DateTime            @updatedAt
  /// رابطه Prisma با جدول RetailOrder (سفارش)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  order          RetailOrder         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// رابطه Prisma با جدول PaymentTransaction (PaymentTransaction)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  transactions   PaymentTransaction[]
  /// رابطه Prisma با جدول PaymentWebhookEvent (PaymentWebhookEvent)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  webhookEvents  PaymentWebhookEvent[]

  @@index([orderId, createdAt])
  @@index([provider, status, createdAt])

}

/// تراکنش پرداخت/بازپرداخت مرتبط با سفارش یا تلاش پرداخت.
model PaymentTransaction {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id                  Int                      @id @default(autoincrement())
  /// شناسه سفارش مرتبط با این PaymentTransaction؛ کلید خارجی به جدول RetailOrder است.
  orderId             Int
  /// شناسه PaymentAttempt مرتبط با این PaymentTransaction؛ کلید خارجی به جدول PaymentAttempt است.
  attemptId           Int?
  /// نام درگاه یا سرویس بیرونی انجام‌دهنده عملیات.
  provider            String                   @db.VarChar(80)
  /// شناسه تراکنش نزد درگاه پرداخت.
  providerTransactionId String?                @db.VarChar(200)
  /// نوع تراکنش مالی.
  transactionType     PaymentTransactionType
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status              PaymentTransactionStatus @default(PENDING)
  /// مبلغ مالی این رکورد.
  amount              Decimal                  @db.Decimal(20, 2)
  /// کد سه‌حرفی ارز (ISO 4217) مبالغ این رکورد.
  currency            String                   @db.VarChar(3)
  /// زمان تأیید تراکنش یا اطلاعات توسط سامانه/درگاه.
  verifiedAt          DateTime?
  /// زمان ایجاد رکورد.
  createdAt           DateTime                 @default(now())
  /// رابطه Prisma با جدول RetailOrder (سفارش)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  order               RetailOrder              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// رابطه Prisma با جدول PaymentAttempt (PaymentAttempt)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  attempt              PaymentAttempt?          @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  /// رابطه Prisma با جدول RetailRefund (RetailRefund)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  refunds             RetailRefund[]
  /// رابطه Prisma با جدول ReconciliationRecord (ReconciliationRecord)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  reconciliations     ReconciliationRecord[]

  @@unique([provider, providerTransactionId])
  @@index([orderId, createdAt])
  @@index([attemptId])
  @@index([status, createdAt])

}

/// رویداد دریافتی webhook درگاه با اعتبار امضا و نتیجه پردازش.
model PaymentWebhookEvent {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id             BigInt              @id @default(autoincrement())
  /// نام درگاه یا سرویس بیرونی انجام‌دهنده عملیات.
  provider       String              @db.VarChar(80)
  /// شناسه یکتای رویداد webhook نزد ارائه‌دهنده.
  providerEventId String             @db.VarChar(240)
  /// شناسه PaymentAttempt مرتبط با این PaymentWebhookEvent؛ کلید خارجی به جدول PaymentAttempt است.
  attemptId      Int?
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status         PaymentWebhookStatus @default(RECEIVED)
  /// اعتبارسنجی امضای دیجیتال webhook را مشخص می‌کند.
  signatureValid Boolean             @default(false)
  /// بدنه ساختاریافته یا خام رویداد دریافتی/داخلی.
  payload        Json
  /// زمان دریافت رویداد یا درخواست.
  receivedAt     DateTime            @default(now())
  /// زمان پایان پردازش رویداد/عملیات.
  processedAt    DateTime?
  /// آخرین خطای رخ‌داده هنگام پردازش/ارسال.
  lastError      String?
  /// رابطه Prisma با جدول PaymentAttempt (PaymentAttempt)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  attempt        PaymentAttempt?      @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([status, receivedAt])
  @@index([attemptId])

}

/// درخواست و نتیجه بازپرداخت وجه سفارش.
model RetailRefund {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id                    Int           @id @default(autoincrement())
  /// شناسه سفارش مرتبط با این RetailRefund؛ کلید خارجی به جدول RetailOrder است.
  orderId               Int
  /// شناسه سفارش فروشنده مرتبط با این RetailRefund؛ کلید خارجی به جدول SellerOrder است.
  sellerOrderId         Int?
  /// شناسه PaymentTransaction مرتبط با این RetailRefund؛ کلید خارجی به جدول PaymentTransaction است.
  paymentTransactionId  Int?
  /// شناسه کاربر مرتبط با این RetailRefund؛ کلید خارجی به جدول User است.
  requestedByUserId     Int
  /// مبلغ مالی این رکورد.
  amount                Decimal       @db.Decimal(20, 2)
  /// کد سه‌حرفی ارز (ISO 4217) مبالغ این رکورد.
  currency              String        @db.VarChar(3)
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status                RefundStatus  @default(REQUESTED)
  /// علت درخواست، تغییر وضعیت یا تصمیم.
  reason                String        @db.VarChar(1000)
  /// کلید یکتای جلوگیری از اجرای تکراری درخواست/عملیات.
  idempotencyKey        String        @unique @db.VarChar(160)
  /// شناسه رکورد مرتبط برای اتصال این RetailRefund به موجودیت مرجع.
  providerRefundId      String?       @unique @db.VarChar(200)
  /// زمان پایان پردازش رویداد/عملیات.
  processedAt           DateTime?
  /// زمان ایجاد رکورد.
  createdAt             DateTime      @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt             DateTime      @updatedAt
  /// رابطه Prisma با جدول RetailOrder (سفارش)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  order                 RetailOrder   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// رابطه Prisma با جدول SellerOrder (سفارش فروشنده)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  sellerOrder           SellerOrder?  @relation(fields: [sellerOrderId], references: [id], onDelete: SetNull)
  /// رابطه Prisma با جدول PaymentTransaction (PaymentTransaction)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  paymentTransaction    PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id], onDelete: Restrict)
  /// رابطه Prisma با جدول User (کاربر)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  requestedBy           User          @relation(fields: [requestedByUserId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([sellerOrderId, status])
  @@index([status, createdAt])

}

/// اطلاعات ارسال سفارش فروشنده شامل شرکت حمل، کد رهگیری و وضعیت.
model Shipment {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id                Int            @id @default(autoincrement())
  /// شناسه سفارش فروشنده مرتبط با این Shipment؛ کلید خارجی به جدول SellerOrder است.
  sellerOrderId     Int
  /// نام شرکت حمل‌ونقل یا سرویس ارسال.
  carrier           String?        @db.VarChar(120)
  /// کد رهگیری مرسوله نزد شرکت حمل.
  trackingNumber    String?        @db.VarChar(160)
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status            ShipmentStatus @default(LABEL_CREATED)
  /// زمان shipped این Shipment را ثبت می‌کند.
  shippedAt         DateTime?
  /// زمان delivered این Shipment را ثبت می‌کند.
  deliveredAt       DateTime?
  /// زمان ایجاد رکورد.
  createdAt         DateTime       @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt         DateTime       @updatedAt
  /// رابطه Prisma با جدول SellerOrder (سفارش فروشنده)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  sellerOrder       SellerOrder    @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  /// رابطه Prisma با جدول TrackingEvent (TrackingEvent)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  trackingEvents    TrackingEvent[]

  @@index([sellerOrderId, createdAt])
  @@index([trackingNumber])
  @@index([status, updatedAt])

}

/// رویدادهای رهگیری مرسوله شامل شرح، موقعیت و زمان وقوع.
model TrackingEvent {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id          BigInt        @id @default(autoincrement())
  /// شناسه Shipment مرتبط با این TrackingEvent؛ کلید خارجی به جدول Shipment است.
  shipmentId  Int
  /// کد نوع رویداد رهگیری.
  eventCode   String?       @db.VarChar(80)
  /// شرح تکمیلی موجودیت.
  description String        @db.VarChar(500)
  /// موقعیت یا شهر ثبت‌شده برای رویداد رهگیری.
  location    String?       @db.VarChar(240)
  /// زمان وقوع رویداد در منبع.
  occurredAt  DateTime
  /// زمان ایجاد رکورد.
  createdAt   DateTime      @default(now())
  /// رابطه Prisma با جدول Shipment (Shipment)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  shipment    Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])

}

/// درخواست مرجوعی خریدار برای سفارش یا بخش فروشنده.
model ReturnRequest {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id              Int          @id @default(autoincrement())
  /// شناسه سفارش فروشنده مرتبط با این ReturnRequest؛ کلید خارجی به جدول SellerOrder است.
  orderId         Int
  /// شناسه سفارش فروشنده مرتبط با این ReturnRequest؛ کلید خارجی به جدول SellerOrder است.
  sellerOrderId   Int
  /// شناسه کاربر مرتبط با این ReturnRequest؛ کلید خارجی به جدول User است.
  buyerUserId     Int
  /// شماره یکتای درخواست مرجوعی.
  returnNumber    String       @unique @db.VarChar(40)
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status          ReturnStatus @default(REQUESTED)
  /// علت درخواست، تغییر وضعیت یا تصمیم.
  reason          String       @db.VarChar(1000)
  /// زمان ثبت درخواست.
  requestedAt     DateTime     @default(now())
  /// زمان دریافت رویداد یا درخواست.
  receivedAt      DateTime?
  /// زمان بسته‌شدن پرونده یا فرآیند.
  closedAt        DateTime?
  /// زمان ایجاد رکورد.
  createdAt       DateTime     @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt       DateTime     @updatedAt
  /// رابطه Prisma با جدول RetailOrder (سفارش)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  order           RetailOrder  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// رابطه Prisma با جدول SellerOrder (سفارش فروشنده)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  sellerOrder     SellerOrder  @relation(fields: [sellerOrderId, orderId], references: [id, orderId], onDelete: Restrict)
  /// رابطه Prisma با جدول User (کاربر)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  buyer           User         @relation(fields: [buyerUserId], references: [id], onDelete: Restrict)
  /// رابطه Prisma با جدول ReturnItem (ReturnItem)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  items           ReturnItem[]

  @@index([orderId, status])
  @@index([sellerOrderId, status])
  @@index([buyerUserId, createdAt])

}

/// اقلام و تعدادهای مشمول درخواست مرجوعی و نتیجه بازرسی آن‌ها.
model ReturnItem {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id              Int                   @id @default(autoincrement())
  /// شناسه ReturnRequest مرتبط با این ReturnItem؛ کلید خارجی به جدول ReturnRequest است.
  returnRequestId Int
  /// شناسه RetailOrderItem مرتبط با این ReturnItem؛ کلید خارجی به جدول RetailOrderItem است.
  orderItemId     Int
  /// تعداد واحدهای کالا یا مقدار موردنظر.
  quantity        Int
  /// نحوه تعیین تکلیف کالای برگشتی.
  disposition     ReturnItemDisposition?
  /// نتیجه بررسی و توضیح کارشناس درباره کالای مرجوعی.
  inspectionNote  String?
  /// زمان ایجاد رکورد.
  createdAt       DateTime              @default(now())
  /// رابطه Prisma با جدول ReturnRequest (ReturnRequest)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  returnRequest   ReturnRequest         @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  /// رابطه Prisma با جدول RetailOrderItem (RetailOrderItem)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  orderItem       RetailOrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([returnRequestId, orderItemId])
  @@index([orderItemId])

}

// ============================================================================
// DB-6 — Marketplace finance, immutable ledger and settlements
// ============================================================================
enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  REVERSED
}

enum CommissionCalculationType {
  PERCENTAGE
  FIXED_PER_ORDER
}

enum SellerPayableStatus {
  PENDING
  ON_HOLD
  ELIGIBLE
  INCLUDED_IN_SETTLEMENT
  PAID
  REVERSED
}

enum SettlementApprovalDecision {
  APPROVE
  REJECT
  RETURN_FOR_REVISION
}

enum SettlementStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  PAYOUT_PENDING
  PAID
  RECONCILED
  ON_HOLD
  REJECTED
  PAYOUT_FAILED
  ADJUSTED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  VOID
}

/// حساب دفتر کل با کد، نام، ماهیت حساب و ارز.
model LedgerAccount {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id          Int               @id @default(autoincrement())
  /// کد ماشینی یا تجاری این موجودیت.
  code        String            @unique @db.VarChar(80)
  /// نام قابل نمایش موجودیت.
  name        String            @db.VarChar(200)
  /// نوع حساب CRM (شرکت یا شخص) را مشخص می‌کند.
  accountType LedgerAccountType
  /// کد سه‌حرفی ارز (ISO 4217) مبالغ این رکورد.
  currency    String            @db.VarChar(3)
  /// سیستمی بودن رکورد و محدودیت مدیریت عادی آن.
  isSystem    Boolean           @default(false)
  /// فعال یا غیرفعال بودن رکورد.
  isActive    Boolean           @default(true)
  /// زمان ایجاد رکورد.
  createdAt   DateTime          @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt   DateTime          @updatedAt
  /// رابطه Prisma با جدول JournalLine (JournalLine)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  lines       JournalLine[]

  @@index([accountType, currency, isActive])

}

/// سند حسابداری دفتر کل با منبع، وضعیت ثبت و ارتباط با سند معکوس.
model JournalEntry {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id              BigInt            @id @default(autoincrement())
  /// شماره یکتای سند حسابداری.
  entryNumber     String            @unique @db.VarChar(48)
  /// نوع منبع کسب‌وکاری ایجادکننده سند/رویداد.
  sourceType      String?           @db.VarChar(80)
  /// شناسه منبع کسب‌وکاری ایجادکننده سند/رویداد.
  sourceId        String?           @db.VarChar(120)
  /// کد سه‌حرفی ارز (ISO 4217) مبالغ این رکورد.
  currency        String            @db.VarChar(3)
  /// شرح تکمیلی موجودیت.
  description     String?           @db.VarChar(1000)
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status          JournalEntryStatus @default(DRAFT)
  /// زمان وقوع رویداد در منبع.
  occurredAt      DateTime          @default(now())
  /// زمان قطعی و ثبت‌شدن سند حسابداری در دفتر کل.
  postedAt        DateTime?
  /// شناسه کاربر مرتبط با این JournalEntry؛ کلید خارجی به جدول User است.
  createdByUserId Int?
  /// شناسه JournalEntry مرتبط با این JournalEntry؛ کلید خارجی به جدول JournalEntry است.
  reversalOfId    BigInt?           @unique
  /// زمان ایجاد رکورد.
  createdAt       DateTime          @default(now())
  /// رابطه Prisma با جدول JournalLine (JournalLine)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  lines           JournalLine[]
  /// رابطه Prisma با جدول User (کاربر)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  createdBy       User?             @relation("JournalEntryCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  /// رابطه Prisma با جدول JournalEntry (JournalEntry)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  reversalOf      JournalEntry?     @relation("JournalReversals", fields: [reversalOfId], references: [id], onDelete: Restrict)
  /// رابطه Prisma با جدول JournalEntry (JournalEntry)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  reversals       JournalEntry[]    @relation("JournalReversals")

  @@index([sourceType, sourceId])
  @@index([status, occurredAt])
  @@index([currency, postedAt])

}

/// سطر بدهکار/بستانکار سند حسابداری و حساب دفتر کل مربوط.
model JournalLine {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id             BigInt       @id @default(autoincrement())
  /// شناسه JournalEntry مرتبط با این JournalLine؛ کلید خارجی به جدول JournalEntry است.
  journalEntryId BigInt
  /// شناسه LedgerAccount مرتبط با این JournalLine؛ کلید خارجی به جدول LedgerAccount است.
  accountId      Int
  /// مبلغ بدهکار این سطر سند حسابداری.
  debit          Decimal      @default(0) @db.Decimal(20, 2)
  /// مبلغ بستانکار این سطر سند حسابداری.
  credit         Decimal      @default(0) @db.Decimal(20, 2)
  /// شرح کوتاه سطر یا عملیات.
  memo           String?      @db.VarChar(500)
  /// زمان ایجاد رکورد.
  createdAt      DateTime     @default(now())
  /// رابطه Prisma با جدول JournalEntry (JournalEntry)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  /// رابطه Prisma با جدول LedgerAccount (LedgerAccount)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  account        LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([journalEntryId])
  @@index([accountId, createdAt])

}

/// قاعده محاسبه کمیسیون بر اساس درصد/مبلغ ثابت، شرکت/دسته و بازه اعتبار.
model CommissionRule {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id            Int                       @id @default(autoincrement())
  /// کد ماشینی یا تجاری این موجودیت.
  code          String                    @unique @db.VarChar(80)
  /// نام قابل نمایش موجودیت.
  name          String                    @db.VarChar(200)
  /// روش محاسبه مقدار یا کمیسیون.
  calculation   CommissionCalculationType
  /// نرخ یا درصد مورد استفاده در محاسبه.
  rate          Decimal                   @db.Decimal(12, 6)
  /// کد سه‌حرفی ارز (ISO 4217) مبالغ این رکورد.
  currency      String?                   @db.VarChar(3)
  /// شناسه شرکت مرتبط با این CommissionRule؛ کلید خارجی به جدول Company است.
  companyId     Int?
  /// شناسه Category مرتبط با این CommissionRule؛ کلید خارجی به جدول Category است.
  categoryId    Int?
  /// اولویت رسیدگی یا پردازش.
  priority      Int                       @default(0)
  /// شروع اعتبار قیمت یا قاعده.
  validFrom     DateTime
  /// پایان اعتبار؛ NULL یعنی تاریخ پایان تعیین نشده است.
  validTo       DateTime?
  /// فعال یا غیرفعال بودن رکورد.
  isActive      Boolean                   @default(true)
  /// زمان ایجاد رکورد.
  createdAt     DateTime                  @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt     DateTime                  @updatedAt
  /// رابطه Prisma با جدول Company (شرکت)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  company       Company?                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  /// رابطه Prisma با جدول Category (Category)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  category      Category?                 @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// رابطه Prisma با جدول CommissionSnapshot (CommissionSnapshot)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  snapshots     CommissionSnapshot[]

  @@index([isActive, validFrom, validTo, priority])
  @@index([companyId, categoryId])

}

/// snapshot کمیسیون محاسبه‌شده برای سفارش فروشنده تا تغییر بعدی قانون، مبلغ تاریخی را عوض نکند.
model CommissionSnapshot {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id             Int            @id @default(autoincrement())
  /// شناسه سفارش فروشنده مرتبط با این CommissionSnapshot؛ کلید خارجی به جدول SellerOrder است.
  sellerOrderId  Int            @unique
  /// شناسه CommissionRule مرتبط با این CommissionSnapshot؛ کلید خارجی به جدول CommissionRule است.
  ruleId         Int?
  /// روش محاسبه مقدار یا کمیسیون.
  calculation    CommissionCalculationType
  /// نرخ یا درصد مورد استفاده در محاسبه.
  rate           Decimal        @db.Decimal(12, 6)
  /// مبلغ مبنای محاسبه کمیسیون.
  baseAmount     Decimal        @db.Decimal(20, 2)
  /// مبلغ کمیسیون محاسبه‌شده.
  commissionAmount Decimal      @db.Decimal(20, 2)
  /// کد سه‌حرفی ارز (ISO 4217) مبالغ این رکورد.
  currency       String         @db.VarChar(3)
  /// زمان ایجاد رکورد.
  createdAt      DateTime       @default(now())
  /// رابطه Prisma با جدول SellerOrder (سفارش فروشنده)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  sellerOrder    SellerOrder    @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  /// رابطه Prisma با جدول CommissionRule (CommissionRule)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  rule           CommissionRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

}

/// بدهی خالص بازارگاه به فروشنده برای سفارش، پس از کمیسیون و کسورات.
model SellerPayable {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id             BigInt             @id @default(autoincrement())
  /// شناسه سفارش فروشنده مرتبط با این SellerPayable؛ کلید خارجی به جدول SellerOrder است.
  sellerOrderId  Int                @unique
  /// شناسه شرکت مرتبط با این SellerPayable؛ کلید خارجی به جدول Company است.
  companyId      Int
  /// شناسه تسویه مرتبط با این SellerPayable؛ کلید خارجی به جدول Settlement است.
  settlementId   Int?
  /// کد سه‌حرفی ارز (ISO 4217) مبالغ این رکورد.
  currency       String             @db.VarChar(3)
  /// مبلغ ناخالص پیش از کسر کمیسیون و کسورات.
  grossAmount    Decimal            @db.Decimal(20, 2)
  /// مبلغ کمیسیون محاسبه‌شده.
  commissionAmount Decimal          @default(0) @db.Decimal(20, 2)
  /// جمع کسورات از مبلغ فروشنده/تسویه.
  deductionAmount Decimal           @default(0) @db.Decimal(20, 2)
  /// مبلغ خالص پس از کسر کمیسیون و کسورات.
  netAmount      Decimal            @db.Decimal(20, 2)
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status         SellerPayableStatus @default(PENDING)
  /// زمان eligible این SellerPayable را ثبت می‌کند.
  eligibleAt     DateTime?
  /// زمان پرداخت موفق.
  paidAt         DateTime?
  /// زمان ایجاد رکورد.
  createdAt      DateTime           @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt      DateTime           @updatedAt
  /// رابطه Prisma با جدول SellerOrder (سفارش فروشنده)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  sellerOrder    SellerOrder        @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  /// رابطه Prisma با جدول Company (شرکت)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  company        Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  /// رابطه Prisma با جدول Settlement (تسویه)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  settlement     Settlement?        @relation(fields: [settlementId], references: [id], onDelete: SetNull)

  @@index([companyId, status, eligibleAt])
  @@index([settlementId])

}

/// پرونده تسویه مالی شرکت در یک دوره همراه با مبالغ و وضعیت تأیید/پرداخت.
model Settlement {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id               Int             @id @default(autoincrement())
  /// شماره یکتای پرونده تسویه.
  settlementNumber String          @unique @db.VarChar(48)
  /// شناسه شرکت مرتبط با این تسویه؛ کلید خارجی به جدول Company است.
  companyId        Int
  /// کد سه‌حرفی ارز (ISO 4217) مبالغ این رکورد.
  currency         String          @db.VarChar(3)
  /// شروع دوره مالی/تسویه.
  periodStart      DateTime
  /// پایان دوره مالی/تسویه.
  periodEnd        DateTime
  /// مبلغ ناخالص پیش از کسر کمیسیون و کسورات.
  grossAmount      Decimal         @default(0) @db.Decimal(20, 2)
  /// جمع کسورات از مبلغ فروشنده/تسویه.
  deductionAmount  Decimal         @default(0) @db.Decimal(20, 2)
  /// مبلغ خالص پس از کسر کمیسیون و کسورات.
  netAmount        Decimal         @default(0) @db.Decimal(20, 2)
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status           SettlementStatus @default(REQUESTED)
  /// شناسه کاربر مرتبط با این تسویه؛ کلید خارجی به جدول User است.
  requestedByUserId Int
  /// زمان ثبت درخواست.
  requestedAt      DateTime        @default(now())
  /// زمان تأیید.
  approvedAt       DateTime?
  /// زمان پرداخت موفق.
  paidAt           DateTime?
  /// زمان ایجاد رکورد.
  createdAt        DateTime        @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt        DateTime        @updatedAt
  /// رابطه Prisma با جدول Company (شرکت)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  company          Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  /// رابطه Prisma با جدول User (کاربر)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  requestedBy      User            @relation("SettlementRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  /// رابطه Prisma با جدول SellerPayable (SellerPayable)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  payables         SellerPayable[]
  /// رابطه Prisma با جدول SettlementApproval (SettlementApproval)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  approvals        SettlementApproval[]
  /// رابطه Prisma با جدول SettlementPayout (SettlementPayout)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  payouts          SettlementPayout[]

  @@index([companyId, status, createdAt])
  @@index([status, requestedAt])
  @@index([periodStart, periodEnd])

}

/// تصمیم تأیید/رد پرونده تسویه، تأییدکننده و زمان تصمیم.
model SettlementApproval {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id             Int        @id @default(autoincrement())
  /// شناسه تسویه مرتبط با این SettlementApproval؛ کلید خارجی به جدول Settlement است.
  settlementId   Int
  /// شناسه کاربر مرتبط با این SettlementApproval؛ کلید خارجی به جدول User است.
  approverUserId Int
  /// نتیجه تصمیم ثبت‌شده.
  decision       SettlementApprovalDecision
  /// علت درخواست، تغییر وضعیت یا تصمیم.
  reason         String?    @db.VarChar(1000)
  /// زمان ثبت تصمیم تأییدکننده.
  decidedAt      DateTime   @default(now())
  /// رابطه Prisma با جدول Settlement (تسویه)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  settlement     Settlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  /// رابطه Prisma با جدول User (کاربر)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  approver       User       @relation(fields: [approverUserId], references: [id], onDelete: Restrict)

  @@unique([settlementId, approverUserId])
  @@index([settlementId, decidedAt])
  @@index([approverUserId, decidedAt])

}

/// اجرای پرداخت یک تسویه به فروشنده و نتیجه آن.
model SettlementPayout {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id                Int         @id @default(autoincrement())
  /// شناسه تسویه مرتبط با این SettlementPayout؛ کلید خارجی به جدول Settlement است.
  settlementId      Int
  /// نام درگاه یا سرویس بیرونی انجام‌دهنده عملیات.
  provider           String?    @db.VarChar(80)
  /// شناسه مرجع عملیات نزد ارائه‌دهنده بیرونی.
  providerReference  String?    @unique @db.VarChar(200)
  /// مبلغ مالی این رکورد.
  amount             Decimal    @db.Decimal(20, 2)
  /// کد سه‌حرفی ارز (ISO 4217) مبالغ این رکورد.
  currency           String     @db.VarChar(3)
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status             PayoutStatus @default(PENDING)
  /// کلید یکتای جلوگیری از اجرای تکراری درخواست/عملیات.
  idempotencyKey     String     @unique @db.VarChar(160)
  /// شناسه کاربر مرتبط با این SettlementPayout؛ کلید خارجی به جدول User است.
  executedByUserId   Int?
  /// زمان اجرای واقعی عملیات پرداخت.
  executedAt         DateTime?
  /// علت شکست عملیات.
  failureReason      String?
  /// زمان ایجاد رکورد.
  createdAt          DateTime   @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt          DateTime   @updatedAt
  /// رابطه Prisma با جدول Settlement (تسویه)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  settlement         Settlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  /// رابطه Prisma با جدول User (کاربر)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  executedBy         User?      @relation("PayoutExecutor", fields: [executedByUserId], references: [id], onDelete: SetNull)
  /// رابطه Prisma با جدول ReconciliationRecord (ReconciliationRecord)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  reconciliations    ReconciliationRecord[]

  @@index([settlementId, createdAt])
  @@index([status, createdAt])

}

/// تطبیق تراکنش یا پرداخت خروجی با گزارش ارائه‌دهنده مالی.
model ReconciliationRecord {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id                    BigInt             @id @default(autoincrement())
  /// نام درگاه یا سرویس بیرونی انجام‌دهنده عملیات.
  provider              String             @db.VarChar(80)
  /// شناسه مرجع رکورد در سامانه بیرونی.
  externalReference     String             @db.VarChar(240)
  /// مبلغ مالی این رکورد.
  amount                Decimal            @db.Decimal(20, 2)
  /// کد سه‌حرفی ارز (ISO 4217) مبالغ این رکورد.
  currency              String             @db.VarChar(3)
  /// مشخص می‌کند رکورد با تراکنش/پرداخت متناظر تطبیق داده شده است.
  matched                Boolean            @default(false)
  /// شناسه PaymentTransaction مرتبط با این ReconciliationRecord؛ کلید خارجی به جدول PaymentTransaction است.
  paymentTransactionId  Int?
  /// شناسه SettlementPayout مرتبط با این ReconciliationRecord؛ کلید خارجی به جدول SettlementPayout است.
  payoutId              Int?
  /// یادداشت‌های تکمیلی درباره رکورد.
  notes                 String?
  /// زمان انجام تطبیق با گزارش ارائه‌دهنده مالی.
  reconciledAt          DateTime            @default(now())
  /// رابطه Prisma با جدول PaymentTransaction (PaymentTransaction)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  paymentTransaction    PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id], onDelete: SetNull)
  /// رابطه Prisma با جدول SettlementPayout (SettlementPayout)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  payout                SettlementPayout?  @relation(fields: [payoutId], references: [id], onDelete: Restrict)

  @@unique([provider, externalReference])
  @@index([matched, reconciledAt])
  @@index([paymentTransactionId])
  @@index([payoutId])

}

/// سربرگ فاکتور مالی مرتبط با خریدار، شرکت یا سفارش.
model FinanceInvoice {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id                Int           @id @default(autoincrement())
  /// شماره یکتای فاکتور مالی.
  invoiceNumber     String        @unique @db.VarChar(48)
  /// شناسه شرکت مرتبط با این FinanceInvoice؛ کلید خارجی به جدول Company است.
  companyId         Int?
  /// شناسه کاربر مرتبط با این FinanceInvoice؛ کلید خارجی به جدول User است.
  buyerUserId       Int?
  /// شناسه سفارش مرتبط با این FinanceInvoice؛ کلید خارجی به جدول RetailOrder است.
  orderId           Int?
  /// شناسه سفارش فروشنده مرتبط با این FinanceInvoice؛ کلید خارجی به جدول SellerOrder است.
  sellerOrderId     Int?
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status            InvoiceStatus @default(DRAFT)
  /// کد سه‌حرفی ارز (ISO 4217) مبالغ این رکورد.
  currency          String        @db.VarChar(3)
  /// جمع مبالغ پیش از تخفیف/مالیات/هزینه‌های افزوده.
  subtotal          Decimal       @db.Decimal(20, 2)
  /// جمع مالیات سفارش یا فاکتور.
  taxTotal          Decimal       @default(0) @db.Decimal(20, 2)
  /// مبلغ نهایی قابل پرداخت پس از اعمال اجزا و تعدیلات.
  grandTotal        Decimal       @db.Decimal(20, 2)
  /// زمان صدور رسمی فاکتور.
  issuedAt          DateTime?
  /// زمان ایجاد رکورد.
  createdAt         DateTime      @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt         DateTime      @updatedAt
  /// رابطه Prisma با جدول Company (شرکت)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  company           Company?      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  /// رابطه Prisma با جدول User (کاربر)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  buyer             User?         @relation(fields: [buyerUserId], references: [id], onDelete: Restrict)
  /// رابطه Prisma با جدول RetailOrder (سفارش)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  order             RetailOrder?  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// رابطه Prisma با جدول SellerOrder (سفارش فروشنده)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  sellerOrder       SellerOrder?  @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  /// رابطه Prisma با جدول FinanceInvoiceLine (FinanceInvoiceLine)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  lines             FinanceInvoiceLine[]

  @@index([companyId, createdAt])
  @@index([buyerUserId, createdAt])
  @@index([orderId])
  @@index([sellerOrderId])

}

/// ردیف جزئیات فاکتور شامل شرح، تعداد، قیمت، مالیات و جمع ردیف.
model FinanceInvoiceLine {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id          Int           @id @default(autoincrement())
  /// شناسه FinanceInvoice مرتبط با این FinanceInvoiceLine؛ کلید خارجی به جدول FinanceInvoice است.
  invoiceId   Int
  /// شرح تکمیلی موجودیت.
  description String        @db.VarChar(500)
  /// تعداد واحدهای کالا یا مقدار موردنظر.
  quantity    Decimal       @default(1) @db.Decimal(18, 4)
  /// قیمت هر واحد کالا یا خدمت در این ردیف.
  unitPrice   Decimal       @db.Decimal(20, 2)
  /// مبلغ مالیات محاسبه‌شده برای این ردیف.
  taxAmount   Decimal       @default(0) @db.Decimal(20, 2)
  /// مبلغ نهایی این ردیف پس از تخفیف و مالیات.
  lineTotal   Decimal       @db.Decimal(20, 2)
  /// رابطه Prisma با جدول FinanceInvoice (FinanceInvoice)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  invoice     FinanceInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])

}
