  lineTotal             Decimal     @db.Decimal(20, 2)
  /// کد سه‌حرفی ارز (ISO 4217) مبالغ این رکورد.
  currency              String      @db.VarChar(3)
  /// زمان ایجاد رکورد.
  createdAt             DateTime    @default(now())
  /// ارتباط Prisma با جدول RetailOrder (سفارش): رکورد مرتبط مرتبط با RetailOrderItem؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  order                 RetailOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// ارتباط Prisma با جدول SellerOrder (سفارش فروشنده): رکورد مرتبط مرتبط با RetailOrderItem؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  sellerOrder           SellerOrder @relation(fields: [sellerOrderId, orderId], references: [id, orderId], onDelete: Restrict)
  /// ارتباط Prisma با جدول Product (محصول): رکورد مرتبط مرتبط با RetailOrderItem؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  product               Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// ارتباط Prisma با جدول ReturnItem (ReturnItem): مجموعه رکوردهای وابسته مرتبط با RetailOrderItem؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  returnItems           ReturnItem[]

  @@index([orderId])
  @@index([sellerOrderId])
  @@index([productId])

}

/// رزرو موقت موجودی برای خریدار/فرآیند سفارش همراه با انقضا و وضعیت.
model InventoryReservation {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id             BigInt                     @id @default(autoincrement())
  /// شناسه محصول مرتبط با این InventoryReservation؛ کلید خارجی به جدول Product است.
  productId      Int
  /// شناسه کاربر مرتبط با این InventoryReservation؛ کلید خارجی به جدول User است.
  buyerUserId    Int
  /// شناسه سفارش مرتبط با این InventoryReservation؛ کلید خارجی به جدول RetailOrder است.
  orderId        Int?
  /// تعداد واحدهای کالا یا مقدار موردنظر.
  quantity       Int
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status         InventoryReservationStatus @default(ACTIVE)
  /// مقدار متنی checkoutKey برای توصیف یا شناسایی InventoryReservation.
  checkoutKey    String                     @unique @db.VarChar(160)
  /// زمان انقضای اعتبار رکورد یا توکن.
  expiresAt      DateTime
  /// زمان consumed این InventoryReservation را ثبت می‌کند.
  consumedAt     DateTime?
  /// زمان released این InventoryReservation را ثبت می‌کند.
  releasedAt     DateTime?
  /// زمان ایجاد رکورد.
  createdAt      DateTime                   @default(now())
  /// ارتباط Prisma با جدول Product (محصول): رکورد مرتبط مرتبط با InventoryReservation؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  product        Product                    @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// ارتباط Prisma با جدول User (کاربر): رکورد مرتبط مرتبط با InventoryReservation؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  buyer          User                       @relation(fields: [buyerUserId], references: [id], onDelete: Restrict)
  /// ارتباط Prisma با جدول RetailOrder (سفارش): رکورد مرتبط مرتبط با InventoryReservation؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  order          RetailOrder?               @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([productId, status, expiresAt])
  @@index([buyerUserId, createdAt])
  @@index([orderId])

}

/// تلاش آغاز یا تکمیل پرداخت سفارش، درگاه، وضعیت و شناسه‌های پیگیری.
model PaymentAttempt {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id             Int                 @id @default(autoincrement())
  /// شناسه سفارش مرتبط با این PaymentAttempt؛ کلید خارجی به جدول RetailOrder است.
  orderId        Int
  /// نام درگاه یا سرویس بیرونی انجام‌دهنده عملیات.
  provider       String              @db.VarChar(80)
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status         PaymentAttemptStatus @default(CREATED)
  /// مبلغ مالی این رکورد.
  amount         Decimal             @db.Decimal(20, 2)
  /// کد سه‌حرفی ارز (ISO 4217) مبالغ این رکورد.
  currency       String              @db.VarChar(3)
  /// کلید یکتای جلوگیری از اجرای تکراری درخواست/عملیات.
  idempotencyKey String              @unique @db.VarChar(160)
  /// مقدار متنی authority برای توصیف یا شناسایی PaymentAttempt.
  authority      String?             @unique @db.VarChar(200)
  /// مقدار متنی redirectUrl برای توصیف یا شناسایی PaymentAttempt.
  redirectUrl    String?             @db.VarChar(1000)
  /// زمان انقضای اعتبار رکورد یا توکن.
  expiresAt      DateTime?
  /// زمان تکمیل عملیات.
  completedAt    DateTime?
  /// زمان ایجاد رکورد.
  createdAt      DateTime            @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt      DateTime            @updatedAt
  /// ارتباط Prisma با جدول RetailOrder (سفارش): رکورد مرتبط مرتبط با PaymentAttempt؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  order          RetailOrder         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// ارتباط Prisma با جدول PaymentTransaction (PaymentTransaction): مجموعه رکوردهای وابسته مرتبط با PaymentAttempt؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  transactions   PaymentTransaction[]
  /// ارتباط Prisma با جدول PaymentWebhookEvent (PaymentWebhookEvent): مجموعه رکوردهای وابسته مرتبط با PaymentAttempt؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  webhookEvents  PaymentWebhookEvent[]

  @@index([orderId, createdAt])
  @@index([provider, status, createdAt])

}

/// تراکنش پرداخت/بازپرداخت مرتبط با سفارش یا تلاش پرداخت.
model PaymentTransaction {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id                  Int                      @id @default(autoincrement())
  /// شناسه سفارش مرتبط با این PaymentTransaction؛ کلید خارجی به جدول RetailOrder است.
  orderId             Int
  /// شناسه PaymentAttempt مرتبط با این PaymentTransaction؛ کلید خارجی به جدول PaymentAttempt است.
  attemptId           Int?
  /// نام درگاه یا سرویس بیرونی انجام‌دهنده عملیات.
  provider            String                   @db.VarChar(80)
  /// شناسه تراکنش نزد درگاه پرداخت.
  providerTransactionId String?                @db.VarChar(200)
  /// نوع تراکنش مالی.
  transactionType     PaymentTransactionType
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status              PaymentTransactionStatus @default(PENDING)
  /// مبلغ مالی این رکورد.
  amount              Decimal                  @db.Decimal(20, 2)
  /// کد سه‌حرفی ارز (ISO 4217) مبالغ این رکورد.
  currency            String                   @db.VarChar(3)
  /// زمان verified این PaymentTransaction را ثبت می‌کند.
  verifiedAt          DateTime?
  /// زمان ایجاد رکورد.
  createdAt           DateTime                 @default(now())
  /// ارتباط Prisma با جدول RetailOrder (سفارش): رکورد مرتبط مرتبط با PaymentTransaction؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  order               RetailOrder              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// ارتباط Prisma با جدول PaymentAttempt (PaymentAttempt): رکورد مرتبط مرتبط با PaymentTransaction؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  attempt              PaymentAttempt?          @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  /// ارتباط Prisma با جدول RetailRefund (RetailRefund): مجموعه رکوردهای وابسته مرتبط با PaymentTransaction؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  refunds             RetailRefund[]
  /// ارتباط Prisma با جدول ReconciliationRecord (ReconciliationRecord): مجموعه رکوردهای وابسته مرتبط با PaymentTransaction؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  reconciliations     ReconciliationRecord[]

  @@unique([provider, providerTransactionId])
  @@index([orderId, createdAt])
  @@index([attemptId])
  @@index([status, createdAt])

}

/// رویداد دریافتی webhook درگاه با اعتبار امضا و نتیجه پردازش.
model PaymentWebhookEvent {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id             BigInt              @id @default(autoincrement())
  /// نام درگاه یا سرویس بیرونی انجام‌دهنده عملیات.
  provider       String              @db.VarChar(80)
  /// شناسه رکورد مرتبط برای اتصال این PaymentWebhookEvent به موجودیت مرجع.
  providerEventId String             @db.VarChar(240)
  /// شناسه PaymentAttempt مرتبط با این PaymentWebhookEvent؛ کلید خارجی به جدول PaymentAttempt است.
  attemptId      Int?
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status         PaymentWebhookStatus @default(RECEIVED)
  /// اعتبارسنجی امضای دیجیتال webhook را مشخص می‌کند.
  signatureValid Boolean             @default(false)
  /// بدنه ساختاریافته یا خام رویداد دریافتی/داخلی.
  payload        Json
  /// زمان دریافت رویداد یا درخواست.
  receivedAt     DateTime            @default(now())
  /// زمان پایان پردازش رویداد/عملیات.
  processedAt    DateTime?
  /// آخرین خطای رخ‌داده هنگام پردازش/ارسال.
  lastError      String?
  /// ارتباط Prisma با جدول PaymentAttempt (PaymentAttempt): رکورد مرتبط مرتبط با PaymentWebhookEvent؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  attempt        PaymentAttempt?      @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([status, receivedAt])
  @@index([attemptId])

}

/// درخواست و نتیجه بازپرداخت وجه سفارش.
