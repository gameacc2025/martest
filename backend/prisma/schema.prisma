/// مانده فعلی موجودی هر محصول شامل تعداد موجود و تعداد رزروشده.
model InventoryBalance {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id        Int      @id @default(autoincrement())
  /// شناسه محصول مرتبط با این InventoryBalance؛ کلید خارجی به جدول Product است.
  productId Int      @unique
  /// مقدار عددی onHand برای InventoryBalance.
  onHand    Int      @default(0)
  /// مقدار عددی reserved برای InventoryBalance.
  reserved  Int      @default(0)
  /// زمان ایجاد رکورد.
  createdAt DateTime @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt DateTime @updatedAt
  /// ارتباط Prisma با جدول Product (محصول): رکورد مرتبط مرتبط با InventoryBalance؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

}

/// دفتر تغییرات موجودی شامل نوع حرکت، تعداد، مرجع و عامل عملیات.
model InventoryMovement {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id             BigInt                @id @default(autoincrement())
  /// شناسه محصول مرتبط با این InventoryMovement؛ کلید خارجی به جدول Product است.
  productId      Int
  /// شناسه کاربر مرتبط با این InventoryMovement؛ کلید خارجی به جدول User است.
  actorUserId    Int?
  /// نوع حرکت یا رویداد تغییر موجودی.
  movementType   InventoryMovementType
  /// مقدار عددی quantityDelta برای InventoryMovement.
  quantityDelta  Int
  /// مقدار متنی referenceType برای توصیف یا شناسایی InventoryMovement.
  referenceType  String?               @db.VarChar(60)
  /// شناسه رکورد مرتبط برای اتصال این InventoryMovement به موجودیت مرجع.
  referenceId    String?               @db.VarChar(100)
  /// کلید یکتای جلوگیری از اجرای تکراری درخواست/عملیات.
  idempotencyKey String?               @unique @db.VarChar(160)
  /// علت درخواست، تغییر وضعیت یا تصمیم.
  reason         String?               @db.VarChar(500)
  /// داده‌های تکمیلی ساختاریافته و وابسته به دامنه در قالب JSON.
  metadata       Json?
  /// زمان ایجاد رکورد.
  createdAt      DateTime              @default(now())
  /// ارتباط Prisma با جدول Product (محصول): رکورد مرتبط مرتبط با InventoryMovement؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  product        Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// ارتباط Prisma با جدول User (کاربر): رکورد مرتبط مرتبط با InventoryMovement؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  actor          User?                 @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
  @@index([movementType, createdAt])
  @@index([referenceType, referenceId])
  @@index([actorUserId, createdAt])

}

/// سفارش اصلی خریدار، وضعیت سفارش و پرداخت، مبالغ، ارز و snapshot نشانی گیرنده.
model RetailOrder {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id                    Int                @id @default(autoincrement())
  /// مقدار متنی orderNumber برای توصیف یا شناسایی سفارش.
  orderNumber           String             @unique @db.VarChar(40)
  /// شناسه کاربر مرتبط با این سفارش؛ کلید خارجی به جدول User است.
  buyerUserId           Int
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status                RetailOrderStatus  @default(PENDING_PAYMENT)
  /// مقدار paymentStatus برای نگهداری اطلاعات مرتبط با سفارش.
  paymentStatus         RetailPaymentStatus @default(UNPAID)
  /// کد سه‌حرفی ارز (ISO 4217) مبالغ این رکورد.
  currency              String             @db.VarChar(3)
  /// مبلغ subtotal برای این سفارش؛ واحد پول در فیلد currency مشخص می‌شود.
  subtotal              Decimal            @default(0) @db.Decimal(20, 2)
  /// مبلغ discountTotal برای این سفارش؛ واحد پول در فیلد currency مشخص می‌شود.
  discountTotal         Decimal            @default(0) @db.Decimal(20, 2)
  /// مبلغ shippingTotal برای این سفارش؛ واحد پول در فیلد currency مشخص می‌شود.
  shippingTotal         Decimal            @default(0) @db.Decimal(20, 2)
  /// مبلغ taxTotal برای این سفارش؛ واحد پول در فیلد currency مشخص می‌شود.
  taxTotal              Decimal            @default(0) @db.Decimal(20, 2)
  /// مبلغ grandTotal برای این سفارش؛ واحد پول در فیلد currency مشخص می‌شود.
  grandTotal            Decimal            @default(0) @db.Decimal(20, 2)
  /// شناسه نشانی مرتبط با این سفارش؛ کلید خارجی به جدول Address است.
  addressId             Int?
  /// ارتباط Prisma با جدول Address (نشانی): رکورد مرتبط مرتبط با سفارش؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  address               Address?           @relation(fields: [addressId], references: [id], onDelete: SetNull)
  /// نام شخص دریافت‌کننده.
  recipientName         String             @db.VarChar(200)
  /// شماره تماس شخص دریافت‌کننده.
  recipientPhone        String             @db.VarChar(40)
  /// استان نشانی.
  province              String             @db.VarChar(120)
  /// شهر نشانی.
  city                  String             @db.VarChar(120)
  /// جزئیات نشانی پستی.
  addressLine           String             @db.VarChar(1000)
  /// کد پستی.
  postalCode            String?            @db.VarChar(30)
  /// کلید یکتای جلوگیری از اجرای تکراری درخواست/عملیات.
  idempotencyKey        String             @unique @db.VarChar(160)
  /// زمان placed این سفارش را ثبت می‌کند.
  placedAt              DateTime           @default(now())
  /// زمان پرداخت موفق.
  paidAt                DateTime?
  /// زمان تکمیل عملیات.
  completedAt            DateTime?
  /// زمان cancelled این سفارش را ثبت می‌کند.
  cancelledAt            DateTime?
  /// زمان ایجاد رکورد.
  createdAt             DateTime           @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt             DateTime           @updatedAt
  /// ارتباط Prisma با جدول User (کاربر): رکورد مرتبط مرتبط با سفارش؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  buyer                 User               @relation(fields: [buyerUserId], references: [id], onDelete: Restrict)
  /// ارتباط Prisma با جدول RetailOrderItem (RetailOrderItem): مجموعه رکوردهای وابسته مرتبط با سفارش؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  items                 RetailOrderItem[]
  /// ارتباط Prisma با جدول SellerOrder (سفارش فروشنده): مجموعه رکوردهای وابسته مرتبط با سفارش؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  sellerOrders          SellerOrder[]
  /// ارتباط Prisma با جدول PaymentAttempt (PaymentAttempt): مجموعه رکوردهای وابسته مرتبط با سفارش؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  paymentAttempts       PaymentAttempt[]
  /// ارتباط Prisma با جدول PaymentTransaction (PaymentTransaction): مجموعه رکوردهای وابسته مرتبط با سفارش؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  paymentTransactions   PaymentTransaction[]
  /// ارتباط Prisma با جدول RetailRefund (RetailRefund): مجموعه رکوردهای وابسته مرتبط با سفارش؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  refunds               RetailRefund[]
  /// ارتباط Prisma با جدول InventoryReservation (InventoryReservation): مجموعه رکوردهای وابسته مرتبط با سفارش؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  reservations          InventoryReservation[]
  /// ارتباط Prisma با جدول ReturnRequest (ReturnRequest): مجموعه رکوردهای وابسته مرتبط با سفارش؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  returns               ReturnRequest[]
  /// ارتباط Prisma با جدول FinanceInvoice (FinanceInvoice): مجموعه رکوردهای وابسته مرتبط با سفارش؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  invoices              FinanceInvoice[]

  @@index([buyerUserId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])

}

/// بخش سفارش متعلق به یک فروشنده از سفارش اصلی، همراه با وضعیت و مبالغ فروشنده.
model SellerOrder {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id                 Int              @id @default(autoincrement())
  /// شناسه سفارش مرتبط با این سفارش فروشنده؛ کلید خارجی به جدول RetailOrder است.
  orderId            Int
  /// شناسه شرکت مرتبط با این سفارش فروشنده؛ کلید خارجی به جدول Company است.
  companyId           Int
  /// مقدار متنی sellerOrderNumber برای توصیف یا شناسایی سفارش فروشنده.
  sellerOrderNumber   String           @unique @db.VarChar(48)
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status              SellerOrderStatus @default(PENDING_ACCEPTANCE)
  /// کد سه‌حرفی ارز (ISO 4217) مبالغ این رکورد.
  currency            String           @db.VarChar(3)
  /// مبلغ subtotal برای این سفارش فروشنده؛ واحد پول در فیلد currency مشخص می‌شود.
  subtotal            Decimal          @default(0) @db.Decimal(20, 2)
  /// مبلغ discountTotal برای این سفارش فروشنده؛ واحد پول در فیلد currency مشخص می‌شود.
  discountTotal       Decimal          @default(0) @db.Decimal(20, 2)
  /// مبلغ shippingTotal برای این سفارش فروشنده؛ واحد پول در فیلد currency مشخص می‌شود.
  shippingTotal       Decimal          @default(0) @db.Decimal(20, 2)
  /// مبلغ taxTotal برای این سفارش فروشنده؛ واحد پول در فیلد currency مشخص می‌شود.
  taxTotal            Decimal          @default(0) @db.Decimal(20, 2)
  /// مبلغ sellerNetTotal برای این سفارش فروشنده؛ واحد پول در فیلد currency مشخص می‌شود.
  sellerNetTotal      Decimal          @default(0) @db.Decimal(20, 2)
  /// مقدار متنی companyNameSnapshot برای توصیف یا شناسایی سفارش فروشنده.
  companyNameSnapshot String           @db.VarChar(240)
  /// مقدار متنی companyIdSnapshot برای توصیف یا شناسایی سفارش فروشنده.
  companyIdSnapshot   String?          @db.VarChar(80)
  /// زمان accepted این سفارش فروشنده را ثبت می‌کند.
  acceptedAt          DateTime?
  /// زمان shipped این سفارش فروشنده را ثبت می‌کند.
  shippedAt           DateTime?
  /// زمان delivered این سفارش فروشنده را ثبت می‌کند.
  deliveredAt         DateTime?
  /// زمان ایجاد رکورد.
  createdAt           DateTime         @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt           DateTime         @updatedAt
  /// ارتباط Prisma با جدول RetailOrder (سفارش): رکورد مرتبط مرتبط با سفارش فروشنده؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  order               RetailOrder      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// ارتباط Prisma با جدول Company (شرکت): رکورد مرتبط مرتبط با سفارش فروشنده؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  company             Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  /// ارتباط Prisma با جدول RetailOrderItem (RetailOrderItem): مجموعه رکوردهای وابسته مرتبط با سفارش فروشنده؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  items               RetailOrderItem[]
  /// ارتباط Prisma با جدول Shipment (Shipment): مجموعه رکوردهای وابسته مرتبط با سفارش فروشنده؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  shipments           Shipment[]
  /// ارتباط Prisma با جدول ReturnRequest (ReturnRequest): مجموعه رکوردهای وابسته مرتبط با سفارش فروشنده؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  returns             ReturnRequest[]
  /// ارتباط Prisma با جدول RetailRefund (RetailRefund): مجموعه رکوردهای وابسته مرتبط با سفارش فروشنده؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  refunds             RetailRefund[]
  /// ارتباط Prisma با جدول CommissionSnapshot (CommissionSnapshot): رکورد مرتبط مرتبط با سفارش فروشنده؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  commissionSnapshot  CommissionSnapshot?
  /// ارتباط Prisma با جدول SellerPayable (SellerPayable): رکورد مرتبط مرتبط با سفارش فروشنده؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  sellerPayable       SellerPayable?
  /// ارتباط Prisma با جدول FinanceInvoice (FinanceInvoice): مجموعه رکوردهای وابسته مرتبط با سفارش فروشنده؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  invoices            FinanceInvoice[]

  @@unique([orderId, companyId])
  @@unique([id, orderId])
  @@index([companyId, status, createdAt])
  @@index([orderId, status])

}

