  /// ارتباط Prisma با جدول User (کاربر): رکورد مرتبط مرتبط با NotificationPreference؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventType, channel])
  @@index([userId])
