  owner       User           @relation("CRMAccountOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  /// ارتباط Prisma با جدول CRMContact (CRMContact): مجموعه رکوردهای وابسته مرتبط با CRMAccount؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  contacts    CRMContact[]
  /// ارتباط Prisma با جدول Lead (سرنخ فروش): مجموعه رکوردهای وابسته مرتبط با CRMAccount؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  leads       Lead[]
  /// ارتباط Prisma با جدول Opportunity (فرصت فروش): مجموعه رکوردهای وابسته مرتبط با CRMAccount؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  opportunities Opportunity[]
  /// ارتباط Prisma با جدول CRMActivity (CRMActivity): مجموعه رکوردهای وابسته مرتبط با CRMAccount؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  activities  CRMActivity[]
  /// ارتباط Prisma با جدول CRMTask (CRMTask): مجموعه رکوردهای وابسته مرتبط با CRMAccount؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  tasks       CRMTask[]
  /// ارتباط Prisma با جدول CRMNote (CRMNote): مجموعه رکوردهای وابسته مرتبط با CRMAccount؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  notesLog    CRMNote[]

  @@index([ownerUserId, updatedAt])
