  description String        @db.VarChar(500)
  /// مقدار متنی location برای توصیف یا شناسایی TrackingEvent.
  location    String?       @db.VarChar(240)
  /// زمان وقوع رویداد در منبع.
  occurredAt  DateTime
  /// زمان ایجاد رکورد.
  createdAt   DateTime      @default(now())
  /// ارتباط Prisma با جدول Shipment (Shipment): رکورد مرتبط مرتبط با TrackingEvent؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  shipment    Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])

}

/// درخواست مرجوعی خریدار برای سفارش یا بخش فروشنده.
model ReturnRequest {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id              Int          @id @default(autoincrement())
  /// شناسه سفارش فروشنده مرتبط با این ReturnRequest؛ کلید خارجی به جدول SellerOrder است.
  orderId         Int
  /// شناسه سفارش فروشنده مرتبط با این ReturnRequest؛ کلید خارجی به جدول SellerOrder است.
  sellerOrderId   Int
  /// شناسه کاربر مرتبط با این ReturnRequest؛ کلید خارجی به جدول User است.
  buyerUserId     Int
  /// مقدار متنی returnNumber برای توصیف یا شناسایی ReturnRequest.
  returnNumber    String       @unique @db.VarChar(40)
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status          ReturnStatus @default(REQUESTED)
  /// علت درخواست، تغییر وضعیت یا تصمیم.
  reason          String       @db.VarChar(1000)
  /// زمان ثبت درخواست.
  requestedAt     DateTime     @default(now())
  /// زمان دریافت رویداد یا درخواست.
  receivedAt      DateTime?
