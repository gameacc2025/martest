generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

/// نقش‌های قابل تخصیص به کاربران و زمینه مجاز هر نقش (کارمند، شرکت یا مشتری).
model Role {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id          Int              @id @default(autoincrement())
  /// نام قابل نمایش موجودیت.
  name        String           @unique
  /// برچسب یا عنوان کوتاه قابل نمایش.
  label       String
  /// شرح تکمیلی موجودیت.
  description String?
  /// سیستمی بودن رکورد و محدودیت مدیریت عادی آن.
  isSystem    Boolean          @default(false)
  // Which domain this role belongs to (STAFF / COMPANY / CUSTOMER). Set
  // explicitly when the role is created — NOT inferred from the role name.
  // This is what lets a brand-new custom role (e.g. "COMPANY_ACCOUNTANT")
  // be correctly recognized as a company-scoped role without any code
  // change, and is the source of truth for GET /roles/assignable and for
  // the role-scope check in user.service.js createUser().
  /// محدوده اعتبار یا نمایش رکورد.
  scope       RoleScope
  /// زمان ایجاد رکورد.
  createdAt   DateTime         @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt   DateTime         @updatedAt
  /// ارتباط Prisma با جدول RolePermission (اتصال نقش و مجوز): مجموعه رکوردهای وابسته مرتبط با نقش؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  permissions RolePermission[]
  /// ارتباط Prisma با جدول UserRole (تخصیص نقش): مجموعه رکوردهای وابسته مرتبط با نقش؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  users       UserRole[]

  @@index([isSystem])
  @@index([scope])
}

enum RoleScope {
  STAFF
  COMPANY
  CUSTOMER
}

/// فهرست مجوزهای ریزدانه و عملیات قابل کنترل در بخش‌های مختلف سامانه.
model Permission {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id          Int     @id @default(autoincrement())
  /// نام قابل نمایش موجودیت.
  name        String  @unique
  /// برچسب یا عنوان کوتاه قابل نمایش.
  label       String
  /// شرح تکمیلی موجودیت.
  description String?
  /// گروه منطقی برای دسته‌بندی این مجوز/مقدار.
  group       String?

  /// زمان ایجاد رکورد.
  createdAt DateTime @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt DateTime @updatedAt

  /// ارتباط Prisma با جدول RolePermission (اتصال نقش و مجوز): مجموعه رکوردهای وابسته مرتبط با مجوز؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  roles RolePermission[]

  @@index([group])
}

/// رابط چندبه‌چند نقش و مجوز؛ هر رکورد یک مجوز اعطاشده به یک نقش را ثبت می‌کند.
model RolePermission {
  /// شناسه نقش مرتبط با این اتصال نقش و مجوز؛ کلید خارجی به جدول Role است.
  roleId       Int
  /// شناسه مجوز مرتبط با این اتصال نقش و مجوز؛ کلید خارجی به جدول Permission است.
  permissionId Int
  /// زمان assigned این اتصال نقش و مجوز را ثبت می‌کند.
  assignedAt   DateTime   @default(now())
  /// ارتباط Prisma با جدول Permission (مجوز): رکورد مرتبط مرتبط با اتصال نقش و مجوز؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  /// ارتباط Prisma با جدول Role (نقش): رکورد مرتبط مرتبط با اتصال نقش و مجوز؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

/// رابط تخصیص نقش به کاربر و زمان اعطای نقش.
model UserRole {
  /// شناسه کاربر مرتبط با این تخصیص نقش؛ کلید خارجی به جدول User است.
  userId     Int
  /// شناسه نقش مرتبط با این تخصیص نقش؛ کلید خارجی به جدول Role است.
  roleId     Int
  /// زمان assigned این تخصیص نقش را ثبت می‌کند.
  assignedAt DateTime @default(now())
  /// ارتباط Prisma با جدول Role (نقش): رکورد مرتبط مرتبط با تخصیص نقش؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  /// ارتباط Prisma با جدول User (کاربر): رکورد مرتبط مرتبط با تخصیص نقش؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

/// زمینه دسترسی کاربر به برنامه و شرکت وابسته به آن، در صورت وجود.
model AccessProfile {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id        Int               @id @default(autoincrement())
  /// شناسه کاربر مرتبط با این زمینه دسترسی؛ کلید خارجی به جدول User است.
  userId    Int               @unique
  /// مقدار type برای نگهداری اطلاعات مرتبط با زمینه دسترسی.
  type      AccessProfileType
  /// شناسه شرکت مرتبط با این زمینه دسترسی؛ کلید خارجی به جدول Company است.
  companyId Int?
  /// فعال یا غیرفعال بودن رکورد.
  isActive  Boolean           @default(true)
  /// زمان ایجاد رکورد.
  createdAt DateTime          @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt DateTime          @updatedAt

  /// ارتباط Prisma با جدول User (کاربر): رکورد مرتبط مرتبط با زمینه دسترسی؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  user      User              @relation(fields:[userId], references:[id], onDelete:Cascade)
  /// ارتباط Prisma با جدول Company (شرکت): رکورد مرتبط مرتبط با زمینه دسترسی؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  company   Company?          @relation(fields:[companyId], references:[id])

  @@index([type])
  @@index([companyId])
}

/// اطلاعات شخصی و نمایشی کاربر که از اطلاعات ورود جدا نگهداری می‌شود.
model Profile {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id        Int      @id @default(autoincrement())
  /// شناسه کاربر مرتبط با این پروفایل؛ کلید خارجی به جدول User است.
  userId    Int      @unique
  /// نام کوچک کاربر.
  firstName String?
  /// نام خانوادگی کاربر.
  lastName  String?
  /// نشانی یا کلید تصویر نمایه کاربر.
  avatar    String?
  /// داده‌های تکمیلی ساختاریافته و وابسته به دامنه در قالب JSON.
  metadata  Json?
  /// زمان ایجاد رکورد.
  createdAt DateTime @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt DateTime @updatedAt
  /// ارتباط Prisma با جدول User (کاربر): رکورد مرتبط مرتبط با پروفایل؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// اطلاعات هویتی، ثبتی، تماس، نوع فعالیت و وضعیت شرکت‌های عضو بازارگاه.
model Company {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id                  Int                  @id @default(autoincrement())
  /// نام قابل نمایش موجودیت.
  name                String               @unique
  /// نام انگلیسی موجودیت.
  nameEn              String?
  /// شناسه ملی شرکت/شخص برای شناسایی و تطبیق.
  nationalId          String?              @unique
  /// شماره ثبت قانونی شرکت.
  registrationNumber  String?
  /// مقدار type برای نگهداری اطلاعات مرتبط با شرکت.
  type                CompanyType?
  /// شرح تکمیلی موجودیت.
  description         String?
  /// نشانی یا کلید فایل لوگو.
  logo                String?
  /// نشانی ایمیل مرتبط.
  email               String?
  /// شماره تماس مرتبط.
  phone               String?
  /// نشانی متنی یا اطلاعات آدرس.
  address             String?
  /// نشانی وب‌سایت رسمی.
  website             String?
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status              CompanyStatus        @default(PENDING)
  /// تأیید شدن هویت یا اطلاعات این موجودیت.
  isVerified          Boolean              @default(false)
  /// زمان ایجاد رکورد.
  createdAt           DateTime             @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt           DateTime             @updatedAt
  /// زمان حذف نرم؛ مقدار NULL یعنی رکورد حذف نرم نشده است.
  deletedAt           DateTime?
  /// ارتباط Prisma با جدول AccessProfile (زمینه دسترسی): مجموعه رکوردهای وابسته مرتبط با شرکت؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  accessProfiles      AccessProfile[]
  /// ارتباط Prisma با جدول Product (محصول): مجموعه رکوردهای وابسته مرتبط با شرکت؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  products            Product[]
  /// ارتباط Prisma با جدول Inquiry (استعلام): مجموعه رکوردهای وابسته مرتبط با شرکت؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  inquiries           Inquiry[]
  /// ارتباط Prisma با جدول InquiryResponse (InquiryResponse): مجموعه رکوردهای وابسته مرتبط با شرکت؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  responses           InquiryResponse[]
  /// ارتباط Prisma با جدول CompanyInquiryLimit (CompanyInquiryLimit): رکورد مرتبط مرتبط با شرکت؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  inquiryLimit        CompanyInquiryLimit?
  /// ارتباط Prisma با جدول CompanyLimit (CompanyLimit): مجموعه رکوردهای وابسته مرتبط با شرکت؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  limits              CompanyLimit[]
  /// ارتباط Prisma با جدول InquirySubscription (InquirySubscription): مجموعه رکوردهای وابسته مرتبط با شرکت؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  inquirySubscriptions InquirySubscription[]
  /// ارتباط Prisma با جدول InquiryMessage (InquiryMessage): مجموعه رکوردهای وابسته مرتبط با شرکت؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  sentInquiryMessages InquiryMessage[] @relation("InquiryMessageSenderCompany")
  /// ارتباط Prisma با جدول InquiryMessage (InquiryMessage): مجموعه رکوردهای وابسته مرتبط با شرکت؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  receivedInquiryMessages InquiryMessage[] @relation("InquiryMessageRecipientCompany")
  /// ارتباط Prisma با جدول AuditLog (AuditLog): مجموعه رکوردهای وابسته مرتبط با شرکت؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  auditLogs AuditLog[] @relation("AuditCompany")
  /// ارتباط Prisma با جدول SupportTicket (تیکت پشتیبانی): مجموعه رکوردهای وابسته مرتبط با شرکت؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  supportTickets SupportTicket[]
  /// ارتباط Prisma با جدول CRMAccount (CRMAccount): مجموعه رکوردهای وابسته مرتبط با شرکت؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  crmAccounts CRMAccount[]
  /// ارتباط Prisma با جدول SellerOrder (سفارش فروشنده): مجموعه رکوردهای وابسته مرتبط با شرکت؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  sellerOrders SellerOrder[]
  /// ارتباط Prisma با جدول CommissionRule (CommissionRule): مجموعه رکوردهای وابسته مرتبط با شرکت؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  commissionRules CommissionRule[]
  /// ارتباط Prisma با جدول SellerPayable (SellerPayable): مجموعه رکوردهای وابسته مرتبط با شرکت؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  sellerPayables SellerPayable[]
  /// ارتباط Prisma با جدول Settlement (تسویه): مجموعه رکوردهای وابسته مرتبط با شرکت؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  settlements Settlement[]
  /// ارتباط Prisma با جدول FinanceInvoice (FinanceInvoice): مجموعه رکوردهای وابسته مرتبط با شرکت؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  financeInvoices FinanceInvoice[]

  @@index([status])
  @@index([deletedAt])
  @@index([isVerified])
  @@index([nationalId])
}

/// هویت ورود حساب کاربری، وضعیت حساب و ارتباط آن با فعالیت‌های سامانه.
model User {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id            Int              @id @default(autoincrement())
  /// نشانی ایمیل مرتبط.
  email         String?          @unique
  /// شماره تماس مرتبط.
  phone         String           @unique
  /// هش رمز عبور؛ رمز خام نباید ذخیره شود.
  passwordHash  String
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status        UserStatus       @default(ACTIVE)
  /// زمان ایجاد رکورد.
  createdAt     DateTime         @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt     DateTime         @updatedAt

  /// ارتباط Prisma با جدول Profile (پروفایل): رکورد مرتبط مرتبط با کاربر؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  profile       Profile?
  /// ارتباط Prisma با جدول AccessProfile (زمینه دسترسی): رکورد مرتبط مرتبط با کاربر؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  accessProfile   AccessProfile?
  /// ارتباط Prisma با جدول UserRole (تخصیص نقش): مجموعه رکوردهای وابسته مرتبط با کاربر؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  roles         UserRole[]
  /// ارتباط Prisma با جدول RefreshToken (RefreshToken): مجموعه رکوردهای وابسته مرتبط با کاربر؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  refreshTokens RefreshToken[]
  /// ارتباط Prisma با جدول HandoffCode (HandoffCode): مجموعه رکوردهای وابسته مرتبط با کاربر؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  handoffCodes  HandoffCode[]
  /// ارتباط Prisma با جدول Notification (اعلان): مجموعه رکوردهای وابسته مرتبط با کاربر؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  notifications Notification[]
  /// ارتباط Prisma با جدول NotificationPreference (NotificationPreference): مجموعه رکوردهای وابسته مرتبط با کاربر؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  notificationPreferences NotificationPreference[]
  /// ارتباط Prisma با جدول NotificationDelivery (NotificationDelivery): مجموعه رکوردهای وابسته مرتبط با کاربر؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  notificationDeliveries  NotificationDelivery[]
  /// ارتباط Prisma با جدول Product (محصول): مجموعه رکوردهای وابسته مرتبط با کاربر؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  products      Product[]        @relation("ProductCreatedBy")
  /// ارتباط Prisma با جدول ProductStatusHistory (ProductStatusHistory): مجموعه رکوردهای وابسته مرتبط با کاربر؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  productStatusChanges ProductStatusHistory[]
  /// ارتباط Prisma با جدول ProductActivityLog (ProductActivityLog): مجموعه رکوردهای وابسته مرتبط با کاربر؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  productActivityLogs ProductActivityLog[]
  /// ارتباط Prisma با جدول InquiryStatusHistory (InquiryStatusHistory): مجموعه رکوردهای وابسته مرتبط با کاربر؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  inquiryStatusChanges InquiryStatusHistory[]
  /// ارتباط Prisma با جدول Inquiry (استعلام): مجموعه رکوردهای وابسته مرتبط با کاربر؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  buyerInquiries      Inquiry[]          @relation("InquiryBuyer")
  /// ارتباط Prisma با جدول InquirySubscription (InquirySubscription): مجموعه رکوردهای وابسته مرتبط با کاربر؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  inquirySubscriptions InquirySubscription[]
  /// ارتباط Prisma با جدول InquiryMessage (InquiryMessage): مجموعه رکوردهای وابسته مرتبط با کاربر؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  sentInquiryMessages InquiryMessage[] @relation("InquiryMessageSenderUser")
  /// ارتباط Prisma با جدول InquiryMessage (InquiryMessage): مجموعه رکوردهای وابسته مرتبط با کاربر؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  receivedInquiryMessages InquiryMessage[] @relation("InquiryMessageRecipientUser")
  /// ارتباط Prisma با جدول Address (نشانی): مجموعه رکوردهای وابسته مرتبط با کاربر؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  addresses                Address[]
  /// ارتباط Prisma با جدول AuthChallenge (AuthChallenge): مجموعه رکوردهای وابسته مرتبط با کاربر؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  authChallenges AuthChallenge[]
  /// ارتباط Prisma با جدول AuditLog (AuditLog): مجموعه رکوردهای وابسته مرتبط با کاربر؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  auditLogs AuditLog[] @relation("AuditActor")
