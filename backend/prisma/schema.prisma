  /// نشانی ایمیل مرتبط.
  email              String?       @db.VarChar(320)
  /// شماره تماس مرتبط.
  phone              String?       @db.VarChar(40)
  /// شناسه LeadSource مرتبط با این سرنخ فروش؛ کلید خارجی به جدول LeadSource است.
  sourceId           Int?
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status             CRMLeadStatus @default(NEW)
  /// مقدار عددی score برای سرنخ فروش.
  score              Int           @default(0)
  /// شناسه کاربر مرتبط با این سرنخ فروش؛ کلید خارجی به جدول User است.
  ownerUserId        Int
  /// شناسه CRMAccount مرتبط با این سرنخ فروش؛ کلید خارجی به جدول CRMAccount است.
  convertedAccountId Int?
  /// شناسه کاربر مرتبط با این سرنخ فروش؛ کلید خارجی به جدول User است.
  convertedByUserId  Int?
  /// زمان converted این سرنخ فروش را ثبت می‌کند.
  convertedAt        DateTime?
  /// مقدار متنی disqualifiedReason برای توصیف یا شناسایی سرنخ فروش.
  disqualifiedReason String?       @db.VarChar(500)
  /// زمان ایجاد رکورد.
  createdAt          DateTime      @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt          DateTime      @updatedAt
  /// ارتباط Prisma با جدول LeadSource (LeadSource): رکورد مرتبط مرتبط با سرنخ فروش؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  source             LeadSource?   @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  /// ارتباط Prisma با جدول User (کاربر): رکورد مرتبط مرتبط با سرنخ فروش؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  owner              User          @relation("CRMLeadOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  /// ارتباط Prisma با جدول CRMAccount (CRMAccount): رکورد مرتبط مرتبط با سرنخ فروش؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  convertedAccount   CRMAccount?   @relation(fields: [convertedAccountId], references: [id], onDelete: SetNull)
  /// ارتباط Prisma با جدول User (کاربر): رکورد مرتبط مرتبط با سرنخ فروش؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  convertedBy        User?         @relation("CRMLeadConverter", fields: [convertedByUserId], references: [id], onDelete: SetNull)
  /// ارتباط Prisma با جدول CRMActivity (CRMActivity): مجموعه رکوردهای وابسته مرتبط با سرنخ فروش؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  activities         CRMActivity[]
  /// ارتباط Prisma با جدول CRMTask (CRMTask): مجموعه رکوردهای وابسته مرتبط با سرنخ فروش؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  tasks              CRMTask[]
  /// ارتباط Prisma با جدول CRMNote (CRMNote): مجموعه رکوردهای وابسته مرتبط با سرنخ فروش؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  notesLog           CRMNote[]

  @@index([ownerUserId, status, updatedAt])
  @@index([sourceId, createdAt])
  @@index([status, score])
  @@index([phone])
  @@index([email])

}

/// تعریف قیف فروش CRM و تعیین قیف فعال یا پیش‌فرض.
model Pipeline {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id        Int             @id @default(autoincrement())
  /// نام قابل نمایش موجودیت.
  name      String          @db.VarChar(120)
  /// پیش‌فرض بودن این گزینه یا رکورد.
  isDefault Boolean         @default(false)
  /// فعال یا غیرفعال بودن رکورد.
  isActive  Boolean         @default(true)
  /// زمان ایجاد رکورد.
  createdAt DateTime        @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt DateTime        @updatedAt
  /// ارتباط Prisma با جدول PipelineStage (PipelineStage): مجموعه رکوردهای وابسته مرتبط با Pipeline؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  stages    PipelineStage[]
  /// ارتباط Prisma با جدول Opportunity (فرصت فروش): مجموعه رکوردهای وابسته مرتبط با Pipeline؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  opportunities Opportunity[]

  @@index([isActive, isDefault])

}

/// مراحل هر قیف فروش با ترتیب و احتمال موفقیت و نشانگر برد/باخت.
model PipelineStage {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id             Int          @id @default(autoincrement())
  /// شناسه Pipeline مرتبط با این PipelineStage؛ کلید خارجی به جدول Pipeline است.
  pipelineId     Int
  /// کد ماشینی یا تجاری این موجودیت.
  code           String       @db.VarChar(60)
  /// برچسب یا عنوان کوتاه قابل نمایش.
  label          String       @db.VarChar(120)
  /// ترتیب نمایش رکورد.
  sortOrder      Int          @default(0)
  /// مقدار عددی probability برای PipelineStage.
  probability    Int          @default(0)
  /// مشخص می‌کند آیا isWon برای این PipelineStage فعال یا مجاز است.
  isWon          Boolean      @default(false)
  /// مشخص می‌کند آیا isLost برای این PipelineStage فعال یا مجاز است.
  isLost         Boolean      @default(false)
  /// ارتباط Prisma با جدول Pipeline (Pipeline): رکورد مرتبط مرتبط با PipelineStage؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  pipeline       Pipeline     @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  /// ارتباط Prisma با جدول Opportunity (فرصت فروش): مجموعه رکوردهای وابسته مرتبط با PipelineStage؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  opportunities  Opportunity[]
  /// ارتباط Prisma با جدول OpportunityStageHistory (OpportunityStageHistory): مجموعه رکوردهای وابسته مرتبط با PipelineStage؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  fromHistories  OpportunityStageHistory[] @relation("OpportunityFromStage")
  /// ارتباط Prisma با جدول OpportunityStageHistory (OpportunityStageHistory): مجموعه رکوردهای وابسته مرتبط با PipelineStage؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  toHistories    OpportunityStageHistory[] @relation("OpportunityToStage")

  @@unique([pipelineId, code])
  @@unique([pipelineId, sortOrder])
  @@unique([id, pipelineId])
  @@index([pipelineId, isWon, isLost])

}

/// فرصت فروش مرتبط با حساب CRM، مبلغ، ارز، مرحله و مسئول آن.
model Opportunity {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id                Int                  @id @default(autoincrement())
  /// مقدار متنی opportunityNumber برای توصیف یا شناسایی فرصت فروش.
  opportunityNumber String               @unique @db.VarChar(32)
  /// شناسه CRMAccount مرتبط با این فرصت فروش؛ کلید خارجی به جدول CRMAccount است.
  accountId         Int
  /// شناسه PipelineStage مرتبط با این فرصت فروش؛ کلید خارجی به جدول PipelineStage است.
  pipelineId        Int
  /// شناسه PipelineStage مرتبط با این فرصت فروش؛ کلید خارجی به جدول PipelineStage است.
  stageId           Int
  /// شناسه کاربر مرتبط با این فرصت فروش؛ کلید خارجی به جدول User است.
  ownerUserId       Int
  /// عنوان اصلی قابل نمایش.
  title             String               @db.VarChar(240)
  /// مبلغ مالی این رکورد.
  amount            Decimal              @default(0) @db.Decimal(20, 2)
  /// کد سه‌حرفی ارز (ISO 4217) مبالغ این رکورد.
  currency          String               @default("IRR") @db.VarChar(3)
  /// زمان expectedClose این فرصت فروش را ثبت می‌کند.
  expectedCloseAt   DateTime?
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status            CRMOpportunityStatus @default(OPEN)
  /// زمان بسته‌شدن پرونده یا فرآیند.
  closedAt          DateTime?
  /// زمان ایجاد رکورد.
  createdAt         DateTime             @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt         DateTime             @updatedAt
  /// ارتباط Prisma با جدول CRMAccount (CRMAccount): رکورد مرتبط مرتبط با فرصت فروش؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  account           CRMAccount           @relation(fields: [accountId], references: [id], onDelete: Restrict)
  /// ارتباط Prisma با جدول Pipeline (Pipeline): رکورد مرتبط مرتبط با فرصت فروش؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  pipeline          Pipeline             @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  /// ارتباط Prisma با جدول PipelineStage (PipelineStage): رکورد مرتبط مرتبط با فرصت فروش؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  stage             PipelineStage        @relation(fields: [stageId, pipelineId], references: [id, pipelineId], onDelete: Restrict)
  /// ارتباط Prisma با جدول User (کاربر): رکورد مرتبط مرتبط با فرصت فروش؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  owner             User                 @relation("OpportunityOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  /// ارتباط Prisma با جدول OpportunityStageHistory (OpportunityStageHistory): مجموعه رکوردهای وابسته مرتبط با فرصت فروش؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  stageHistory      OpportunityStageHistory[]
  /// ارتباط Prisma با جدول CRMActivity (CRMActivity): مجموعه رکوردهای وابسته مرتبط با فرصت فروش؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  activities        CRMActivity[]
  /// ارتباط Prisma با جدول CRMTask (CRMTask): مجموعه رکوردهای وابسته مرتبط با فرصت فروش؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  tasks             CRMTask[]
  /// ارتباط Prisma با جدول CRMNote (CRMNote): مجموعه رکوردهای وابسته مرتبط با فرصت فروش؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  notesLog          CRMNote[]

  @@index([accountId, status])
  @@index([ownerUserId, status, expectedCloseAt])
  @@index([pipelineId, stageId])
  @@index([status, expectedCloseAt])

}

/// تاریخچه جابه‌جایی فرصت فروش میان مراحل قیف.
model OpportunityStageHistory {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id            Int          @id @default(autoincrement())
  /// شناسه فرصت فروش مرتبط با این OpportunityStageHistory؛ کلید خارجی به جدول Opportunity است.
  opportunityId Int
  /// شناسه PipelineStage مرتبط با این OpportunityStageHistory؛ کلید خارجی به جدول PipelineStage است.
  fromStageId   Int?
  /// شناسه PipelineStage مرتبط با این OpportunityStageHistory؛ کلید خارجی به جدول PipelineStage است.
  toStageId     Int
  /// شناسه کاربر مرتبط با این OpportunityStageHistory؛ کلید خارجی به جدول User است.
  actorUserId   Int
  /// علت درخواست، تغییر وضعیت یا تصمیم.
  reason        String?      @db.VarChar(500)
  /// زمان ایجاد رکورد.
  createdAt     DateTime     @default(now())
  /// ارتباط Prisma با جدول Opportunity (فرصت فروش): رکورد مرتبط مرتبط با OpportunityStageHistory؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  opportunity   Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  /// ارتباط Prisma با جدول PipelineStage (PipelineStage): رکورد مرتبط مرتبط با OpportunityStageHistory؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  fromStage     PipelineStage? @relation("OpportunityFromStage", fields: [fromStageId], references: [id], onDelete: SetNull)
  /// ارتباط Prisma با جدول PipelineStage (PipelineStage): رکورد مرتبط مرتبط با OpportunityStageHistory؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  toStage       PipelineStage @relation("OpportunityToStage", fields: [toStageId], references: [id], onDelete: Restrict)
  /// ارتباط Prisma با جدول User (کاربر): رکورد مرتبط مرتبط با OpportunityStageHistory؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  actor         User         @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([opportunityId, createdAt])
  @@index([actorUserId, createdAt])

}

/// فعالیت‌های ارتباطی و فروش مانند تماس، جلسه یا پیگیری و نتیجه آن.
model CRMActivity {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id             BigInt          @id @default(autoincrement())
  /// مقدار type برای نگهداری اطلاعات مرتبط با CRMActivity.
  type           CRMActivityType
  /// مقدار متنی subject برای توصیف یا شناسایی CRMActivity.
  subject        String          @db.VarChar(240)
  /// متن کامل پیام، یادداشت یا محتوای رکورد.
  body           String?
  /// زمان وقوع رویداد در منبع.
  occurredAt     DateTime        @default(now())
  /// مدت فعالیت بر حسب دقیقه.
  durationMinutes Int?
  /// نتیجه فعالیت یا عملیات.
  outcome        String?         @db.VarChar(500)
  /// شناسه کاربر مرتبط با این CRMActivity؛ کلید خارجی به جدول User است.
  actorUserId    Int
  /// شناسه CRMAccount مرتبط با این CRMActivity؛ کلید خارجی به جدول CRMAccount است.
  accountId      Int?
  /// شناسه سرنخ فروش مرتبط با این CRMActivity؛ کلید خارجی به جدول Lead است.
  leadId         Int?
  /// شناسه فرصت فروش مرتبط با این CRMActivity؛ کلید خارجی به جدول Opportunity است.
  opportunityId  Int?
  /// زمان ایجاد رکورد.
  createdAt      DateTime        @default(now())
  /// ارتباط Prisma با جدول User (کاربر): رکورد مرتبط مرتبط با CRMActivity؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  actor          User            @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  /// ارتباط Prisma با جدول CRMAccount (CRMAccount): رکورد مرتبط مرتبط با CRMActivity؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  account        CRMAccount?     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// ارتباط Prisma با جدول Lead (سرنخ فروش): رکورد مرتبط مرتبط با CRMActivity؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  lead           Lead?           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  /// ارتباط Prisma با جدول Opportunity (فرصت فروش): رکورد مرتبط مرتبط با CRMActivity؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  opportunity    Opportunity?    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([accountId, occurredAt])
  @@index([leadId, occurredAt])
  @@index([opportunityId, occurredAt])
  @@index([actorUserId, occurredAt])

}

/// وظایف پیگیری CRM با مسئول، اولویت، وضعیت و مهلت انجام.
model CRMTask {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id             Int            @id @default(autoincrement())
  /// عنوان اصلی قابل نمایش.
  title          String         @db.VarChar(240)
  /// شرح تکمیلی موجودیت.
  description    String?
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status         CRMTaskStatus  @default(OPEN)
  /// اولویت رسیدگی یا پردازش.
  priority       CRMTaskPriority @default(NORMAL)
  /// شناسه کاربر مرتبط با این CRMTask؛ کلید خارجی به جدول User است.
  assigneeUserId Int
  /// شناسه کاربر مرتبط با این CRMTask؛ کلید خارجی به جدول User است.
  createdByUserId Int
  /// مهلت انجام یا سررسید عملیات.
  dueAt          DateTime?
  /// زمان تکمیل عملیات.
  completedAt    DateTime?
  /// شناسه CRMAccount مرتبط با این CRMTask؛ کلید خارجی به جدول CRMAccount است.
  accountId      Int?
  /// شناسه سرنخ فروش مرتبط با این CRMTask؛ کلید خارجی به جدول Lead است.
  leadId         Int?
  /// شناسه فرصت فروش مرتبط با این CRMTask؛ کلید خارجی به جدول Opportunity است.
  opportunityId  Int?
  /// زمان ایجاد رکورد.
  createdAt      DateTime       @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt      DateTime       @updatedAt
  /// ارتباط Prisma با جدول User (کاربر): رکورد مرتبط مرتبط با CRMTask؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  assignee       User           @relation("CRMTaskAssignee", fields: [assigneeUserId], references: [id], onDelete: Restrict)
  /// ارتباط Prisma با جدول User (کاربر): رکورد مرتبط مرتبط با CRMTask؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  createdBy      User           @relation("CRMTaskCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  /// ارتباط Prisma با جدول CRMAccount (CRMAccount): رکورد مرتبط مرتبط با CRMTask؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  account        CRMAccount?    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// ارتباط Prisma با جدول Lead (سرنخ فروش): رکورد مرتبط مرتبط با CRMTask؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  lead           Lead?          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  /// ارتباط Prisma با جدول Opportunity (فرصت فروش): رکورد مرتبط مرتبط با CRMTask؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  opportunity    Opportunity?   @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([assigneeUserId, status, dueAt])
  @@index([createdByUserId, createdAt])
  @@index([accountId, status])
  @@index([leadId, status])
  @@index([opportunityId, status])

}

/// یادداشت‌های مرتبط با حساب، سرنخ یا فرصت همراه با سطح مشاهده.
model CRMNote {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id             BigInt            @id @default(autoincrement())
  /// متن کامل پیام، یادداشت یا محتوای رکورد.
  body           String
  /// سطح مشاهده و دسترسی به محتوا.
  visibility     CRMNoteVisibility @default(TEAM)
  /// شناسه کاربر مرتبط با این CRMNote؛ کلید خارجی به جدول User است.
  authorUserId   Int
  /// شناسه CRMAccount مرتبط با این CRMNote؛ کلید خارجی به جدول CRMAccount است.
  accountId      Int?
  /// شناسه سرنخ فروش مرتبط با این CRMNote؛ کلید خارجی به جدول Lead است.
  leadId         Int?
  /// شناسه فرصت فروش مرتبط با این CRMNote؛ کلید خارجی به جدول Opportunity است.
  opportunityId  Int?
  /// زمان ایجاد رکورد.
  createdAt      DateTime          @default(now())
  /// ارتباط Prisma با جدول User (کاربر): رکورد مرتبط مرتبط با CRMNote؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  author         User              @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  /// ارتباط Prisma با جدول CRMAccount (CRMAccount): رکورد مرتبط مرتبط با CRMNote؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  account        CRMAccount?       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// ارتباط Prisma با جدول Lead (سرنخ فروش): رکورد مرتبط مرتبط با CRMNote؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  lead           Lead?             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  /// ارتباط Prisma با جدول Opportunity (فرصت فروش): رکورد مرتبط مرتبط با CRMNote؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  opportunity    Opportunity?      @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@index([leadId, createdAt])
  @@index([opportunityId, createdAt])
  @@index([authorUserId, createdAt])

}

