/// چالش یک‌بارمصرف احراز هویت/بازیابی حساب؛ فقط هش راز ذخیره و انقضا و تعداد تلاش کنترل می‌شود.
model AuthChallenge {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id           Int                  @id @default(autoincrement())
  /// شناسه کاربر مرتبط با این AuthChallenge؛ کلید خارجی به جدول User است.
  userId       Int
  /// هدف استفاده از چالش/کد.
  purpose      AuthChallengePurpose
  /// کانال ارسال یا دریافت.
  channel      AuthChallengeChannel
  /// مقصد ارسال کد یا پیام مانند شماره تلفن یا ایمیل.
  destination  String               @db.VarChar(320)
  /// هش راز/کد یک‌بارمصرف؛ مقدار خام ذخیره نمی‌شود.
  secretHash   String               @unique @db.VarChar(255)
  /// زمان انقضای اعتبار رکورد یا توکن.
  expiresAt    DateTime
  /// زمان مصرف‌شدن چالش یک‌بارمصرف یا رزرو موجودی.
  consumedAt   DateTime?
  /// تعداد تلاش‌های انجام‌شده.
  attemptCount Int                  @default(0)
  /// حداکثر تعداد تلاش مجاز.
  maxAttempts  Int                  @default(5)
  /// زمان باطل‌شدن چالش احراز هویت پیش از مصرف یا انقضا.
  invalidatedAt DateTime?
  /// زمان ایجاد رکورد.
  createdAt    DateTime             @default(now())
  /// رابطه Prisma با جدول User (کاربر)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
  @@index([destination, purpose, createdAt])

}

/// رخدادهای ممیزی عملیات؛ عامل، شرکت، موجودیت هدف، نتیجه و مشخصات درخواست را به‌صورت ثبت غیرقابل‌ویرایش نگه می‌دارد.
model AuditLog {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id                BigInt    @id @default(autoincrement())
  /// شناسه کاربر مرتبط با این AuditLog؛ کلید خارجی به جدول User است.
  actorUserId       Int?
  /// نوع زمینه دسترسی عامل ثبت‌کننده رخداد ممیزی.
  actorAccessType   String?   @db.VarChar(20)
  /// شناسه شرکت مرتبط با این AuditLog؛ کلید خارجی به جدول Company است.
  companyId         Int?
  /// نوع اقدام انجام‌شده.
  action            String    @db.VarChar(120)
  /// نام نوع موجودیت هدف عملیات ممیزی.
  entityType        String    @db.VarChar(100)
  /// شناسه رکورد هدف در موجودیت ثبت‌شده در entityType.
  entityId          String    @db.VarChar(100)
  /// شناسه هم‌بستگی درخواست برای ردگیری در لاگ‌ها.
  requestId         String?   @db.VarChar(100)
  /// منبع ایجاد یا ثبت رکورد.
  source            String?   @db.VarChar(40)
  /// نتیجه فعالیت یا عملیات.
  outcome           String    @default("SUCCESS") @db.VarChar(20)
  /// سطح اهمیت رخداد برای فیلتر و گزارش‌گیری ممیزی.
  severity          String    @default("INFO") @db.VarChar(20)
  /// نشانی IP مبدأ درخواست برای ممیزی/امنیت.
  ipAddress         String?   @db.VarChar(64)
  /// مشخصات مرورگر یا کلاینت درخواست‌دهنده.
  userAgent         String?   @db.VarChar(500)
  /// داده‌های تکمیلی ساختاریافته و وابسته به دامنه در قالب JSON.
  metadata          Json?
  /// زمان وقوع رویداد در منبع.
  occurredAt        DateTime  @default(now())
  /// رابطه Prisma با جدول User (کاربر)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  actor             User?     @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  /// رابطه Prisma با جدول Company (شرکت)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  company           Company?  @relation("AuditCompany", fields: [companyId], references: [id], onDelete: Restrict)

  @@index([actorUserId, occurredAt])
  @@index([companyId, occurredAt])
  @@index([entityType, entityId, occurredAt])
  @@index([action, occurredAt])
  @@index([requestId])
  @@index([severity, occurredAt])

}

