/// چالش یک‌بارمصرف احراز هویت/بازیابی حساب؛ فقط هش راز ذخیره و انقضا و تعداد تلاش کنترل می‌شود.
model AuthChallenge {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id           Int                  @id @default(autoincrement())
  /// شناسه کاربر مرتبط با این AuthChallenge؛ کلید خارجی به جدول User است.
  userId       Int
  /// هدف استفاده از چالش/کد.
  purpose      AuthChallengePurpose
  /// کانال ارسال یا دریافت.
  channel      AuthChallengeChannel
  /// مقصد ارسال کد یا پیام مانند شماره تلفن یا ایمیل.
  destination  String               @db.VarChar(320)
  /// هش راز/کد یک‌بارمصرف؛ مقدار خام ذخیره نمی‌شود.
  secretHash   String               @unique @db.VarChar(255)
  /// زمان انقضای اعتبار رکورد یا توکن.
  expiresAt    DateTime
  /// زمان consumed این AuthChallenge را ثبت می‌کند.
  consumedAt   DateTime?
  /// تعداد دفعات تلاش انجام‌شده.
  attemptCount Int                  @default(0)
  /// حداکثر تعداد تلاش مجاز.
  maxAttempts  Int                  @default(5)
  /// زمان invalidated این AuthChallenge را ثبت می‌کند.
  invalidatedAt DateTime?
  /// زمان ایجاد رکورد.
  createdAt    DateTime             @default(now())
  /// ارتباط Prisma با جدول User (کاربر): رکورد مرتبط مرتبط با AuthChallenge؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
  @@index([destination, purpose, createdAt])

}

/// رخدادهای ممیزی عملیات؛ عامل، شرکت، موجودیت هدف، نتیجه و مشخصات درخواست را به‌صورت ثبت غیرقابل‌ویرایش نگه می‌دارد.
model AuditLog {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id                BigInt    @id @default(autoincrement())
  /// شناسه کاربر مرتبط با این AuditLog؛ کلید خارجی به جدول User است.
  actorUserId       Int?
  /// مقدار متنی actorAccessType برای توصیف یا شناسایی AuditLog.
  actorAccessType   String?   @db.VarChar(20)
  /// شناسه شرکت مرتبط با این AuditLog؛ کلید خارجی به جدول Company است.
  companyId         Int?
  /// نوع اقدام انجام‌شده.
  action            String    @db.VarChar(120)
  /// مقدار متنی entityType برای توصیف یا شناسایی AuditLog.
  entityType        String    @db.VarChar(100)
  /// شناسه رکورد مرتبط برای اتصال این AuditLog به موجودیت مرجع.
  entityId          String    @db.VarChar(100)
  /// شناسه هم‌بستگی درخواست برای ردگیری در لاگ‌ها.
  requestId         String?   @db.VarChar(100)
  /// منبع ایجاد یا ثبت رکورد.
  source            String?   @db.VarChar(40)
  /// نتیجه فعالیت یا عملیات.
  outcome           String    @default("SUCCESS") @db.VarChar(20)
  /// نشانی IP مبدأ درخواست برای ممیزی/امنیت.
  ipAddress         String?   @db.VarChar(64)
  /// مشخصات مرورگر یا کلاینت درخواست‌دهنده.
  userAgent         String?   @db.VarChar(500)
  /// داده‌های تکمیلی ساختاریافته و وابسته به دامنه در قالب JSON.
  metadata          Json?
  /// زمان وقوع رویداد در منبع.
  occurredAt        DateTime  @default(now())
  /// ارتباط Prisma با جدول User (کاربر): رکورد مرتبط مرتبط با AuditLog؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  actor             User?     @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  /// ارتباط Prisma با جدول Company (شرکت): رکورد مرتبط مرتبط با AuditLog؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  company           Company?  @relation("AuditCompany", fields: [companyId], references: [id], onDelete: Restrict)

  @@index([actorUserId, occurredAt])
  @@index([companyId, occurredAt])
  @@index([entityType, entityId, occurredAt])
  @@index([action, occurredAt])
  @@index([requestId])

}

// ============================================================================
// DB-2 — Multi-tenant support and ticketing
// ============================================================================
enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  WAITING_COMPANY
  RESOLVED
  CLOSED
  SPAM
}

enum SupportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportMessageVisibility {
  PUBLIC
  INTERNAL
}

enum SupportCreatedFrom {
  WEBSITE
  COMPANY
  ADMIN
}

enum SupportAttachmentStatus {
  PENDING_SCAN
  AVAILABLE
  REJECTED
}

/// صف‌های کاری تیم پشتیبانی برای دسته‌بندی و ارجاع تیکت‌ها.
model SupportQueue {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id          Int      @id @default(autoincrement())
  /// کلید ماشینی تنظیم یا گزینه.
  key         String   @unique @db.VarChar(60)
  /// نام قابل نمایش موجودیت.
  name        String   @db.VarChar(120)
  /// شرح تکمیلی موجودیت.
  description String?
  /// فعال یا غیرفعال بودن رکورد.
  isActive    Boolean  @default(true)
  /// ترتیب نمایش رکورد.
  sortOrder   Int      @default(0)
  /// زمان ایجاد رکورد.
  createdAt   DateTime @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt   DateTime @updatedAt
  /// ارتباط Prisma با جدول SupportTicket (تیکت پشتیبانی): مجموعه رکوردهای وابسته مرتبط با SupportQueue؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  tickets     SupportTicket[]
  /// ارتباط Prisma با جدول SupportAssignment (SupportAssignment): مجموعه رکوردهای وابسته مرتبط با SupportQueue؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  assignments SupportAssignment[]

  @@index([isActive, sortOrder])

}

/// دسته‌بندی موضوعی تیکت‌های پشتیبانی و مبنای اتصال سیاست SLA.
model SupportCategory {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id          Int      @id @default(autoincrement())
  /// کلید ماشینی تنظیم یا گزینه.
  key         String   @unique @db.VarChar(60)
  /// نام قابل نمایش موجودیت.
  name        String   @db.VarChar(120)
  /// شرح تکمیلی موجودیت.
  description String?
  /// فعال یا غیرفعال بودن رکورد.
  isActive    Boolean  @default(true)
  /// ترتیب نمایش رکورد.
  sortOrder   Int      @default(0)
  /// زمان ایجاد رکورد.
  createdAt   DateTime @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt   DateTime @updatedAt
  /// ارتباط Prisma با جدول SupportTicket (تیکت پشتیبانی): مجموعه رکوردهای وابسته مرتبط با SupportCategory؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  tickets     SupportTicket[]
  /// ارتباط Prisma با جدول SupportSlaPolicy (SupportSlaPolicy): مجموعه رکوردهای وابسته مرتبط با SupportCategory؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  slaPolicies SupportSlaPolicy[]

  @@index([isActive, sortOrder])

}

/// زمان هدف پاسخ اولیه و حل تیکت بر اساس دسته و اولویت.
model SupportSlaPolicy {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id                    Int             @id @default(autoincrement())
  /// شناسه SupportCategory مرتبط با این SupportSlaPolicy؛ کلید خارجی به جدول SupportCategory است.
  categoryId            Int?
  /// اولویت رسیدگی یا پردازش.
  priority              SupportPriority
  /// مقدار عددی firstResponseMinutes برای SupportSlaPolicy.
  firstResponseMinutes  Int
  /// مقدار عددی resolutionMinutes برای SupportSlaPolicy.
  resolutionMinutes     Int
  /// تعریف تقویم/ساعات کاری مورد استفاده برای محاسبه SLA.
  workingCalendar        Json?
  /// فعال یا غیرفعال بودن رکورد.
  isActive              Boolean         @default(true)
  /// زمان ایجاد رکورد.
  createdAt             DateTime        @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt             DateTime        @updatedAt
  /// ارتباط Prisma با جدول SupportCategory (SupportCategory): رکورد مرتبط مرتبط با SupportSlaPolicy؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  category              SupportCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, priority])
  @@index([isActive, priority])

}

/// پرونده اصلی درخواست پشتیبانی شامل درخواست‌کننده، موضوع، وضعیت، اولویت، مسئول و مهلت‌های SLA.
model SupportTicket {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id                    Int                 @id @default(autoincrement())
  /// مقدار متنی ticketNumber برای توصیف یا شناسایی تیکت پشتیبانی.
  ticketNumber          String              @unique @db.VarChar(32)
  /// شناسه کاربر مرتبط با این تیکت پشتیبانی؛ کلید خارجی به جدول User است.
  requesterUserId       Int
  /// شناسه شرکت مرتبط با این تیکت پشتیبانی؛ کلید خارجی به جدول Company است.
  requesterCompanyId    Int?
  /// شناسه SupportCategory مرتبط با این تیکت پشتیبانی؛ کلید خارجی به جدول SupportCategory است.
  categoryId            Int?
  /// شناسه SupportQueue مرتبط با این تیکت پشتیبانی؛ کلید خارجی به جدول SupportQueue است.
  assignedQueueId       Int?
  /// شناسه کاربر مرتبط با این تیکت پشتیبانی؛ کلید خارجی به جدول User است.
  assignedUserId        Int?
  /// مقدار createdFrom برای نگهداری اطلاعات مرتبط با تیکت پشتیبانی.
  createdFrom           SupportCreatedFrom
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status                SupportTicketStatus @default(OPEN)
  /// اولویت رسیدگی یا پردازش.
  priority              SupportPriority     @default(NORMAL)
  /// مقدار متنی subject برای توصیف یا شناسایی تیکت پشتیبانی.
  subject               String              @db.VarChar(200)
  /// مهلت هدف اولین پاسخ طبق SLA.
  firstResponseDueAt    DateTime?
  /// مهلت هدف حل تیکت طبق SLA.
  resolveDueAt          DateTime?
  /// زمان اولین پاسخ کارشناسی به تیکت.
  firstRespondedAt      DateTime?
  /// زمان resolved این تیکت پشتیبانی را ثبت می‌کند.
  resolvedAt            DateTime?
  /// زمان بسته‌شدن پرونده یا فرآیند.
  closedAt              DateTime?
  /// زمان lastActivity این تیکت پشتیبانی را ثبت می‌کند.
  lastActivityAt        DateTime            @default(now())
  /// زمان ایجاد رکورد.
  createdAt             DateTime            @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt             DateTime            @updatedAt
  /// ارتباط Prisma با جدول User (کاربر): رکورد مرتبط مرتبط با تیکت پشتیبانی؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  requester             User                @relation("SupportRequester", fields: [requesterUserId], references: [id], onDelete: Restrict)
  /// ارتباط Prisma با جدول Company (شرکت): رکورد مرتبط مرتبط با تیکت پشتیبانی؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  requesterCompany      Company?            @relation(fields: [requesterCompanyId], references: [id], onDelete: Restrict)
  /// ارتباط Prisma با جدول SupportCategory (SupportCategory): رکورد مرتبط مرتبط با تیکت پشتیبانی؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  category              SupportCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// ارتباط Prisma با جدول SupportQueue (SupportQueue): رکورد مرتبط مرتبط با تیکت پشتیبانی؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  assignedQueue         SupportQueue?        @relation(fields: [assignedQueueId], references: [id], onDelete: SetNull)
  /// ارتباط Prisma با جدول User (کاربر): رکورد مرتبط مرتبط با تیکت پشتیبانی؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  assignedUser          User?               @relation("SupportCurrentAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  /// ارتباط Prisma با جدول SupportMessage (SupportMessage): مجموعه رکوردهای وابسته مرتبط با تیکت پشتیبانی؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  messages              SupportMessage[]
  /// ارتباط Prisma با جدول SupportAssignment (SupportAssignment): مجموعه رکوردهای وابسته مرتبط با تیکت پشتیبانی؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  assignments           SupportAssignment[]
  /// ارتباط Prisma با جدول SupportStatusHistory (SupportStatusHistory): مجموعه رکوردهای وابسته مرتبط با تیکت پشتیبانی؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  statusHistory         SupportStatusHistory[]
  /// ارتباط Prisma با جدول SupportEvent (SupportEvent): مجموعه رکوردهای وابسته مرتبط با تیکت پشتیبانی؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  events                SupportEvent[]

  @@index([requesterUserId, status, updatedAt])
  @@index([requesterCompanyId, status, updatedAt])
  @@index([assignedQueueId, status, priority, lastActivityAt])
  @@index([assignedUserId, status, priority])
  @@index([status, priority, firstResponseDueAt])
  @@index([status, resolveDueAt])
  @@index([categoryId])

}

/// پیام‌های تیکت پشتیبانی با مشخص بودن نویسنده و سطح مشاهده عمومی/داخلی.
model SupportMessage {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id          Int                       @id @default(autoincrement())
  /// شناسه تیکت پشتیبانی مرتبط با این SupportMessage؛ کلید خارجی به جدول SupportTicket است.
  ticketId    Int
  /// شناسه کاربر مرتبط با این SupportMessage؛ کلید خارجی به جدول User است.
  senderUserId Int
  /// سطح مشاهده و دسترسی به محتوا.
  visibility  SupportMessageVisibility  @default(PUBLIC)
  /// متن کامل پیام، یادداشت یا محتوای رکورد.
  body        String                    @db.VarChar(10000)
  /// زمان ایجاد رکورد.
  createdAt   DateTime                  @default(now())
  /// ارتباط Prisma با جدول SupportTicket (تیکت پشتیبانی): رکورد مرتبط مرتبط با SupportMessage؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  ticket      SupportTicket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  /// ارتباط Prisma با جدول User (کاربر): رکورد مرتبط مرتبط با SupportMessage؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  sender      User                      @relation(fields: [senderUserId], references: [id], onDelete: Restrict)
  /// ارتباط Prisma با جدول SupportAttachment (SupportAttachment): مجموعه رکوردهای وابسته مرتبط با SupportMessage؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  attachments SupportAttachment[]

  @@index([ticketId, createdAt])
  @@index([senderUserId, createdAt])
  @@index([ticketId, visibility, createdAt])

}

/// فراداده فایل پیوست پیام پشتیبانی شامل مسیر ذخیره، نوع، اندازه و وضعیت بررسی.
model SupportAttachment {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id             Int                     @id @default(autoincrement())
  /// شناسه SupportMessage مرتبط با این SupportAttachment؛ کلید خارجی به جدول SupportMessage است.
  messageId      Int
  /// شناسه کاربر مرتبط با این SupportAttachment؛ کلید خارجی به جدول User است.
  uploadedByUserId Int
  /// کلید فایل در فضای ذخیره‌سازی؛ خود فایل در دیتابیس ذخیره نمی‌شود.
  storageKey     String                  @unique @db.VarChar(500)
  /// نام اصلی فایل پیش از ذخیره‌سازی.
  originalName   String                  @db.VarChar(255)
  /// نوع رسانه‌ای فایل (MIME type).
  mimeType       String                  @db.VarChar(150)
  /// اندازه فایل بر حسب بایت.
  sizeBytes      BigInt
  /// چکیده محتوای فایل برای بررسی یکپارچگی.
  checksum       String?                 @db.VarChar(128)
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status         SupportAttachmentStatus @default(PENDING_SCAN)
  /// زمان ایجاد رکورد.
  createdAt      DateTime                @default(now())
  /// ارتباط Prisma با جدول SupportMessage (SupportMessage): رکورد مرتبط مرتبط با SupportAttachment؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  message        SupportMessage          @relation(fields: [messageId], references: [id], onDelete: Cascade)
  /// ارتباط Prisma با جدول User (کاربر): رکورد مرتبط مرتبط با SupportAttachment؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  uploadedBy     User                    @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  @@index([messageId])
  @@index([uploadedByUserId, createdAt])
  @@index([status, createdAt])

}

/// تاریخچه ارجاع تیکت به صف یا کارشناس با زمان شروع و پایان تخصیص.
model SupportAssignment {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id                 Int          @id @default(autoincrement())
  /// شناسه تیکت پشتیبانی مرتبط با این SupportAssignment؛ کلید خارجی به جدول SupportTicket است.
  ticketId           Int
  /// شناسه SupportQueue مرتبط با این SupportAssignment؛ کلید خارجی به جدول SupportQueue است.
  queueId            Int?
  /// شناسه کاربر مرتبط با این SupportAssignment؛ کلید خارجی به جدول User است.
  assignedUserId     Int?
  /// شناسه کاربر مرتبط با این SupportAssignment؛ کلید خارجی به جدول User است.
  assignedByUserId   Int
  /// علت درخواست، تغییر وضعیت یا تصمیم.
  reason             String?      @db.VarChar(500)
  /// زمان assigned این SupportAssignment را ثبت می‌کند.
  assignedAt         DateTime     @default(now())
  /// زمان ended این SupportAssignment را ثبت می‌کند.
  endedAt            DateTime?
  /// ارتباط Prisma با جدول SupportTicket (تیکت پشتیبانی): رکورد مرتبط مرتبط با SupportAssignment؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  ticket             SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  /// ارتباط Prisma با جدول SupportQueue (SupportQueue): رکورد مرتبط مرتبط با SupportAssignment؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  queue              SupportQueue? @relation(fields: [queueId], references: [id], onDelete: SetNull)
  /// ارتباط Prisma با جدول User (کاربر): رکورد مرتبط مرتبط با SupportAssignment؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  assignee           User?        @relation("SupportAssignmentAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  /// ارتباط Prisma با جدول User (کاربر): رکورد مرتبط مرتبط با SupportAssignment؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  assignedBy         User         @relation("SupportAssignmentActor", fields: [assignedByUserId], references: [id], onDelete: Restrict)

  @@index([ticketId, assignedAt])
  @@index([assignedUserId, endedAt])
  @@index([queueId, endedAt])

}

/// تاریخچه تغییر وضعیت تیکت همراه با عامل و دلیل تغییر.
model SupportStatusHistory {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id          Int                 @id @default(autoincrement())
  /// شناسه تیکت پشتیبانی مرتبط با این SupportStatusHistory؛ کلید خارجی به جدول SupportTicket است.
  ticketId    Int
  /// مقدار previous برای نگهداری اطلاعات مرتبط با SupportStatusHistory.
  previous    SupportTicketStatus?
  /// مقدار next برای نگهداری اطلاعات مرتبط با SupportStatusHistory.
  next        SupportTicketStatus
  /// شناسه کاربر مرتبط با این SupportStatusHistory؛ کلید خارجی به جدول User است.
  actorUserId Int?
  /// علت درخواست، تغییر وضعیت یا تصمیم.
  reason      String?             @db.VarChar(1000)
  /// زمان ایجاد رکورد.
  createdAt   DateTime            @default(now())
  /// ارتباط Prisma با جدول SupportTicket (تیکت پشتیبانی): رکورد مرتبط مرتبط با SupportStatusHistory؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  ticket      SupportTicket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  /// ارتباط Prisma با جدول User (کاربر): رکورد مرتبط مرتبط با SupportStatusHistory؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  actor       User?               @relation("SupportStatusActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@index([actorUserId, createdAt])

}

/// رویدادهای دامنه پشتیبانی برای پردازش و جلوگیری از اجرای تکراری.
model SupportEvent {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id             BigInt    @id @default(autoincrement())
  /// شناسه تیکت پشتیبانی مرتبط با این SupportEvent؛ کلید خارجی به جدول SupportTicket است.
  ticketId       Int?
  /// شناسه کاربر مرتبط با این SupportEvent؛ کلید خارجی به جدول User است.
  actorUserId    Int?
  /// نوع رویداد ثبت‌شده.
  eventType      String    @db.VarChar(100)
  /// کلید تشخیص و جلوگیری از ثبت/پردازش تکراری رویداد.
  dedupeKey      String?   @unique @db.VarChar(160)
  /// بدنه ساختاریافته یا خام رویداد دریافتی/داخلی.
  payload        Json?
  /// زمان وقوع رویداد در منبع.
  occurredAt     DateTime  @default(now())
  /// زمان پایان پردازش رویداد/عملیات.
  processedAt    DateTime?
  /// ارتباط Prisma با جدول SupportTicket (تیکت پشتیبانی): رکورد مرتبط مرتبط با SupportEvent؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
  ticket         SupportTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  /// ارتباط Prisma با جدول User (کاربر): رکورد مرتبط مرتبط با SupportEvent؛ این فیلد رابطه‌ای است و ستون مستقل در PostgreSQL ایجاد نمی‌کند.
