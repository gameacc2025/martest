generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

/// نقش‌های قابل تخصیص به کاربران و زمینه مجاز هر نقش (کارمند، شرکت یا مشتری).
model Role {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id          Int              @id @default(autoincrement())
  /// نام قابل نمایش موجودیت.
  name        String           @unique
  /// برچسب یا عنوان کوتاه قابل نمایش.
  label       String
  /// شرح تکمیلی موجودیت.
  description String?
  /// سیستمی بودن رکورد و محدودیت مدیریت عادی آن.
  isSystem    Boolean          @default(false)
  // Which domain this role belongs to (STAFF / COMPANY / CUSTOMER). Set
  // explicitly when the role is created — NOT inferred from the role name.
  // This is what lets a brand-new custom role (e.g. "COMPANY_ACCOUNTANT")
  // be correctly recognized as a company-scoped role without any code
  // change, and is the source of truth for GET /roles/assignable and for
  // the role-scope check in user.service.js createUser().
  /// محدوده اعتبار یا نمایش رکورد.
  scope       RoleScope
  /// زمان ایجاد رکورد.
  createdAt   DateTime         @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt   DateTime         @updatedAt
  /// رابطه Prisma با جدول RolePermission (اتصال نقش و مجوز)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  permissions RolePermission[]
  /// رابطه Prisma با جدول UserRole (تخصیص نقش)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  users       UserRole[]

  @@index([isSystem])
  @@index([scope])
}

enum RoleScope {
  STAFF
  COMPANY
  CUSTOMER
}

/// فهرست مجوزهای ریزدانه و عملیات قابل کنترل در بخش‌های مختلف سامانه.
model Permission {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id          Int     @id @default(autoincrement())
  /// نام قابل نمایش موجودیت.
  name        String  @unique
  /// برچسب یا عنوان کوتاه قابل نمایش.
  label       String
  /// شرح تکمیلی موجودیت.
  description String?
  /// گروه منطقی برای دسته‌بندی این مجوز/مقدار.
  group       String?

  /// زمان ایجاد رکورد.
  createdAt DateTime @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt DateTime @updatedAt

  /// رابطه Prisma با جدول RolePermission (اتصال نقش و مجوز)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  roles RolePermission[]

  @@index([group])
}

/// رابط چندبه‌چند نقش و مجوز؛ هر رکورد یک مجوز اعطاشده به یک نقش را ثبت می‌کند.
model RolePermission {
  /// شناسه نقش مرتبط با این اتصال نقش و مجوز؛ کلید خارجی به جدول Role است.
  roleId       Int
  /// شناسه مجوز مرتبط با این اتصال نقش و مجوز؛ کلید خارجی به جدول Permission است.
  permissionId Int
  /// زمان شروع تخصیص این نقش یا مسئولیت.
  assignedAt   DateTime   @default(now())
  /// رابطه Prisma با جدول Permission (مجوز)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  /// رابطه Prisma با جدول Role (نقش)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

/// رابط تخصیص نقش به کاربر و زمان اعطای نقش.
model UserRole {
  /// شناسه کاربر مرتبط با این تخصیص نقش؛ کلید خارجی به جدول User است.
  userId     Int
  /// شناسه نقش مرتبط با این تخصیص نقش؛ کلید خارجی به جدول Role است.
  roleId     Int
  /// زمان شروع تخصیص این نقش یا مسئولیت.
  assignedAt DateTime @default(now())
  /// رابطه Prisma با جدول Role (نقش)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  /// رابطه Prisma با جدول User (کاربر)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

/// زمینه دسترسی کاربر به برنامه و شرکت وابسته به آن، در صورت وجود.
model AccessProfile {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id        Int               @id @default(autoincrement())
  /// شناسه کاربر مرتبط با این زمینه دسترسی؛ کلید خارجی به جدول User است.
  userId    Int               @unique
  /// نوع یا طبقه‌بندی رکورد؛ مقادیر مجاز در Enum یا قرارداد دامنه تعریف شده‌اند.
  type      AccessProfileType
  /// شناسه شرکت مرتبط با این زمینه دسترسی؛ کلید خارجی به جدول Company است.
  companyId Int?
  /// فعال یا غیرفعال بودن رکورد.
  isActive  Boolean           @default(true)
  /// زمان ایجاد رکورد.
  createdAt DateTime          @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt DateTime          @updatedAt

  /// رابطه Prisma با جدول User (کاربر)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  user      User              @relation(fields:[userId], references:[id], onDelete:Cascade)
  /// رابطه Prisma با جدول Company (شرکت)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  company   Company?          @relation(fields:[companyId], references:[id])

  @@index([type])
  @@index([companyId])
}

/// اطلاعات شخصی و نمایشی کاربر که از اطلاعات ورود جدا نگهداری می‌شود.
model Profile {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id        Int      @id @default(autoincrement())
  /// شناسه کاربر مرتبط با این پروفایل؛ کلید خارجی به جدول User است.
  userId    Int      @unique
  /// نام کوچک کاربر.
  firstName String?
  /// نام خانوادگی کاربر.
  lastName  String?
  /// نشانی یا کلید تصویر نمایه کاربر.
  avatar    String?
  /// داده‌های تکمیلی ساختاریافته و وابسته به دامنه در قالب JSON.
  metadata  Json?
  /// زمان ایجاد رکورد.
  createdAt DateTime @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt DateTime @updatedAt
  /// رابطه Prisma با جدول User (کاربر)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// اطلاعات هویتی، ثبتی، تماس، نوع فعالیت و وضعیت شرکت‌های عضو بازارگاه.
model Company {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id                  Int                  @id @default(autoincrement())
  /// نام قابل نمایش موجودیت.
  name                String               @unique
  /// نام انگلیسی موجودیت.
  nameEn              String?
  /// شناسه ملی شرکت/شخص برای شناسایی و تطبیق.
  nationalId          String?              @unique
  /// شماره ثبت قانونی شرکت.
  registrationNumber  String?
  /// نوع یا طبقه‌بندی رکورد؛ مقادیر مجاز در Enum یا قرارداد دامنه تعریف شده‌اند.
  type                CompanyType?
  /// شرح تکمیلی موجودیت.
  description         String?
  /// نشانی یا کلید فایل لوگو.
  logo                String?
  /// نشانی ایمیل مرتبط.
  email               String?
  /// شماره تماس مرتبط.
  phone               String?
  /// نشانی متنی یا اطلاعات آدرس.
  address             String?
  /// نشانی وب‌سایت رسمی.
  website             String?
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status              CompanyStatus        @default(PENDING)
  /// تأیید شدن هویت یا اطلاعات این موجودیت.
  isVerified          Boolean              @default(false)
  /// زمان ایجاد رکورد.
  createdAt           DateTime             @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt           DateTime             @updatedAt
  /// زمان حذف نرم؛ NULL یعنی رکورد حذف نرم نشده است.
  deletedAt           DateTime?
  /// رابطه Prisma با جدول AccessProfile (زمینه دسترسی)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  accessProfiles      AccessProfile[]
  /// رابطه Prisma با جدول Product (محصول)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  products            Product[]
  /// رابطه Prisma با جدول Inquiry (استعلام)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  inquiries           Inquiry[]
  /// رابطه Prisma با جدول InquiryResponse (InquiryResponse)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  responses           InquiryResponse[]
  /// رابطه Prisma با جدول CompanyInquiryLimit (CompanyInquiryLimit)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  inquiryLimit        CompanyInquiryLimit?
  /// رابطه Prisma با جدول CompanyLimit (CompanyLimit)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  limits              CompanyLimit[]
  /// رابطه Prisma با جدول InquirySubscription (InquirySubscription)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  inquirySubscriptions InquirySubscription[]
  /// رابطه Prisma با جدول InquiryMessage (InquiryMessage)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  sentInquiryMessages InquiryMessage[] @relation("InquiryMessageSenderCompany")
  /// رابطه Prisma با جدول InquiryMessage (InquiryMessage)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  receivedInquiryMessages InquiryMessage[] @relation("InquiryMessageRecipientCompany")
  /// رابطه Prisma با جدول AuditLog (AuditLog)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  auditLogs AuditLog[] @relation("AuditCompany")
  /// رابطه Prisma با جدول SupportTicket (تیکت پشتیبانی)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  supportTickets SupportTicket[]
  /// رابطه Prisma با جدول CRMAccount (CRMAccount)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  crmAccounts CRMAccount[]
  /// رابطه Prisma با جدول SellerOrder (سفارش فروشنده)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  sellerOrders SellerOrder[]
  /// رابطه Prisma با جدول CommissionRule (CommissionRule)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  commissionRules CommissionRule[]
  /// رابطه Prisma با جدول SellerPayable (SellerPayable)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  sellerPayables SellerPayable[]
  /// رابطه Prisma با جدول Settlement (تسویه)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  settlements Settlement[]
  /// رابطه Prisma با جدول FinanceInvoice (FinanceInvoice)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  financeInvoices FinanceInvoice[]

  @@index([status])
  @@index([deletedAt])
  @@index([isVerified])
  @@index([nationalId])
}

/// هویت ورود حساب کاربری، وضعیت حساب و ارتباط آن با فعالیت‌های سامانه.
model User {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id            Int              @id @default(autoincrement())
  /// نشانی ایمیل مرتبط.
  email         String?          @unique
  /// شماره تماس مرتبط.
  phone         String           @unique
  /// هش رمز عبور؛ رمز خام نباید ذخیره شود.
  passwordHash  String
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status        UserStatus       @default(ACTIVE)
  /// زمان ایجاد رکورد.
  createdAt     DateTime         @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt     DateTime         @updatedAt

  /// رابطه Prisma با جدول Profile (پروفایل)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  profile       Profile?
  /// رابطه Prisma با جدول AccessProfile (زمینه دسترسی)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  accessProfile   AccessProfile?
  /// رابطه Prisma با جدول UserRole (تخصیص نقش)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  roles         UserRole[]
  /// رابطه Prisma با جدول RefreshToken (RefreshToken)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  refreshTokens RefreshToken[]
  /// رابطه Prisma با جدول HandoffCode (HandoffCode)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  handoffCodes  HandoffCode[]
  /// رابطه Prisma با جدول Notification (اعلان)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  notifications Notification[]
  /// رابطه Prisma با جدول NotificationPreference (NotificationPreference)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  notificationPreferences NotificationPreference[]
  /// رابطه Prisma با جدول NotificationDelivery (NotificationDelivery)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  notificationDeliveries  NotificationDelivery[]
  /// رابطه Prisma با جدول Product (محصول)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  products      Product[]        @relation("ProductCreatedBy")
  /// رابطه Prisma با جدول ProductStatusHistory (ProductStatusHistory)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  productStatusChanges ProductStatusHistory[]
  /// رابطه Prisma با جدول ProductActivityLog (ProductActivityLog)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  productActivityLogs ProductActivityLog[]
  /// رابطه Prisma با جدول InquiryStatusHistory (InquiryStatusHistory)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  inquiryStatusChanges InquiryStatusHistory[]
  /// رابطه Prisma با جدول Inquiry (استعلام)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  buyerInquiries      Inquiry[]          @relation("InquiryBuyer")
  /// رابطه Prisma با جدول InquirySubscription (InquirySubscription)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  inquirySubscriptions InquirySubscription[]
  /// رابطه Prisma با جدول InquiryMessage (InquiryMessage)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  sentInquiryMessages InquiryMessage[] @relation("InquiryMessageSenderUser")
  /// رابطه Prisma با جدول InquiryMessage (InquiryMessage)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  receivedInquiryMessages InquiryMessage[] @relation("InquiryMessageRecipientUser")
  /// رابطه Prisma با جدول Address (نشانی)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  addresses                Address[]
  /// رابطه Prisma با جدول AuthChallenge (AuthChallenge)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  authChallenges AuthChallenge[]
  /// رابطه Prisma با جدول AuditLog (AuditLog)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  auditLogs AuditLog[] @relation("AuditActor")
  /// رابطه Prisma با جدول SupportTicket (تیکت پشتیبانی)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  supportRequestedTickets SupportTicket[] @relation("SupportRequester")
  /// رابطه Prisma با جدول SupportTicket (تیکت پشتیبانی)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  supportCurrentAssignments SupportTicket[] @relation("SupportCurrentAssignee")
  /// رابطه Prisma با جدول SupportMessage (SupportMessage)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  supportMessages SupportMessage[]
  /// رابطه Prisma با جدول SupportAttachment (SupportAttachment)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  supportAttachments SupportAttachment[]
  /// رابطه Prisma با جدول SupportAssignment (SupportAssignment)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  supportAssignmentsReceived SupportAssignment[] @relation("SupportAssignmentAssignee")
  /// رابطه Prisma با جدول SupportAssignment (SupportAssignment)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  supportAssignmentsMade SupportAssignment[] @relation("SupportAssignmentActor")
  /// رابطه Prisma با جدول SupportStatusHistory (SupportStatusHistory)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  supportStatusChanges SupportStatusHistory[] @relation("SupportStatusActor")
  /// رابطه Prisma با جدول SupportEvent (SupportEvent)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  supportEvents SupportEvent[] @relation("SupportEventActor")
  /// رابطه Prisma با جدول Article (مقاله)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  authoredArticles Article[] @relation("ArticleAuthor")
  /// رابطه Prisma با جدول Article (مقاله)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  publishedArticles Article[] @relation("ArticlePublisher")
  /// رابطه Prisma با جدول ArticleRevision (ArticleRevision)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  articleRevisions ArticleRevision[]
  /// رابطه Prisma با جدول ArticleMedia (ArticleMedia)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  uploadedArticleMedia ArticleMedia[] @relation("ArticleMediaUploader")
  /// رابطه Prisma با جدول CRMAccount (CRMAccount)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  crmAccounts CRMAccount[] @relation("CRMAccountUser")
  /// رابطه Prisma با جدول CRMAccount (CRMAccount)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  ownedCrmAccounts CRMAccount[] @relation("CRMAccountOwner")
  /// رابطه Prisma با جدول CRMContact (CRMContact)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  crmContacts CRMContact[]
  /// رابطه Prisma با جدول Lead (سرنخ فروش)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  ownedLeads Lead[] @relation("CRMLeadOwner")
  /// رابطه Prisma با جدول Lead (سرنخ فروش)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  convertedLeads Lead[] @relation("CRMLeadConverter")
  /// رابطه Prisma با جدول Opportunity (فرصت فروش)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  ownedOpportunities Opportunity[] @relation("OpportunityOwner")
  /// رابطه Prisma با جدول CRMActivity (CRMActivity)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  crmActivities CRMActivity[]
  /// رابطه Prisma با جدول CRMTask (CRMTask)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  assignedCrmTasks CRMTask[] @relation("CRMTaskAssignee")
  /// رابطه Prisma با جدول CRMTask (CRMTask)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  createdCrmTasks CRMTask[] @relation("CRMTaskCreator")
  /// رابطه Prisma با جدول CRMNote (CRMNote)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  crmNotes CRMNote[]
  /// رابطه Prisma با جدول InventoryMovement (InventoryMovement)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  inventoryMovements InventoryMovement[]
  /// رابطه Prisma با جدول RetailOrder (سفارش)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  retailOrders RetailOrder[]
  /// رابطه Prisma با جدول InventoryReservation (InventoryReservation)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  inventoryReservations InventoryReservation[]
  /// رابطه Prisma با جدول RetailRefund (RetailRefund)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  retailRefunds RetailRefund[]
  /// رابطه Prisma با جدول ReturnRequest (ReturnRequest)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  returnRequests ReturnRequest[]
  /// رابطه Prisma با جدول JournalEntry (JournalEntry)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  journalEntries JournalEntry[] @relation("JournalEntryCreator")
  /// رابطه Prisma با جدول Settlement (تسویه)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  settlementRequests Settlement[] @relation("SettlementRequester")
  /// رابطه Prisma با جدول SettlementApproval (SettlementApproval)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  settlementApprovals SettlementApproval[]
  /// رابطه Prisma با جدول SettlementPayout (SettlementPayout)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  payoutExecutions SettlementPayout[] @relation("PayoutExecutor")
  /// رابطه Prisma با جدول FinanceInvoice (FinanceInvoice)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  financeInvoices FinanceInvoice[]
  /// رابطه Prisma با جدول OpportunityStageHistory (OpportunityStageHistory)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  opportunityStageChanges OpportunityStageHistory[]

  @@index([email])
  @@index([status])
  @@index([phone])
}

/// نشانی‌های تماس یا تحویل ثبت‌شده توسط کاربر.
model Address {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id             Int      @id @default(autoincrement())
  /// شناسه کاربر مرتبط با این نشانی؛ کلید خارجی به جدول User است.
  userId         Int
  /// برچسب یا عنوان کوتاه قابل نمایش.
  label          String   @default("خانه")
  /// نام شخص دریافت‌کننده.
  recipientName  String
  /// شماره تماس شخص دریافت‌کننده.
  recipientPhone String
  /// استان نشانی.
  province       String
  /// شهر نشانی.
  city           String
  /// جزئیات نشانی پستی.
  addressLine    String
  /// کد پستی.
  postalCode     String?
  /// پیش‌فرض بودن این گزینه یا رکورد.
  isDefault      Boolean  @default(false)
  /// زمان ایجاد رکورد.
  createdAt      DateTime @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt      DateTime @updatedAt
  /// رابطه Prisma با جدول User (کاربر)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// رابطه Prisma با جدول RetailOrder (سفارش)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  retailOrders   RetailOrder[]

  @@index([userId, isDefault])
  @@index([userId, createdAt])
}

/// توکن‌های نوسازی نشست کاربر برای کنترل انقضا و ابطال نشست.
model RefreshToken {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id        Int      @id @default(autoincrement())
  /// توکن نشست/نوسازی؛ دسترسی به آن باید محدود و امن باشد.
  token     String   @unique
  /// شناسه کاربر مرتبط با این RefreshToken؛ کلید خارجی به جدول User است.
  userId    Int
  /// زمان انقضای اعتبار رکورد یا توکن.
  expiresAt DateTime
  /// زمان ایجاد رکورد.
  createdAt DateTime @default(now())
  /// مشخصات مرورگر/دستگاه برای نمایش در مدیریت نشست‌ها.
  userAgent String?
  /// آدرس IP دستگاه برای ممیزی و تشخیص نشست‌های مشکوک.
  ipAddress String?
  /// نام قابل نمایش دستگاه (مثلاً "Chrome on Windows").
  deviceName String?
  /// زمان آخرین فعالیت در این نشست.
  lastUsedAt DateTime?
  /// رابطه Prisma با جدول User (کاربر)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([lastUsedAt])
}

// One-time, PKCE-bound code used to hand a live session from the website
// to the admin/company panel (see handoff.service.js). Stored hashed;
// single-use (deleted atomically on redeem); 60-second TTL.
/// کد موقت انتقال امن نشست میان وب‌سایت و پنل‌ها؛ کد خام ذخیره نمی‌شود.
model HandoffCode {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id        Int      @id @default(autoincrement())
  /// هش کد انتقال؛ کد خام ذخیره نمی‌شود.
  codeHash  String   @unique
  /// شناسه کاربر مرتبط با این HandoffCode؛ کلید خارجی به جدول User است.
  userId    Int
  /// شناسه برنامه مقصد برای انتقال نشست (مانند admin یا company).
  app       String   // 'admin' | 'company'
  /// مقدار challenge رمزنگاری‌شده مرتبط با جریان PKCE.
  challenge String   // base64url(SHA-256(verifier)) supplied by the panel
  /// زمان انقضای اعتبار رکورد یا توکن.
  expiresAt DateTime
  /// زمان ایجاد رکورد.
  createdAt DateTime @default(now())
  /// رابطه Prisma با جدول User (کاربر)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// دسته‌بندی‌های اصلی کاتالوگ محصولات و تنظیمات نمایش آن‌ها.
model Category {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id            Int            @id @default(autoincrement())
  /// شناسه متنی خوانا و یکتای مناسب URL.
  slug          String         @unique
  /// نام فارسی موجودیت.
  nameFa        String
  /// نام انگلیسی موجودیت.
  nameEn        String
  /// نشانی یا کلید تصویر مرتبط.
  image         String?
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status        CategoryStatus @default(ACTIVE)
  /// نمایش دسته‌بندی در منوی عمومی را کنترل می‌کند.
  showInMenu    Boolean        @default(true)
  /// ترتیب نمایش رکورد در میان موارد هم‌گروه.
  sortOrder     Int            @default(0)
  /// زمان ایجاد رکورد.
  createdAt     DateTime       @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt     DateTime       @updatedAt
  /// رابطه Prisma با جدول Subcategory (Subcategory)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  subcategories Subcategory[]
  /// رابطه Prisma با جدول Product (محصول)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  products      Product[]
  /// رابطه Prisma با جدول CommissionRule (CommissionRule)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  commissionRules CommissionRule[]

  @@index([status])
  @@index([showInMenu])
  @@index([sortOrder])
}

/// زیر‌دسته هر دسته اصلی و ارتباط آن با قالب مشخصات و محصولات.
model Subcategory {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id                    Int                               @id @default(autoincrement())
  /// شناسه Category مرتبط با این Subcategory؛ کلید خارجی به جدول Category است.
  categoryId            Int
  /// شناسه متنی خوانا و یکتای مناسب URL.
  slug                  String                            @unique
  /// نام فارسی موجودیت.
  nameFa                String
  /// نام انگلیسی موجودیت.
  nameEn                String
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status                CategoryStatus                    @default(ACTIVE)
  /// ترتیب نمایش رکورد در میان موارد هم‌گروه.
  sortOrder             Int                               @default(0)
  /// زمان ایجاد رکورد.
  createdAt             DateTime                          @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt             DateTime                          @updatedAt
  /// رابطه Prisma با جدول Category (Category)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  category              Category                          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  /// رابطه Prisma با جدول SpecificationTemplate (SpecificationTemplate)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  specificationTemplate SpecificationTemplate?
  /// رابطه Prisma با جدول Product (محصول)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  products              Product[]

  @@index([categoryId])
  @@index([status])
  @@index([sortOrder])
}

/// قالب مشخصات فنی قابل استفاده برای محصولات یک زیر‌دسته.
model SpecificationTemplate {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id            Int                  @id @default(autoincrement())
  /// شناسه Subcategory مرتبط با این SpecificationTemplate؛ کلید خارجی به جدول Subcategory است.
  subcategoryId Int                  @unique
  /// نام قابل نمایش موجودیت.
  name          String
  /// شرح تکمیلی موجودیت.
  description   String?
  /// فعال یا غیرفعال بودن رکورد.
  isActive      Boolean              @default(true)
  /// زمان ایجاد رکورد.
  createdAt     DateTime             @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt     DateTime             @updatedAt
  /// رابطه Prisma با جدول Subcategory (Subcategory)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  subcategory   Subcategory          @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  /// رابطه Prisma با جدول SpecificationField (SpecificationField)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  fields        SpecificationField[]

  @@index([isActive])
}

/// تعریف هر فیلد مشخصات فنی شامل نوع، واحد، اجباری بودن و گزینه‌ها.
model SpecificationField {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id         Int                    @id @default(autoincrement())
  /// شناسه SpecificationTemplate مرتبط با این SpecificationField؛ کلید خارجی به جدول SpecificationTemplate است.
  templateId Int
  /// نام قابل نمایش موجودیت.
  name       String
  /// کلید ماشینی تنظیم یا گزینه.
  key        String
  /// نوع یا طبقه‌بندی رکورد؛ مقادیر مجاز در Enum یا قرارداد دامنه تعریف شده‌اند.
  type       SpecificationFieldType
  /// اجباری بودن تکمیل این فیلد.
  isRequired Boolean                @default(false)
  /// واحد اندازه‌گیری یا فروش.
  unit       String?
  /// فهرست گزینه‌های مجاز برای فیلد انتخابی، در قالب JSON.
  options    Json?
  /// ترتیب نمایش رکورد در میان موارد هم‌گروه.
  sortOrder  Int                    @default(0)
  /// زمان ایجاد رکورد.
  createdAt  DateTime               @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt  DateTime               @updatedAt
  /// رابطه Prisma با جدول SpecificationTemplate (SpecificationTemplate)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  template   SpecificationTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, key])
  @@index([templateId])
  @@index([sortOrder])
}

// Global, reusable specification field library.
// These are NOT attached to any template — they are a shared catalogue
// of predefined fields (توان, ولتاژ, نوع کانکتور, ...) that can be
// referenced when building product `attributes` (via fieldId) or when
// composing subcategory templates.
/// کتابخانه فیلدهای مشخصات فنی قابل استفاده مجدد در قالب‌های مختلف.
model SpecificationLibraryField {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id          Int                    @id @default(autoincrement())
  /// عنوان اصلی قابل نمایش.
  title       String
  /// شناسه متنی خوانا و یکتای مناسب URL.
  slug        String                 @unique
  /// نوع یا طبقه‌بندی رکورد؛ مقادیر مجاز در Enum یا قرارداد دامنه تعریف شده‌اند.
  type        SpecificationFieldType
  /// واحد پیش‌فرض این فیلد مشخصات فنی.
  defaultUnit String?
  /// شرح تکمیلی موجودیت.
  description String?
  /// فعال یا غیرفعال بودن رکورد.
  isActive    Boolean                @default(true)
  /// زمان ایجاد رکورد.
  createdAt   DateTime               @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt   DateTime               @updatedAt

  @@index([isActive])
  @@index([slug])
}


/// اطلاعات اصلی محصول فروشنده شامل مشخصات، دسته‌بندی، مالکیت و وضعیت انتشار.
model Product {

  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id               Int                @id @default(autoincrement())
  /// عنوان اصلی قابل نمایش.
  title            String
  /// شناسه متنی خوانا و یکتای مناسب URL.
  slug             String             @unique
  /// خلاصه کوتاه برای نمایش در فهرست‌ها و کارت‌ها.
  shortDescription String?
  /// شرح تکمیلی موجودیت.
  description      String?
  /// کد داخلی محصول نزد فروشنده.
  sku              String?
  // Shared manufacturer/model identity across supplier listings; not a seller SKU.
  /// شناسه مشترک سازنده/مدل برای تطبیق فهرست‌های هم‌مدل.
  catalogCode      String?
  /// نام برند سازنده یا عرضه‌کننده.
  brand            String?
  /// نام یا شماره مدل محصول.
  model            String?
  /// مقادیر ساختاریافته مشخصات فنی محصول در قالب JSON.
  specifications   Json?
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status           ProductStatus      @default(DRAFT)
  /// سطح مشاهده و دسترسی به محتوا.
  visibility       ProductVisibility  @default(PUBLIC)
  // Retail sales are explicitly opt-in. Existing products stay non-retail.
  /// مجاز بودن عرضه محصول در مسیر خرده‌فروشی را مشخص می‌کند.
  retailEnabled    Boolean            @default(false)
  /// ویژه بودن محصول برای جایگاه‌های برجسته.
  isFeatured       Boolean            @default(false)
  // Number of post-approval edits made by a company user. Reset to 0 on every
  // approve; once it reaches the system-configured review threshold the product
  // is automatically sent back to PENDING_REVIEW (see product.service.js).
  /// تعداد ویرایش‌های ثبت‌شده پس از آخرین تأیید محصول.
  editsSinceApproval Int             @default(0)
  /// شناسه شرکت مرتبط با این محصول؛ کلید خارجی به جدول Company است.
  companyId        Int
  /// شناسه Category مرتبط با این محصول؛ کلید خارجی به جدول Category است.
  categoryId       Int
  /// شناسه Subcategory مرتبط با این محصول؛ کلید خارجی به جدول Subcategory است.
  subcategoryId    Int
  /// شناسه کاربر مرتبط با این محصول؛ کلید خارجی به جدول User است.
  createdByUserId  Int
  /// زمان ایجاد رکورد.
  createdAt        DateTime           @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt        DateTime           @updatedAt
  /// زمان حذف نرم؛ NULL یعنی رکورد حذف نرم نشده است.
  deletedAt        DateTime?
  /// رابطه Prisma با جدول Company (شرکت)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  company          Company            @relation(fields: [companyId], references: [id])
  /// رابطه Prisma با جدول Category (Category)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  category         Category           @relation(fields: [categoryId], references: [id])
  /// رابطه Prisma با جدول Subcategory (Subcategory)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  subcategory      Subcategory        @relation(fields: [subcategoryId], references: [id])
  /// رابطه Prisma با جدول User (کاربر)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  createdBy        User               @relation("ProductCreatedBy", fields: [createdByUserId], references: [id])

  /// رابطه Prisma با جدول ProductImage (ProductImage)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  images           ProductImage[]
  /// رابطه Prisma با جدول ProductDocument (ProductDocument)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  documents        ProductDocument[]
  /// رابطه Prisma با جدول ProductPriceTier (ProductPriceTier)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  prices           ProductPriceTier[]
  /// رابطه Prisma با جدول ProductPriceSnapshot (ProductPriceSnapshot)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  priceSnapshots   ProductPriceSnapshot[]
  /// رابطه Prisma با جدول ProductStatusHistory (ProductStatusHistory)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  statusHistory    ProductStatusHistory[]
  /// رابطه Prisma با جدول ProductActivityLog (ProductActivityLog)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  activityLog      ProductActivityLog[]
  /// رابطه Prisma با جدول InquiryItem (InquiryItem)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  inquiryItems     InquiryItem[]
  /// رابطه Prisma با جدول InventoryBalance (InventoryBalance)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  inventoryBalance InventoryBalance?
  /// رابطه Prisma با جدول InventoryMovement (InventoryMovement)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  inventoryMovements InventoryMovement[]
  /// رابطه Prisma با جدول InventoryReservation (InventoryReservation)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  inventoryReservations InventoryReservation[]
  /// رابطه Prisma با جدول RetailOrderItem (RetailOrderItem)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  retailOrderItems RetailOrderItem[]

  @@index([companyId])
  @@index([categoryId])
  @@index([createdByUserId])
  @@index([status])
  @@index([visibility])
  @@index([isFeatured])
  @@index([deletedAt])
  @@index([sku])
  @@index([catalogCode])
}

/// تاریخچه تغییر وضعیت محصول، عامل تغییر و توضیح آن.
model ProductStatusHistory {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id             Int           @id @default(autoincrement())
  /// شناسه محصول مرتبط با این ProductStatusHistory؛ کلید خارجی به جدول Product است.
  productId      Int
  /// وضعیت قبلی رکورد پیش از تغییر.
  previousStatus ProductStatus
  /// وضعیت جدید رکورد پس از تغییر.
  newStatus      ProductStatus
  /// شناسه کاربر مرتبط با این ProductStatusHistory؛ کلید خارجی به جدول User است.
  changedByUserId Int
  /// توضیح ثبت‌شده درباره عملیات یا تغییر.
  comment        String?
  /// زمان ایجاد رکورد.
  createdAt      DateTime      @default(now())
  /// رابطه Prisma با جدول Product (محصول)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  product        Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// رابطه Prisma با جدول User (کاربر)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  changedBy      User          @relation(fields: [changedByUserId], references: [id])

  @@index([productId])
  @@index([changedByUserId])
  @@index([newStatus])
  @@index([createdAt])
}

// Immutable audit trail of every product change: field edits, price-tier
// changes, media changes, and status workflow transitions. Unlike
// ProductStatusHistory (which only records status transitions), this captures
// every content mutation so staff can see exactly what a company changed.
/// رویدادها و فعالیت‌های انجام‌شده روی محصول برای پیگیری و ممیزی.
model ProductActivityLog {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id           Int                  @id @default(autoincrement())
  /// شناسه محصول مرتبط با این ProductActivityLog؛ کلید خارجی به جدول Product است.
  productId    Int
  /// شناسه کاربر مرتبط با این ProductActivityLog؛ کلید خارجی به جدول User است.
  actorUserId  Int
  /// نوع اقدام انجام‌شده.
  action       ProductActivityAction
  /// شرح تکمیلی اقدام یا رویداد ثبت‌شده.
  detail       String?
  /// توضیح ثبت‌شده درباره عملیات یا تغییر.
  comment      String?
  /// زمان ایجاد رکورد.
  createdAt    DateTime             @default(now())
  /// رابطه Prisma با جدول Product (محصول)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  product      Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// رابطه Prisma با جدول User (کاربر)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  actor        User                 @relation(fields: [actorUserId], references: [id])

  @@index([productId])
  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
}

/// تصاویر محصول و فراداده لازم برای نمایش و دسترس‌پذیری.
model ProductImage {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id           Int      @id @default(autoincrement())
  /// شناسه محصول مرتبط با این ProductImage؛ کلید خارجی به جدول Product است.
  productId    Int
  /// نشانی فایل یا منبع مرتبط.
  url          String
  /// نشانی تصویر بندانگشتی.
  thumbnailUrl String?
  /// متن جایگزین تصویر برای دسترس‌پذیری و سئو.
  altText      String?
  /// اصلی بودن این مورد در میان موارد مرتبط.
  isPrimary    Boolean  @default(false)
  /// ترتیب نمایش رکورد در میان موارد هم‌گروه.
  sortOrder    Int      @default(0)
  /// زمان ایجاد رکورد.
  createdAt    DateTime @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt    DateTime @updatedAt
  /// رابطه Prisma با جدول Product (محصول)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([isPrimary])
  @@index([sortOrder])
}

/// اسناد و فایل‌های پیوست محصول مانند دیتاشیت و کاتالوگ.
model ProductDocument {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id        Int                 @id @default(autoincrement())
  /// شناسه محصول مرتبط با این ProductDocument؛ کلید خارجی به جدول Product است.
  productId Int
  /// نوع یا طبقه‌بندی رکورد؛ مقادیر مجاز در Enum یا قرارداد دامنه تعریف شده‌اند.
  type      ProductDocumentType
  /// عنوان اصلی قابل نمایش.
  title     String?
  /// نشانی فایل یا منبع مرتبط.
  url       String
  /// ترتیب نمایش رکورد در میان موارد هم‌گروه.
  sortOrder Int                 @default(0)
  /// زمان ایجاد رکورد.
  createdAt DateTime            @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt DateTime            @updatedAt
  /// رابطه Prisma با جدول Product (محصول)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  product   Product             @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([type])
  @@index([sortOrder])
}

/// قیمت جاری محصول بر اساس بازه حداقل و حداکثر تعداد سفارش.
model ProductPriceTier {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id          Int       @id @default(autoincrement())
  /// شناسه محصول مرتبط با این ProductPriceTier؛ کلید خارجی به جدول Product است.
  productId   Int
  /// حداقل تعداد مشمول این سطح یا بازه.
  minQuantity Int
  /// حداکثر تعداد مشمول این سطح؛ NULL یعنی سقف مشخص نشده است.
  maxQuantity Int?
  /// مبلغ قیمت واحد یا پیشنهادی.
  price       Decimal   @db.Decimal(18, 2)
  /// واحد اندازه‌گیری یا فروش.
  unit        String?
  /// شروع اعتبار قیمت یا قاعده.
  validFrom   DateTime  @default(now())
  /// پایان اعتبار؛ NULL یعنی تاریخ پایان تعیین نشده است.
  validTo     DateTime?
  /// زمان ایجاد رکورد.
  createdAt   DateTime  @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt   DateTime  @updatedAt
  /// رابطه Prisma با جدول Product (محصول)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([minQuantity])
  @@index([validFrom])
  @@index([validTo])
}

/// تصویر تاریخی قیمت هر سطح در زمان ثبت برای گزارش و نمودار تغییرات.
model ProductPriceSnapshot {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id          Int      @id @default(autoincrement())
  /// شناسه محصول مرتبط با این ProductPriceSnapshot؛ کلید خارجی به جدول Product است.
  productId   Int
  /// شناسه رکورد مرتبط برای اتصال این ProductPriceSnapshot به موجودیت مرجع.
  priceTierId Int?
  /// حداقل تعداد مشمول این سطح یا بازه.
  minQuantity Int
  /// حداکثر تعداد مشمول این سطح؛ NULL یعنی سقف مشخص نشده است.
  maxQuantity Int?
  /// مبلغ قیمت واحد یا پیشنهادی.
  price       Decimal  @db.Decimal(18, 2)
  /// واحد اندازه‌گیری یا فروش.
  unit        String?
  /// نوع اقدام انجام‌شده.
  action      String
  /// زمان ثبت snapshot یا داده تاریخی.
  recordedAt  DateTime @default(now())
  /// رابطه Prisma با جدول Product (محصول)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, recordedAt])
  @@index([priceTierId])
}

/// درخواست خرید یا استعلام (RFQ) همراه با خریدار، وضعیت، محرمانگی و مهلت پاسخ.
model Inquiry {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id               Int               @id @default(autoincrement())
  /// عنوان اصلی قابل نمایش.
  title            String
  /// شرح تکمیلی موجودیت.
  description      String?
  // Exactly one buyer identity is set: companyId for B2B company buyers,
  // buyerUserId for CUSTOMER buyers. Enforced by a PostgreSQL CHECK constraint.
  /// شناسه شرکت مرتبط با این استعلام؛ کلید خارجی به جدول Company است.
  companyId        Int?
  /// شناسه کاربر مرتبط با این استعلام؛ کلید خارجی به جدول User است.
  buyerUserId      Int?
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status           InquiryStatus     @default(DRAFT)

  // ── Phase 2: professional inquiry model ────────────────────
  /// اولویت رسیدگی یا پردازش.
  priority         InquiryPriority       @default(NORMAL)
  /// حالت مشاهده و محرمانگی استعلام (عادی، مهروموم‌شده یا ناشناس).
  visibilityMode   InquiryVisibilityMode @default(NORMAL)
  /// محرمانه بودن استعلام را مشخص می‌کند.
  confidential     Boolean               @default(false)

  // Scheduling
  /// زمان انتشار استعلام برای شرکت‌های واجد شرایط.
  publishDate      DateTime?
  /// آخرین مهلت ثبت پاسخ به استعلام.
  responseDeadline DateTime?
  /// بسته‌شدن خودکار استعلام پس از رسیدن به شرایط/مهلت را کنترل می‌کند.
  autoClose        Boolean               @default(true)

  // Sealed-bid reveal settings
  /// اجازه آشکارسازی زودتر پاسخ‌های مهروموم‌شده را مشخص می‌کند.
  allowEarlyReveal Boolean               @default(false)
  /// زمان آشکارسازی پاسخ‌های محرمانه استعلام.
  revealedAt       DateTime?

  // Response controls
  /// اجازه ویرایش پاسخ ثبت‌شده توسط تأمین‌کننده را کنترل می‌کند.
  allowEditResponse     Boolean          @default(true)
  /// اجازه انصراف از پاسخ ثبت‌شده را کنترل می‌کند.
  allowWithdrawResponse Boolean          @default(false)

  /// زمان بسته‌شدن پرونده یا فرآیند.
  closedAt         DateTime?
  /// زمان ایجاد رکورد.
  createdAt        DateTime          @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt        DateTime          @updatedAt
  /// رابطه Prisma با جدول Company (شرکت)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  company          Company?          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  /// رابطه Prisma با جدول User (کاربر)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  buyerUser        User?              @relation("InquiryBuyer", fields: [buyerUserId], references: [id], onDelete: Cascade)
  /// رابطه Prisma با جدول InquiryItem (InquiryItem)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  items            InquiryItem[]
  /// رابطه Prisma با جدول InquiryResponse (InquiryResponse)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  responses        InquiryResponse[]
  /// رابطه Prisma با جدول InquiryMessage (InquiryMessage)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  messages         InquiryMessage[]
  /// رابطه Prisma با جدول InquiryStatusHistory (InquiryStatusHistory)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  statusHistory    InquiryStatusHistory[]

  @@index([companyId])
  @@index([buyerUserId])
  @@index([status])
  @@index([priority])
  @@index([visibilityMode])
  @@index([confidential])
  @@index([publishDate])
  @@index([responseDeadline])
  @@index([revealedAt])
  @@index([closedAt])
}



/// پیام‌های میان خریدار و شرکت‌های پاسخ‌دهنده درباره یک استعلام.
model InquiryMessage {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id                Int       @id @default(autoincrement())
  /// شناسه استعلام مرتبط با این InquiryMessage؛ کلید خارجی به جدول Inquiry است.
  inquiryId         Int
  /// شناسه کاربر مرتبط با این InquiryMessage؛ کلید خارجی به جدول User است.
  senderUserId      Int?
  /// شناسه شرکت مرتبط با این InquiryMessage؛ کلید خارجی به جدول Company است.
  senderCompanyId   Int?
  /// شناسه کاربر مرتبط با این InquiryMessage؛ کلید خارجی به جدول User است.
  recipientUserId   Int?
  /// شناسه شرکت مرتبط با این InquiryMessage؛ کلید خارجی به جدول Company است.
  recipientCompanyId Int?
  /// متن کامل پیام، یادداشت یا محتوای رکورد.
  body              String    @db.VarChar(5000)
  /// زمان ایجاد رکورد.
  createdAt         DateTime  @default(now())
  /// زمان خوانده‌شدن پیام/اعلان.
  readAt            DateTime?
  /// رابطه Prisma با جدول Inquiry (استعلام)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  inquiry           Inquiry   @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  /// رابطه Prisma با جدول User (کاربر)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  senderUser        User?     @relation("InquiryMessageSenderUser", fields: [senderUserId], references: [id], onDelete: Cascade)
  /// رابطه Prisma با جدول Company (شرکت)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  senderCompany     Company?  @relation("InquiryMessageSenderCompany", fields: [senderCompanyId], references: [id], onDelete: Cascade)
  /// رابطه Prisma با جدول User (کاربر)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  recipientUser     User?     @relation("InquiryMessageRecipientUser", fields: [recipientUserId], references: [id], onDelete: Cascade)
  /// رابطه Prisma با جدول Company (شرکت)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  recipientCompany  Company?  @relation("InquiryMessageRecipientCompany", fields: [recipientCompanyId], references: [id], onDelete: Cascade)

  @@index([inquiryId, createdAt])
  @@index([senderUserId])
  @@index([senderCompanyId])
  @@index([recipientUserId])
  @@index([recipientCompanyId])
}

/// تاریخچه تغییر وضعیت استعلام همراه با عامل و دلیل تغییر.
model InquiryStatusHistory {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id             Int           @id @default(autoincrement())
  /// شناسه استعلام مرتبط با این InquiryStatusHistory؛ کلید خارجی به جدول Inquiry است.
  inquiryId      Int
  /// وضعیت قبلی رکورد پیش از تغییر.
  previousStatus InquiryStatus
  /// وضعیت جدید رکورد پس از تغییر.
  newStatus      InquiryStatus
  /// شناسه کاربر مرتبط با این InquiryStatusHistory؛ کلید خارجی به جدول User است.
  changedByUserId Int?
  /// منبع ایجاد یا ثبت رکورد.
  source         String        @default("USER")
  /// توضیح ثبت‌شده درباره عملیات یا تغییر.
  comment        String?
  /// زمان ایجاد رکورد.
  createdAt      DateTime      @default(now())
  /// رابطه Prisma با جدول Inquiry (استعلام)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  inquiry        Inquiry       @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  /// رابطه Prisma با جدول User (کاربر)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  changedBy      User?         @relation(fields: [changedByUserId], references: [id])

  @@index([inquiryId])
  @@index([changedByUserId])
  @@index([newStatus])
  @@index([createdAt])
}

/// اقلام و محصولات درخواست‌شده در یک استعلام به همراه تعداد و توضیح.
model InquiryItem {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id            Int                   @id @default(autoincrement())
  /// شناسه استعلام مرتبط با این InquiryItem؛ کلید خارجی به جدول Inquiry است.
  inquiryId     Int
  /// شناسه محصول مرتبط با این InquiryItem؛ کلید خارجی به جدول Product است.
  productId     Int
  /// شرح تکمیلی موجودیت.
  description   String?
  /// تعداد واحدهای کالا یا مقدار موردنظر.
  quantity      Int
  /// نشانی یا کلید فایل پیوست.
  attachment    String?
  /// زمان ایجاد رکورد.
  createdAt     DateTime              @default(now())
  /// رابطه Prisma با جدول Inquiry (استعلام)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  inquiry       Inquiry               @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  /// رابطه Prisma با جدول Product (محصول)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  product       Product               @relation(fields: [productId], references: [id])
  /// رابطه Prisma با جدول InquiryResponseItem (InquiryResponseItem)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  responseItems InquiryResponseItem[]

  @@index([inquiryId])
  @@index([productId])
}

/// پاسخ یا پیشنهاد یک شرکت تأمین‌کننده به یک استعلام.
model InquiryResponse {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id          Int                   @id @default(autoincrement())
  /// شناسه استعلام مرتبط با این InquiryResponse؛ کلید خارجی به جدول Inquiry است.
  inquiryId   Int
  /// شناسه شرکت مرتبط با این InquiryResponse؛ کلید خارجی به جدول Company است.
  companyId   Int
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status      InquiryResponseStatus @default(PENDING)
  /// زمان انصراف از پاسخ یا پیشنهاد استعلام.
  withdrawnAt DateTime?
  /// زمان ایجاد رکورد.
  createdAt   DateTime              @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt   DateTime              @updatedAt
  /// رابطه Prisma با جدول Inquiry (استعلام)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  inquiry     Inquiry               @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  /// رابطه Prisma با جدول Company (شرکت)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  company     Company               @relation(fields: [companyId], references: [id])
  /// رابطه Prisma با جدول InquiryResponseItem (InquiryResponseItem)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  items       InquiryResponseItem[]
  /// رابطه Prisma با جدول InquiryResponseAttachment (InquiryResponseAttachment)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  attachments InquiryResponseAttachment[]

  @@unique([inquiryId, companyId])
  @@index([inquiryId])
  @@index([companyId])
  @@index([status])
}

/// فایل‌های پیوست یک پاسخ استعلام به همراه مشخصات فایل.
model InquiryResponseAttachment {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id         Int             @id @default(autoincrement())
  /// شناسه InquiryResponse مرتبط با این InquiryResponseAttachment؛ کلید خارجی به جدول InquiryResponse است.
  responseId Int
  /// نشانی فایل یا منبع مرتبط.
  url        String
  /// نام فایل.
  filename   String
  /// نوع رسانه‌ای فایل (MIME type).
  mimetype   String?
  /// اندازه فایل بر حسب بایت.
  size       Int?
  /// زمان ایجاد رکورد.
  createdAt  DateTime        @default(now())
  /// رابطه Prisma با جدول InquiryResponse (InquiryResponse)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  response   InquiryResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@index([responseId])
}


/// قیمت و شرایط تأمین پیشنهادی شرکت برای یک قلم استعلام.
model InquiryResponseItem {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id                Int             @id @default(autoincrement())
  /// شناسه InquiryResponse مرتبط با این InquiryResponseItem؛ کلید خارجی به جدول InquiryResponse است.
  responseId        Int
  /// شناسه InquiryItem مرتبط با این InquiryResponseItem؛ کلید خارجی به جدول InquiryItem است.
  inquiryItemId     Int
  /// مبلغ قیمت واحد یا پیشنهادی.
  price             Decimal         @db.Decimal(18, 2)
  /// کد سه‌حرفی ارز (ISO 4217) مبالغ این رکورد.
  currency          String          @default("IRR")
  /// تعداد قابل تأمین در این پیشنهاد.
  availableQuantity Int
  /// زمان یا بازه تحویل پیشنهادی تأمین‌کننده.
  deliveryTime      String?
  /// شرح تکمیلی موجودیت.
  description       String?
  /// رابطه Prisma با جدول InquiryResponse (InquiryResponse)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  response          InquiryResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  /// رابطه Prisma با جدول InquiryItem (InquiryItem)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  inquiryItem       InquiryItem     @relation(fields: [inquiryItemId], references: [id])

  @@unique([responseId, inquiryItemId])
  @@index([responseId])
  @@index([inquiryItemId])
  @@index([currency])
}

/// محدودیت‌های کلی تعداد استعلام باز و پاسخ فعال هر شرکت در ساختار قدیمی.
model CompanyInquiryLimit {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id                 Int      @id @default(autoincrement())
  /// شناسه شرکت مرتبط با این CompanyInquiryLimit؛ کلید خارجی به جدول Company است.
  companyId          Int      @unique
  /// حداکثر تعداد استعلام‌های باز مجاز برای شرکت.
  maxOpenInquiries   Int      @default(5)
  /// حداکثر تعداد پاسخ‌های فعال مجاز برای شرکت.
  maxActiveResponses Int      @default(20)
  /// زمان ایجاد رکورد.
  createdAt          DateTime @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt          DateTime @updatedAt
  /// رابطه Prisma با جدول Company (شرکت)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

/// سقف‌ها و محدودیت‌های قابل پیکربندی هر شرکت به شکل کلید و مقدار.
model CompanyLimit {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id        Int      @id @default(autoincrement())
  /// شناسه شرکت مرتبط با این CompanyLimit؛ کلید خارجی به جدول Company است.
  companyId Int
  /// کلید ماشینی تنظیم یا گزینه.
  key       String
  /// مقدار تنظیم یا محدودیت؛ مفهوم آن با key مشخص می‌شود.
  value     Int
  /// زمان ایجاد رکورد.
  createdAt DateTime @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt DateTime @updatedAt
  /// رابطه Prisma با جدول Company (شرکت)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key])
  @@index([companyId])
  @@index([key])
}

// Commercial plans and auditable usage for the RFQ/inquiry revenue model.
// Enforcement is rollout-gated by SystemSetting key "inquiry.subscription_enforcement"
// so deployment can be migrated before existing users are required to subscribe.
/// تعریف بسته اشتراک استعلام و سهمیه‌های قابل مصرف در هر دوره.
model InquiryPlan {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id                         Int      @id @default(autoincrement())
  /// کد ماشینی یا تجاری این موجودیت.
  code                       String   @unique
  /// نام قابل نمایش موجودیت.
  name                       String
  /// شرح تکمیلی موجودیت.
  description                String?
  /// مدت دوره بر حسب روز.
  durationDays               Int
  /// مبلغ قیمت واحد یا پیشنهادی.
  price                      Decimal  @db.Decimal(18, 2)
  /// کد سه‌حرفی ارز (ISO 4217) مبالغ این رکورد.
  currency                   String   @default("IRR")
  /// سهمیه ایجاد استعلام در هر دوره اشتراک.
  inquiriesPerPeriod         Int      @default(0)
  /// سهمیه پاسخ به استعلام در هر دوره اشتراک.
  responsesPerPeriod         Int      @default(0)
  /// سهمیه پیام داخلی در هر دوره اشتراک.
  internalMessagesPerPeriod  Int      @default(0)
  /// سهمیه پیامک در هر دوره اشتراک.
  smsPerPeriod               Int      @default(0)
  /// فعال یا غیرفعال بودن رکورد.
  isActive                   Boolean  @default(true)
  /// زمان ایجاد رکورد.
  createdAt                  DateTime @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt                  DateTime @updatedAt
  /// رابطه Prisma با جدول InquirySubscription (InquirySubscription)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  subscriptions              InquirySubscription[]

  @@index([isActive])
}

/// اشتراک تخصیص‌یافته یا خریداری‌شده توسط شرکت/کاربر و بازه اعتبار آن.
model InquirySubscription {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id          Int      @id @default(autoincrement())
  /// شناسه InquiryPlan مرتبط با این InquirySubscription؛ کلید خارجی به جدول InquiryPlan است.
  planId      Int
  /// شناسه شرکت مرتبط با این InquirySubscription؛ کلید خارجی به جدول Company است.
  companyId   Int?
  /// شناسه کاربر مرتبط با این InquirySubscription؛ کلید خارجی به جدول User است.
  userId      Int?
  /// وضعیت چرخه عمر رکورد؛ مقادیر مجاز در Enum مربوط تعریف شده‌اند.
  status      InquirySubscriptionStatus @default(PENDING_PAYMENT)
  /// زمان شروع اعتبار یا فعال‌بودن.
  startsAt    DateTime?
  /// زمان پایان اعتبار یا فعال‌بودن.
  endsAt      DateTime?
  /// شناسه کاربری که اشتراک را فعال کرده است.
  activatedBy Int?
  /// شناسه مرجع پرداخت.
  paymentReference String? @unique
  /// نام ارائه‌دهنده پرداخت.
  paymentProvider String?
  /// کد authority درگاه پرداخت.
  paymentAuthority String? @unique
  /// شناسه پرداخت در سامانه ارائه‌دهنده.
  paymentRefId String?
  /// مبلغ پرداخت‌شده برای خرید یا فعال‌سازی اشتراک.
  paymentAmount Int?
  /// زمان تأیید پرداخت.
  paymentVerifiedAt DateTime?
  /// یادداشت‌های تکمیلی درباره رکورد.
  notes       String?
  /// زمان ایجاد رکورد.
  createdAt   DateTime @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt   DateTime @updatedAt
  /// رابطه Prisma با جدول InquiryPlan (InquiryPlan)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  plan        InquiryPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  /// رابطه Prisma با جدول Company (شرکت)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  company     Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// رابطه Prisma با جدول User (کاربر)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  user        User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// رابطه Prisma با جدول InquiryUsageEvent (InquiryUsageEvent)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  usage       InquiryUsageEvent[]

  @@index([companyId, status, endsAt])
  @@index([userId, status, endsAt])
  @@index([planId])
}

/// رویداد مصرف سهمیه اشتراک و مرجع عملیاتی آن برای محاسبه مصرف.
model InquiryUsageEvent {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id             BigInt   @id @default(autoincrement())
  /// شناسه InquirySubscription مرتبط با این InquiryUsageEvent؛ کلید خارجی به جدول InquirySubscription است.
  subscriptionId Int
  /// نوع سهمیه مصرف‌شده در این رویداد.
  usageType      InquiryUsageType
  /// تعداد واحدهای کالا یا مقدار موردنظر.
  quantity       Int      @default(1)
  /// نوع موجودیت مرجع عملیات.
  referenceType  String?
  /// شناسه موجودیت مرجع عملیات.
  referenceId    String?
  /// کلید یکتای جلوگیری از اجرای تکراری درخواست/عملیات.
  idempotencyKey String?  @unique
  /// داده‌های تکمیلی ساختاریافته و وابسته به دامنه در قالب JSON.
  metadata       Json?
  /// زمان ایجاد رکورد.
  createdAt      DateTime @default(now())
  /// رابطه Prisma با جدول InquirySubscription (InquirySubscription)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  subscription   InquirySubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, usageType, createdAt])
  @@index([referenceType, referenceId])
}

enum InquirySubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
}

enum InquiryUsageType {
  INQUIRY_CREATE
  RESPONSE_SUBMIT
  INTERNAL_MESSAGE
  SMS
}

// Platform-wide, admin-managed key/value settings (e.g. the threshold of
// post-approval edits that pushes a PUBLISHED product back into review).
/// تنظیمات سراسری سامانه به شکل کلید و مقدار.
model SystemSetting {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id            Int      @id @default(autoincrement())
  /// کلید ماشینی تنظیم یا گزینه.
  key           String   @unique
  /// مقدار تنظیم یا محدودیت؛ مفهوم آن با key مشخص می‌شود.
  value         String
  /// شناسه کاربری که آخرین بار تنظیم را ویرایش کرده است.
  updatedByUserId Int?
  /// زمان ایجاد رکورد.
  createdAt     DateTime @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt     DateTime @updatedAt

  @@index([key])
}

/// اعلان اصلی متعلق به کاربر، شامل عنوان، متن، نوع و وضعیت خوانده‌شدن.
model Notification {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id        Int      @id @default(autoincrement())
  /// شناسه کاربر مرتبط با این اعلان؛ کلید خارجی به جدول User است.
  userId    Int
  // Event key from src/modules/notifications/notification.events.js
  // (e.g. 'PRODUCT_STATUS_CHANGED'). Null = legacy/untyped row created
  // before the central dispatch service existed.
  /// نوع یا طبقه‌بندی رکورد؛ مقادیر مجاز در Enum یا قرارداد دامنه تعریف شده‌اند.
  type      String?
  // Structured event payload (e.g. { productId, status }) for deep-linking.
  /// داده تکمیلی اعلان/رویداد در قالب JSON.
  data      Json?
  /// عنوان اصلی قابل نمایش.
  title     String
  /// متن اعلان قابل نمایش به کاربر.
  message   String
  /// خوانده‌شدن اعلان توسط کاربر.
  isRead    Boolean  @default(false)
  /// زمان ایجاد رکورد.
  createdAt DateTime @default(now())
  /// رابطه Prisma با جدول User (کاربر)؛ رکورد مرتبط را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// رابطه Prisma با جدول NotificationFolderMembership (NotificationFolderMembership)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  folderMemberships NotificationFolderMembership[]

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([type])
}

// Per-user, per-event, per-channel opt-in/out matrix (flow/06 §3: NO channel
// is mandatory — every (user, event, channel) can be switched off, only the
// defaults are sensible: IN_APP + EMAIL on, SMS off).
// A missing row means "use the event's channel defaults".
//
// VERIFIED against the live database (2026-10-24, `prisma db pull`): column
// types, nullability, the (userId, eventType, channel) unique index and the
// CASCADE FK to User all match this definition 1:1. `updatedAt` is NOT NULL
// with NO database default — `@updatedAt` is populated by the Prisma Client on
// write, so raw-SQL inserts must supply it explicitly.
 
// Admin-managed folders. INBOX and SAVED are immutable system folders.
// Scope controls which app inboxes can display a folder; memberships are
// associations, so copy adds a second association and move swaps one.
/// تعریف پوشه‌های سیستمی یا مدیریتی اعلان و محدوده نمایش آن‌ها.
model NotificationFolder {
  /// شناسه یکتای رکورد و کلید اصلی جدول.
  id        Int      @id @default(autoincrement())
  /// کلید ماشینی تنظیم یا گزینه.
  key       String   @unique
  /// نام قابل نمایش موجودیت.
  name      String
  /// محدوده اعتبار یا نمایش رکورد.
  scope     NotificationFolderScope @default(ALL)
  /// سیستمی بودن رکورد و محدودیت مدیریت عادی آن.
  isSystem  Boolean  @default(false)
  /// فعال یا غیرفعال بودن رکورد.
  isActive  Boolean  @default(true)
  /// ترتیب نمایش رکورد در میان موارد هم‌گروه.
  sortOrder Int      @default(0)
  /// زمان ایجاد رکورد.
  createdAt DateTime @default(now())
  /// آخرین زمان ویرایش رکورد.
  updatedAt DateTime @updatedAt
  /// رابطه Prisma با جدول NotificationFolderMembership (NotificationFolderMembership)؛ مجموعه رکوردهای وابسته را در کد در دسترس قرار می‌دهد و ستون مستقل PostgreSQL نیست.
  memberships NotificationFolderMembership[]

