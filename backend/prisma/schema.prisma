  owner              User          @relation("CRMLeadOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  convertedAccount   CRMAccount?   @relation(fields: [convertedAccountId], references: [id], onDelete: SetNull)
  convertedBy        User?         @relation("CRMLeadConverter", fields: [convertedByUserId], references: [id], onDelete: SetNull)
  activities         CRMActivity[]
  tasks              CRMTask[]
  notesLog           CRMNote[]

  @@index([ownerUserId, status, updatedAt])
  @@index([sourceId, createdAt])
  @@index([status, score])
  @@index([phone])
  @@index([email])

}

model Pipeline {
  id        Int             @id @default(autoincrement())
  name      String          @db.VarChar(120)
  isDefault Boolean         @default(false)
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  stages    PipelineStage[]
  opportunities Opportunity[]

  @@index([isActive, isDefault])

}

model PipelineStage {
  id             Int          @id @default(autoincrement())
  pipelineId     Int
  code           String       @db.VarChar(60)
  label          String       @db.VarChar(120)
  sortOrder      Int          @default(0)
  probability    Int          @default(0)
  isWon          Boolean      @default(false)
  isLost         Boolean      @default(false)
  pipeline       Pipeline     @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  opportunities  Opportunity[]
  fromHistories  OpportunityStageHistory[] @relation("OpportunityFromStage")
  toHistories    OpportunityStageHistory[] @relation("OpportunityToStage")

  @@unique([pipelineId, code])
  @@unique([pipelineId, sortOrder])
  @@unique([id, pipelineId])
  @@index([pipelineId, isWon, isLost])

}

model Opportunity {
  id                Int                  @id @default(autoincrement())
  opportunityNumber String               @unique @db.VarChar(32)
  accountId         Int
  pipelineId        Int
  stageId           Int
  ownerUserId       Int
  title             String               @db.VarChar(240)
  amount            Decimal              @default(0) @db.Decimal(20, 2)
  currency          String               @default("IRR") @db.VarChar(3)
  expectedCloseAt   DateTime?
  status            CRMOpportunityStatus @default(OPEN)
  closedAt          DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  account           CRMAccount           @relation(fields: [accountId], references: [id], onDelete: Restrict)
  pipeline          Pipeline             @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  stage             PipelineStage        @relation(fields: [stageId, pipelineId], references: [id, pipelineId], onDelete: Restrict)
  owner             User                 @relation("OpportunityOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  stageHistory      OpportunityStageHistory[]
  activities        CRMActivity[]
  tasks             CRMTask[]
  notesLog          CRMNote[]

  @@index([accountId, status])
  @@index([ownerUserId, status, expectedCloseAt])
  @@index([pipelineId, stageId])
  @@index([status, expectedCloseAt])

}

model OpportunityStageHistory {
  id            Int          @id @default(autoincrement())
  opportunityId Int
  fromStageId   Int?
  toStageId     Int
  actorUserId   Int
  reason        String?      @db.VarChar(500)
  createdAt     DateTime     @default(now())
  opportunity   Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  fromStage     PipelineStage? @relation("OpportunityFromStage", fields: [fromStageId], references: [id], onDelete: SetNull)
  toStage       PipelineStage @relation("OpportunityToStage", fields: [toStageId], references: [id], onDelete: Restrict)
  actor         User         @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([opportunityId, createdAt])
  @@index([actorUserId, createdAt])

}

model CRMActivity {
  id             BigInt          @id @default(autoincrement())
  type           CRMActivityType
  subject        String          @db.VarChar(240)
  body           String?
  occurredAt     DateTime        @default(now())
  durationMinutes Int?
  outcome        String?         @db.VarChar(500)
  actorUserId    Int
  accountId      Int?
  leadId         Int?
  opportunityId  Int?
  createdAt      DateTime        @default(now())
  actor          User            @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  account        CRMAccount?     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  lead           Lead?           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  opportunity    Opportunity?    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([accountId, occurredAt])
  @@index([leadId, occurredAt])
  @@index([opportunityId, occurredAt])
  @@index([actorUserId, occurredAt])

}

model CRMTask {
  id             Int            @id @default(autoincrement())
  title          String         @db.VarChar(240)
  description    String?
  status         CRMTaskStatus  @default(OPEN)
  priority       CRMTaskPriority @default(NORMAL)
  assigneeUserId Int
  createdByUserId Int
  dueAt          DateTime?
  completedAt    DateTime?
  accountId      Int?
  leadId         Int?
  opportunityId  Int?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  assignee       User           @relation("CRMTaskAssignee", fields: [assigneeUserId], references: [id], onDelete: Restrict)
  createdBy      User           @relation("CRMTaskCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  account        CRMAccount?    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  lead           Lead?          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  opportunity    Opportunity?   @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([assigneeUserId, status, dueAt])
  @@index([createdByUserId, createdAt])
  @@index([accountId, status])
  @@index([leadId, status])
  @@index([opportunityId, status])

}

model CRMNote {
  id             BigInt            @id @default(autoincrement())
  body           String
  visibility     CRMNoteVisibility @default(TEAM)
  authorUserId   Int
  accountId      Int?
  leadId         Int?
  opportunityId  Int?
  createdAt      DateTime          @default(now())
  author         User              @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  account        CRMAccount?       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  lead           Lead?             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  opportunity    Opportunity?      @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@index([leadId, createdAt])
  @@index([opportunityId, createdAt])
  @@index([authorUserId, createdAt])

}

// ============================================================================
// DB-5 — Retail inventory, orders, payments, fulfillment and returns
// These tables are inert until a separate product decision enables B2C.
// ============================================================================
enum InventoryMovementType {
  RECEIPT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RESERVATION
  RELEASE
  SALE
  RETURN
  DAMAGE
}

enum InventoryReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

enum RetailOrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  PARTIALLY_FULFILLED
  FULFILLED
  COMPLETED
  CANCELLED
  PAYMENT_EXPIRED
  PARTIALLY_CANCELLED
}

enum RetailPaymentStatus {
  UNPAID
  PENDING
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

enum SellerOrderStatus {
  PENDING_ACCEPTANCE
  ACCEPTED
  REJECTED
  PROCESSING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  PARTIALLY_RETURNED
  RETURNED
}

enum PaymentAttemptStatus {
  CREATED
  REDIRECTED
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
  CANCELLED
}

enum PaymentTransactionType {
  AUTHORIZE
  CAPTURE
  VOID
  REFUND
  CHARGEBACK
}

enum PaymentTransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
  REVERSED
}

enum PaymentWebhookStatus {
  RECEIVED
  VERIFIED
  PROCESSED
  REJECTED
  FAILED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSING
  SUCCEEDED
  FAILED
  REJECTED
}

enum ShipmentStatus {
  LABEL_CREATED
  READY_FOR_PICKUP
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  IN_TRANSIT
  RECEIVED
  INSPECTED
  REFUNDED
  CLOSED
}

enum ReturnItemDisposition {
  RESTOCK
  DAMAGED
  DISPOSED
  REPAIR
}

model InventoryBalance {
  id        Int      @id @default(autoincrement())
  productId Int      @unique
  onHand    Int      @default(0)
  reserved  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

}

model InventoryMovement {
  id             BigInt                @id @default(autoincrement())
  productId      Int
  actorUserId    Int?
  movementType   InventoryMovementType
  quantityDelta  Int
  referenceType  String?               @db.VarChar(60)
  referenceId    String?               @db.VarChar(100)
  idempotencyKey String?               @unique @db.VarChar(160)
  reason         String?               @db.VarChar(500)
  metadata       Json?
  createdAt      DateTime              @default(now())
  product        Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  actor          User?                 @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([movementType, createdAt])
  @@index([referenceType, referenceId])
  @@index([actorUserId, createdAt])

}

model RetailOrder {
  id                    Int                @id @default(autoincrement())
  orderNumber           String             @unique @db.VarChar(40)
  buyerUserId           Int
  status                RetailOrderStatus  @default(PENDING_PAYMENT)
  paymentStatus         RetailPaymentStatus @default(UNPAID)
  currency              String             @db.VarChar(3)
  subtotal              Decimal            @default(0) @db.Decimal(20, 2)
  discountTotal         Decimal            @default(0) @db.Decimal(20, 2)
  shippingTotal         Decimal            @default(0) @db.Decimal(20, 2)
  taxTotal              Decimal            @default(0) @db.Decimal(20, 2)
  grandTotal            Decimal            @default(0) @db.Decimal(20, 2)
  addressId             Int?
  address               Address?           @relation(fields: [addressId], references: [id], onDelete: SetNull)
  recipientName         String             @db.VarChar(200)
  recipientPhone        String             @db.VarChar(40)
  province              String             @db.VarChar(120)
  city                  String             @db.VarChar(120)
  addressLine           String             @db.VarChar(1000)
  postalCode            String?            @db.VarChar(30)
  idempotencyKey        String             @unique @db.VarChar(160)
  placedAt              DateTime           @default(now())
  paidAt                DateTime?
  completedAt            DateTime?
  cancelledAt            DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  buyer                 User               @relation(fields: [buyerUserId], references: [id], onDelete: Restrict)
  items                 RetailOrderItem[]
  sellerOrders          SellerOrder[]
  paymentAttempts       PaymentAttempt[]
  paymentTransactions   PaymentTransaction[]
  refunds               RetailRefund[]
  reservations          InventoryReservation[]
  returns               ReturnRequest[]
  invoices              FinanceInvoice[]

  @@index([buyerUserId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])

}

model SellerOrder {
  id                 Int              @id @default(autoincrement())
  orderId            Int
  companyId           Int
  sellerOrderNumber   String           @unique @db.VarChar(48)
  status              SellerOrderStatus @default(PENDING_ACCEPTANCE)
  currency            String           @db.VarChar(3)
  subtotal            Decimal          @default(0) @db.Decimal(20, 2)
  discountTotal       Decimal          @default(0) @db.Decimal(20, 2)
  shippingTotal       Decimal          @default(0) @db.Decimal(20, 2)
  taxTotal            Decimal          @default(0) @db.Decimal(20, 2)
  sellerNetTotal      Decimal          @default(0) @db.Decimal(20, 2)
  companyNameSnapshot String           @db.VarChar(240)
  companyIdSnapshot   String?          @db.VarChar(80)
  acceptedAt          DateTime?
  shippedAt           DateTime?
  deliveredAt         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  order               RetailOrder      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  company             Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  items               RetailOrderItem[]
  shipments           Shipment[]
  returns             ReturnRequest[]
  refunds             RetailRefund[]
  commissionSnapshot  CommissionSnapshot?
  sellerPayable       SellerPayable?
  invoices            FinanceInvoice[]

  @@unique([orderId, companyId])
  @@unique([id, orderId])
  @@index([companyId, status, createdAt])
  @@index([orderId, status])

}

model RetailOrderItem {
  id                    Int         @id @default(autoincrement())
  orderId               Int
  sellerOrderId         Int
  productId             Int?
  productTitleSnapshot  String      @db.VarChar(240)
  skuSnapshot           String?     @db.VarChar(120)
  brandSnapshot         String?     @db.VarChar(160)
  modelSnapshot         String?     @db.VarChar(160)
  imageUrlSnapshot      String?     @db.VarChar(1000)
  companyNameSnapshot   String      @db.VarChar(240)
  quantity              Int
  unitPrice             Decimal     @db.Decimal(20, 2)
  discountAmount        Decimal     @default(0) @db.Decimal(20, 2)
  taxAmount             Decimal     @default(0) @db.Decimal(20, 2)
  lineTotal             Decimal     @db.Decimal(20, 2)
  currency              String      @db.VarChar(3)
  createdAt             DateTime    @default(now())
  order                 RetailOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sellerOrder           SellerOrder @relation(fields: [sellerOrderId, orderId], references: [id, orderId], onDelete: Restrict)
  product               Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  returnItems           ReturnItem[]

  @@index([orderId])
  @@index([sellerOrderId])
  @@index([productId])

}

model InventoryReservation {
  id             BigInt                     @id @default(autoincrement())
  productId      Int
  buyerUserId    Int
  orderId        Int?
  quantity       Int
  status         InventoryReservationStatus @default(ACTIVE)
  checkoutKey    String                     @unique @db.VarChar(160)
  expiresAt      DateTime
  consumedAt     DateTime?
  releasedAt     DateTime?
  createdAt      DateTime                   @default(now())
  product        Product                    @relation(fields: [productId], references: [id], onDelete: Restrict)
  buyer          User                       @relation(fields: [buyerUserId], references: [id], onDelete: Restrict)
  order          RetailOrder?               @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([productId, status, expiresAt])
  @@index([buyerUserId, createdAt])
  @@index([orderId])

}

model PaymentAttempt {
  id             Int                 @id @default(autoincrement())
  orderId        Int
  provider       String              @db.VarChar(80)
  status         PaymentAttemptStatus @default(CREATED)
  amount         Decimal             @db.Decimal(20, 2)
  currency       String              @db.VarChar(3)
  idempotencyKey String              @unique @db.VarChar(160)
  authority      String?             @unique @db.VarChar(200)
  redirectUrl    String?             @db.VarChar(1000)
  expiresAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  order          RetailOrder         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  transactions   PaymentTransaction[]
  webhookEvents  PaymentWebhookEvent[]

  @@index([orderId, createdAt])
  @@index([provider, status, createdAt])

}

model PaymentTransaction {
  id                  Int                      @id @default(autoincrement())
  orderId             Int
  attemptId           Int?
  provider            String                   @db.VarChar(80)
  providerTransactionId String?                @db.VarChar(200)
  transactionType     PaymentTransactionType
  status              PaymentTransactionStatus @default(PENDING)
  amount              Decimal                  @db.Decimal(20, 2)
  currency            String                   @db.VarChar(3)
  verifiedAt          DateTime?
  createdAt           DateTime                 @default(now())
  order               RetailOrder              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  attempt              PaymentAttempt?          @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  refunds             RetailRefund[]
  reconciliations     ReconciliationRecord[]

  @@unique([provider, providerTransactionId])
  @@index([orderId, createdAt])
  @@index([attemptId])
  @@index([status, createdAt])

}

model PaymentWebhookEvent {
  id             BigInt              @id @default(autoincrement())
  provider       String              @db.VarChar(80)
  providerEventId String             @db.VarChar(240)
  attemptId      Int?
  status         PaymentWebhookStatus @default(RECEIVED)
  signatureValid Boolean             @default(false)
  payload        Json
  receivedAt     DateTime            @default(now())
  processedAt    DateTime?
  lastError      String?
  attempt        PaymentAttempt?      @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([status, receivedAt])
  @@index([attemptId])

}

model RetailRefund {
  id                    Int           @id @default(autoincrement())
  orderId               Int
  sellerOrderId         Int?
  paymentTransactionId  Int?
  requestedByUserId     Int
  amount                Decimal       @db.Decimal(20, 2)
  currency              String        @db.VarChar(3)
  status                RefundStatus  @default(REQUESTED)
  reason                String        @db.VarChar(1000)
  idempotencyKey        String        @unique @db.VarChar(160)
  providerRefundId      String?       @unique @db.VarChar(200)
  processedAt           DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  order                 RetailOrder   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sellerOrder           SellerOrder?  @relation(fields: [sellerOrderId], references: [id], onDelete: SetNull)
  paymentTransaction    PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id], onDelete: Restrict)
  requestedBy           User          @relation(fields: [requestedByUserId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([sellerOrderId, status])
  @@index([status, createdAt])

}

model Shipment {
  id                Int            @id @default(autoincrement())
  sellerOrderId     Int
  carrier           String?        @db.VarChar(120)
  trackingNumber    String?        @db.VarChar(160)
  status            ShipmentStatus @default(LABEL_CREATED)
  shippedAt         DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  sellerOrder       SellerOrder    @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  trackingEvents    TrackingEvent[]

  @@index([sellerOrderId, createdAt])
  @@index([trackingNumber])
  @@index([status, updatedAt])

}

model TrackingEvent {
  id          BigInt        @id @default(autoincrement())
  shipmentId  Int
  eventCode   String?       @db.VarChar(80)
  description String        @db.VarChar(500)
  location    String?       @db.VarChar(240)
  occurredAt  DateTime
  createdAt   DateTime      @default(now())
  shipment    Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])

}

model ReturnRequest {
  id              Int          @id @default(autoincrement())
  orderId         Int
  sellerOrderId   Int
  buyerUserId     Int
  returnNumber    String       @unique @db.VarChar(40)
  status          ReturnStatus @default(REQUESTED)
  reason          String       @db.VarChar(1000)
  requestedAt     DateTime     @default(now())
  receivedAt      DateTime?
  closedAt        DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  order           RetailOrder  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sellerOrder     SellerOrder  @relation(fields: [sellerOrderId, orderId], references: [id, orderId], onDelete: Restrict)
  buyer           User         @relation(fields: [buyerUserId], references: [id], onDelete: Restrict)
  items           ReturnItem[]

  @@index([orderId, status])
  @@index([sellerOrderId, status])
  @@index([buyerUserId, createdAt])

}

model ReturnItem {
  id              Int                   @id @default(autoincrement())
  returnRequestId Int
  orderItemId     Int
  quantity        Int
  disposition     ReturnItemDisposition?
  inspectionNote  String?
  createdAt       DateTime              @default(now())
  returnRequest   ReturnRequest         @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem       RetailOrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([returnRequestId, orderItemId])
  @@index([orderItemId])

}

// ============================================================================
// DB-6 — Marketplace finance, immutable ledger and settlements
// ============================================================================
enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  REVERSED
}

enum CommissionCalculationType {
  PERCENTAGE
  FIXED_PER_ORDER
}

enum SellerPayableStatus {
  PENDING
  ON_HOLD
  ELIGIBLE
  INCLUDED_IN_SETTLEMENT
  PAID
  REVERSED
}

enum SettlementApprovalDecision {
  APPROVE
  REJECT
  RETURN_FOR_REVISION
}

enum SettlementStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  PAYOUT_PENDING
  PAID
  RECONCILED
  ON_HOLD
  REJECTED
  PAYOUT_FAILED
  ADJUSTED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  VOID
}

model LedgerAccount {
  id          Int               @id @default(autoincrement())
  code        String            @unique @db.VarChar(80)
  name        String            @db.VarChar(200)
  accountType LedgerAccountType
  currency    String            @db.VarChar(3)
  isSystem    Boolean           @default(false)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  lines       JournalLine[]

  @@index([accountType, currency, isActive])

}

model JournalEntry {
  id              BigInt            @id @default(autoincrement())
  entryNumber     String            @unique @db.VarChar(48)
  sourceType      String?           @db.VarChar(80)
  sourceId        String?           @db.VarChar(120)
  currency        String            @db.VarChar(3)
  description     String?           @db.VarChar(1000)
  status          JournalEntryStatus @default(DRAFT)
  occurredAt      DateTime          @default(now())
  postedAt        DateTime?
  createdByUserId Int?
  reversalOfId    BigInt?           @unique
  createdAt       DateTime          @default(now())
  lines           JournalLine[]
  createdBy       User?             @relation("JournalEntryCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  reversalOf      JournalEntry?     @relation("JournalReversals", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversals       JournalEntry[]    @relation("JournalReversals")

  @@index([sourceType, sourceId])
  @@index([status, occurredAt])
  @@index([currency, postedAt])

}

model JournalLine {
  id             BigInt       @id @default(autoincrement())
  journalEntryId BigInt
  accountId      Int
  debit          Decimal      @default(0) @db.Decimal(20, 2)
  credit         Decimal      @default(0) @db.Decimal(20, 2)
  memo           String?      @db.VarChar(500)
  createdAt      DateTime     @default(now())
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  account        LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([journalEntryId])
  @@index([accountId, createdAt])

}

model CommissionRule {
  id            Int                       @id @default(autoincrement())
  code          String                    @unique @db.VarChar(80)
  name          String                    @db.VarChar(200)
  calculation   CommissionCalculationType
  rate          Decimal                   @db.Decimal(12, 6)
  currency      String?                   @db.VarChar(3)
  companyId     Int?
  categoryId    Int?
  priority      Int                       @default(0)
  validFrom     DateTime
  validTo       DateTime?
  isActive      Boolean                   @default(true)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  company       Company?                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  category      Category?                 @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  snapshots     CommissionSnapshot[]

  @@index([isActive, validFrom, validTo, priority])
  @@index([companyId, categoryId])

}

model CommissionSnapshot {
  id             Int            @id @default(autoincrement())
  sellerOrderId  Int            @unique
  ruleId         Int?
  calculation    CommissionCalculationType
  rate           Decimal        @db.Decimal(12, 6)
  baseAmount     Decimal        @db.Decimal(20, 2)
  commissionAmount Decimal      @db.Decimal(20, 2)
  currency       String         @db.VarChar(3)
  createdAt      DateTime       @default(now())
  sellerOrder    SellerOrder    @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  rule           CommissionRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

}

model SellerPayable {
  id             BigInt             @id @default(autoincrement())
  sellerOrderId  Int                @unique
  companyId      Int
  settlementId   Int?
  currency       String             @db.VarChar(3)
  grossAmount    Decimal            @db.Decimal(20, 2)
  commissionAmount Decimal          @default(0) @db.Decimal(20, 2)
  deductionAmount Decimal           @default(0) @db.Decimal(20, 2)
  netAmount      Decimal            @db.Decimal(20, 2)
  status         SellerPayableStatus @default(PENDING)
  eligibleAt     DateTime?
  paidAt         DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  sellerOrder    SellerOrder        @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  company        Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  settlement     Settlement?        @relation(fields: [settlementId], references: [id], onDelete: SetNull)

  @@index([companyId, status, eligibleAt])
  @@index([settlementId])

}

model Settlement {
  id               Int             @id @default(autoincrement())
  settlementNumber String          @unique @db.VarChar(48)
  companyId        Int
  currency         String          @db.VarChar(3)
  periodStart      DateTime
  periodEnd        DateTime
  grossAmount      Decimal         @default(0) @db.Decimal(20, 2)
  deductionAmount  Decimal         @default(0) @db.Decimal(20, 2)
  netAmount        Decimal         @default(0) @db.Decimal(20, 2)
  status           SettlementStatus @default(REQUESTED)
  requestedByUserId Int
  requestedAt      DateTime        @default(now())
  approvedAt       DateTime?
  paidAt           DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  company          Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  requestedBy      User            @relation("SettlementRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  payables         SellerPayable[]
  approvals        SettlementApproval[]
  payouts          SettlementPayout[]

  @@index([companyId, status, createdAt])
  @@index([status, requestedAt])
  @@index([periodStart, periodEnd])

}

model SettlementApproval {
  id             Int        @id @default(autoincrement())
  settlementId   Int
  approverUserId Int
  decision       SettlementApprovalDecision
  reason         String?    @db.VarChar(1000)
  decidedAt      DateTime   @default(now())
  settlement     Settlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  approver       User       @relation(fields: [approverUserId], references: [id], onDelete: Restrict)

  @@unique([settlementId, approverUserId])
  @@index([settlementId, decidedAt])
  @@index([approverUserId, decidedAt])

}

model SettlementPayout {
  id                Int         @id @default(autoincrement())
  settlementId      Int
  provider           String?    @db.VarChar(80)
  providerReference  String?    @unique @db.VarChar(200)
  amount             Decimal    @db.Decimal(20, 2)
  currency           String     @db.VarChar(3)
  status             PayoutStatus @default(PENDING)
  idempotencyKey     String     @unique @db.VarChar(160)
  executedByUserId   Int?
  executedAt         DateTime?
  failureReason      String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  settlement         Settlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  executedBy         User?      @relation("PayoutExecutor", fields: [executedByUserId], references: [id], onDelete: SetNull)
  reconciliations    ReconciliationRecord[]

  @@index([settlementId, createdAt])
  @@index([status, createdAt])

}

model ReconciliationRecord {
  id                    BigInt             @id @default(autoincrement())
  provider              String             @db.VarChar(80)
  externalReference     String             @db.VarChar(240)
  amount                Decimal            @db.Decimal(20, 2)
  currency              String             @db.VarChar(3)
  matched                Boolean            @default(false)
  paymentTransactionId  Int?
  payoutId              Int?
  notes                 String?
  reconciledAt          DateTime            @default(now())
  paymentTransaction    PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id], onDelete: SetNull)
  payout                SettlementPayout?  @relation(fields: [payoutId], references: [id], onDelete: Restrict)

  @@unique([provider, externalReference])
  @@index([matched, reconciledAt])
  @@index([paymentTransactionId])
  @@index([payoutId])

}

model FinanceInvoice {
  id                Int           @id @default(autoincrement())
  invoiceNumber     String        @unique @db.VarChar(48)
  companyId         Int?
  buyerUserId       Int?
  orderId           Int?
  sellerOrderId     Int?
  status            InvoiceStatus @default(DRAFT)
  currency          String        @db.VarChar(3)
  subtotal          Decimal       @db.Decimal(20, 2)
  taxTotal          Decimal       @default(0) @db.Decimal(20, 2)
  grandTotal        Decimal       @db.Decimal(20, 2)
  issuedAt          DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  company           Company?      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  buyer             User?         @relation(fields: [buyerUserId], references: [id], onDelete: Restrict)
  order             RetailOrder?  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sellerOrder       SellerOrder?  @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  lines             FinanceInvoiceLine[]

  @@index([companyId, createdAt])
  @@index([buyerUserId, createdAt])
  @@index([orderId])
  @@index([sellerOrderId])

}

model FinanceInvoiceLine {
  id          Int           @id @default(autoincrement())
  invoiceId   Int
  description String        @db.VarChar(500)
  quantity    Decimal       @default(1) @db.Decimal(18, 4)
  unitPrice   Decimal       @db.Decimal(20, 2)
  taxAmount   Decimal       @default(0) @db.Decimal(20, 2)
  lineTotal   Decimal       @db.Decimal(20, 2)
  invoice     FinanceInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])

}
