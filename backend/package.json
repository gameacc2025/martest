{
  "name": "telecom-marketplace-backend",
  "version": "1.0.0",
  "description": "Telecom Marketplace API - Fastify + Prisma",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "node prisma/seed.js",
    "test": "node --experimental-test-isolation=process --test",
    "test:coverage": "node --experimental-test-isolation=process --test --experimental-test-coverage --test-coverage-exclude=\"**/*.test.js\" --test-coverage-exclude=\"prisma/**\"",
    "test:ci": "node --experimental-test-isolation=process --test --experimental-test-coverage --test-coverage-exclude=\"**/*.test.js\" --test-coverage-exclude=\"prisma/**\" --test-coverage-lines=95 --test-coverage-branches=90 --test-coverage-functions=90"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^8.3.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^7.0.4",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^2.1.0",
    "@prisma/client": "^6.7.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.0",
    "fastify-plugin": "^4.5.1",
    "nodemailer": "^10.0.14",
    "pino-pretty": "^11.3.0"
  },
  "devDependencies": {
    "prisma": "^6.7.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}